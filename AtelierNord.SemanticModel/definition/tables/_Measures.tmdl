table _Measures
	lineageTag: 0f891c78-a8da-5419-8ebd-fd70bd78ab43

	measure 'Reference time' =
			
			DATE ( 2026, 10, 14 ) + TIME ( 9, 42, 0 )
		formatString: dd mmm yyyy hh:nn
		displayFolder: 00 Base
		lineageTag: 574decdd-23b7-5282-ae85-6eaed1905884

	measure 'Reference date' =
			
			DATE ( 2026, 10, 14 )
		formatString: dd mmm yyyy
		displayFolder: 00 Base
		lineageTag: 7af1e2d8-5859-5022-8c37-f6ed89cabe79

	measure 'Year start' =
			
			DATE ( YEAR ( [Reference date] ), 1, 1 )
		formatString: dd mmm yyyy
		displayFolder: 00 Base
		lineageTag: 5789fdd9-3cb9-5efb-aab1-d893de019752

	measure 'Closing date' =
			
			EOMONTH ( [Reference date], -1 )
		formatString: dd mmm yyyy
		displayFolder: 00 Base
		lineageTag: 8e528bd6-7e18-540e-bd03-7288cf146f27

	measure 'Date label' =
			
			UPPER ( FORMAT ( [Reference date], "dd mmm yyyy", "en-US" ) )
		displayFolder: 00 Base
		lineageTag: 388ad9b6-d29c-5168-9d3b-19d655375b06

	measure 'Updated label' =
			
			"Updated " & FORMAT ( [Reference time], "hh:nn" )
		displayFolder: 00 Base
		lineageTag: 5d8331f8-3562-5eb3-96cc-eb2f4999b8eb

	measure 'User name' =
			
			"Claire Dubois"
		displayFolder: 00 Base
		lineageTag: 3784fcc3-804a-59dd-9bcb-6e9095c659a6

	measure 'User role' =
			
			"Managing Partner"
		displayFolder: 00 Base
		lineageTag: d38f9472-739b-587c-8c3f-820fe542d5be

	measure 'Active projects' =
			
			CALCULATE ( COUNTROWS ( DimProject ), DimProject[Status] <> "Completed" ) + 0
		formatString: 0
		displayFolder: 10 Portfolio
		lineageTag: a453d963-771e-5a82-a2f8-115bfe843627

	measure 'Projects at risk' =
			
			CALCULATE ( COUNTROWS ( DimProject ), DimProject[Status] = "At risk" ) + 0
		formatString: 0
		displayFolder: 10 Portfolio
		lineageTag: 5f7e26d7-2c08-57e7-94b3-8cfcc845ce2b

	measure 'Attention label' =
			
			VAR _n = CALCULATE ( [Projects at risk], REMOVEFILTERS ( DimProject ) )
			RETURN _n & IF ( _n = 1, " project needs attention", " projects need attention" )
		displayFolder: 10 Portfolio
		lineageTag: d7098efb-e360-5977-960c-d97c16fc5f37

	measure 'Contracted fees' =
			
			CALCULATE ( SUM ( DimProject[ContractFees] ), DimProject[Status] <> "Completed" )
		formatString: #,0
		displayFolder: 10 Portfolio
		lineageTag: b66e4db8-2063-557a-936e-c511eb278cd5

	measure 'Current phase planned hours' =
			
			VAR _ph = SELECTEDVALUE ( DimProject[Phase] )
			RETURN
			    CALCULATE ( SUM ( FactPlan[PlannedHours] ), REMOVEFILTERS ( DimDate ), FactPlan[Phase] = _ph )
		formatString: #,0
		displayFolder: 10 Portfolio
		lineageTag: 2b5318fb-c3b8-5ddb-a3e2-d092d3622b6c

	measure 'Overall completion' =
			
			VAR _t = FILTER ( DimProject, DimProject[Status] <> "Completed" )
			RETURN DIVIDE ( SUMX ( _t, [Current phase planned hours] * DimProject[PhaseProgress] ), SUMX ( _t, [Current phase planned hours] ) )
		formatString: 0.0%
		displayFolder: 10 Portfolio
		lineageTag: 7f7534cf-675e-5687-979e-27d4517aa965

	measure 'Design progress' =
			
			CALCULATE ( AVERAGE ( DimProject[PhaseProgress] ), DimProject[Phase] = "Design" )
		formatString: 0%
		displayFolder: 10 Portfolio
		lineageTag: 8719e7a1-c6e0-5125-b260-575bbb6019ac

	measure 'Design projects' =
			
			CALCULATE ( COUNTROWS ( DimProject ), DimProject[Phase] = "Design" ) + 0
		formatString: 0
		displayFolder: 10 Portfolio
		lineageTag: 847ddea4-8b02-5390-83c2-529131b85429

	measure 'Permit progress' =
			
			CALCULATE ( AVERAGE ( DimProject[PhaseProgress] ), DimProject[Phase] = "Permit" )
		formatString: 0%
		displayFolder: 10 Portfolio
		lineageTag: 45d0ded9-1777-5333-9330-39a9b73cbeba

	measure 'Permit projects' =
			
			CALCULATE ( COUNTROWS ( DimProject ), DimProject[Phase] = "Permit" ) + 0
		formatString: 0
		displayFolder: 10 Portfolio
		lineageTag: d7b8debd-eaaf-50ed-b25e-ac4c009f6ba3

	measure 'Construction progress' =
			
			CALCULATE ( AVERAGE ( DimProject[PhaseProgress] ), DimProject[Phase] = "Construction" )
		formatString: 0%
		displayFolder: 10 Portfolio
		lineageTag: c36595e6-b910-5a25-8572-15f6d52f121c

	measure 'Construction projects' =
			
			CALCULATE ( COUNTROWS ( DimProject ), DimProject[Phase] = "Construction" ) + 0
		formatString: 0
		displayFolder: 10 Portfolio
		lineageTag: 4da6bd53-0709-5e5e-94fb-78f0259374cd

	measure 'Fees billed YTD' =
			
			VAR _d1 = [Year start]
			VAR _d2 = [Closing date]
			RETURN
			    CALCULATE ( SUM ( FactInvoice[Amount] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) )
		formatString: #,0
		displayFolder: 20 Finance
		lineageTag: aff14675-a7f9-58a9-8f03-c7fbf90dc9cf

	measure 'Fees billed PY' =
			
			VAR _d1 = EDATE ( [Year start], -12 )
			VAR _d2 = EDATE ( [Closing date], -12 )
			RETURN
			    CALCULATE ( SUM ( FactInvoice[Amount] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) )
		formatString: #,0
		displayFolder: 20 Finance
		lineageTag: 18b120fa-af1c-574f-9587-e061726d0e4b

	measure 'Fees change' =
			
			DIVIDE ( [Fees billed YTD], [Fees billed PY] ) - 1
		formatString: 0.0%
		displayFolder: 20 Finance
		lineageTag: 993a034c-51af-54c2-89fd-3df6be17501d

	measure 'Fees billed label' =
			
			VAR _v = [Fees billed YTD]
			RETURN IF ( NOT ISBLANK ( _v ), IF ( ABS ( _v ) >= 1000000,
			    "€" & FORMAT ( _v / 1000000, "0.0", "en-US" ) & "M", "€" & FORMAT ( _v / 1000, "0", "en-US" ) & "k" ) )
		displayFolder: 20 Finance
		lineageTag: 4fba66df-9951-5965-a7bd-8477d8b03cfd

	measure 'Fees change label' =
			
			FORMAT ( [Fees change], "+0.0%;-0.0%", "en-US" ) & " vs " & ( YEAR ( [Reference date] ) - 1 )
		displayFolder: 20 Finance
		lineageTag: 507f61ea-cfc6-5bc5-8df6-7ebb100f7aec

	measure 'Operating costs YTD' =
			
			VAR _d1 = [Year start]
			VAR _d2 = [Closing date]
			RETURN
			    CALCULATE ( SUM ( FactCost[Amount] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) )
		formatString: #,0
		displayFolder: 20 Finance
		lineageTag: 64e19c11-d225-571a-bc67-1d88fa49f7e0

	measure 'Operating costs PY' =
			
			VAR _d1 = EDATE ( [Year start], -12 )
			VAR _d2 = EDATE ( [Closing date], -12 )
			RETURN
			    CALCULATE ( SUM ( FactCost[Amount] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) )
		formatString: #,0
		displayFolder: 20 Finance
		lineageTag: d9b69802-2e66-599a-8c1c-82d2f8d4d98f

	measure 'Operating margin' =
			
			DIVIDE ( [Fees billed YTD] - [Operating costs YTD], [Fees billed YTD] )
		formatString: 0.0%
		displayFolder: 20 Finance
		lineageTag: 509351b9-a92a-5e6b-897e-7e2edc46350a

	measure 'Operating margin PY' =
			
			DIVIDE ( [Fees billed PY] - [Operating costs PY], [Fees billed PY] )
		formatString: 0.0%
		displayFolder: 20 Finance
		lineageTag: 7d4ced1e-41a6-5233-9055-287ee6adb838

	measure 'Operating margin change' =
			
			[Operating margin] - [Operating margin PY]
		formatString: 0.0%
		displayFolder: 20 Finance
		lineageTag: b0853ff7-322e-5c70-ab35-09e31dbce396

	measure 'Hours YTD' =
			
			VAR _d1 = [Year start]
			VAR _d2 = [Closing date]
			RETURN
			    CALCULATE ( SUM ( FactTimesheet[Hours] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) )
		formatString: #,0
		displayFolder: 30 Studio
		lineageTag: 3fdfb0a7-be08-5b51-91f6-08907633cf0f

	measure 'Capacity YTD' =
			
