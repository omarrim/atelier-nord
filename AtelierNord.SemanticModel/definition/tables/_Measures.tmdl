			    "<svg xmlns='http://www.w3.org/2000/svg' width='1440' height='1080' viewBox='0 0 1448 1086' preserveAspectRatio='none'><defs><filter id='s' x='-8%' y='-8%' width='116%' height='124%'><feDropShadow dx='0' dy='8' stdDeviation='14' flood-color='#000000' flood-opacity='" & _c_shadowop & "'/></filter></defs><rect width='1448' height='1086' fill='#0B0B0C' fill-opacity='" & _c_voile & "'/><rect x='27.5' y='45' width='202.5' height='990.5' rx='28' fill='" & _c_glass & "' fill-opacity='" & _c_glassop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><rect x='254' y='45' width='1166' height='991' rx='28' fill='" & _c_glass & "' fill-opacity='" & _c_glassop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><rect x='278' y='189' width='1118' height='123.7' rx='22' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><rect x='278' y='332.8' width='486' height='405.7' rx='22' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><rect x='783.6' y='332.8' width='261.3' height='405.7' rx='22' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><rect x='1057.7' y='758.6' width='338.3' height='253.4' rx='22' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><text x='128.75' y='126' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='35' letter-spacing='-0.7' fill='" & _c_ink & "'><tspan font-weight='300'>Atelier </tspan><tspan font-weight='600'>Nord</tspan></text><rect x='39' y='185' width='177.5' height='57' rx='28.5' fill='" & _c_pill & "' filter='url(#s)'/><g transform='translate(59 200.5) scale(1.08333)' fill='none' stroke='" & _c_pilltext & "' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8' /><path d='M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z' /></g><text x='109' y='220' font-family='Segoe UI, Arial, sans-serif' font-size='17.5' font-weight='400' fill='" & _c_pilltext & "' text-anchor='start'>Overview</text><g transform='translate(59 270.5) scale(1.08333)' fill='none' stroke='" & _c_ink & "' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z' /></g><text x='113' y='290' font-family='Segoe UI, Arial, sans-serif' font-size='17.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Projects</text><g transform='translate(59 340.5) scale(1.08333)' fill='none' stroke='" & _c_ink & "' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M8 2v4' /><path d='M16 2v4' /><rect width='18' height='18' x='3' y='4' rx='2' /><path d='M3 10h18' /><path d='M8 14h.01' /><path d='M12 14h.01' /><path d='M16 14h.01' /><path d='M8 18h.01' /><path d='M12 18h.01' /><path d='M16 18h.01' /></g><text x='113' y='360' font-family='Segoe UI, Arial, sans-serif' font-size='17.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Planning</text><g transform='translate(59 408.5) scale(1.08333)' fill='none' stroke='" & _c_ink & "' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><rect x='4' y='11' width='4' height='9' rx='1' /><rect x='10' y='5' width='4' height='15' rx='1' /><rect x='16' y='8' width='4' height='12' rx='1' /></g><text x='113' y='428' font-family='Segoe UI, Arial, sans-serif' font-size='17.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Finance</text><g transform='translate(59 477) scale(1.08333)' fill='none