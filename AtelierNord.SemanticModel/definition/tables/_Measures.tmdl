			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1440' height='1080' viewBox='0 0 1448 1086' preserveAspectRatio='none'><defs><filter id='s' x='-8%' y='-8%' width='116%' height='124%'><feDropShadow dx='0' dy='8' stdDeviation='14' flood-color='#000000' flood-opacity='" & _c_shadowop & "'/></filter></defs><rect width='1448' height='1086' fill='#0B0B0C' fill-opacity='" & _c_voile & "'/><rect x='27.5' y='45' width='202.5' height='990.5' rx='28' fill='" & _c_glass & "' fill-opacity='" & _c_glassop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><rect x='254' y='45' width='1166' height='991' rx='28' fill='" & _c_glass & "' fill-opacity='" & _c_glassop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><rect x='278' y='192.5' width='1118' height='109' rx='22' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><rect x='278' y='322.4' width='719.4' height='384' rx='22' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><rect x='278' y='727.7' width='544.1' height='284.3' rx='22' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><rect x='841.7' y='727.7' width='554.3' height='284.3' rx='22' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' stroke-width='1.2' filter='url(#s)'/><text x='128.75' y='126' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='35' letter-spacing='-0.7' fill='" & _c_ink & "'><tspan font-weight='300'>Atelier </tspan><tspan font-weight='600'>Nord</tspan></text><g transform='translate(59 200.5) scale(1.08333)' fill='none' stroke='" & _c_ink & "' stroke-width='1.6' stroke