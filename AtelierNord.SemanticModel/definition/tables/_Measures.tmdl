			RETURN
			    CALCULATE ( SUM ( FactCapacity[Hours] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) )
		formatString: #,0
		displayFolder: 30 Studio
		lineageTag: 403be6b1-7241-54ef-b037-96850f4afd32

	measure 'Studio utilisation' =
			
			DIVIDE ( [Hours YTD], [Capacity YTD] )
		formatString: 0.0%
		displayFolder: 30 Studio
		lineageTag: 1e1c63ab-bafb-5d36-bb06-844b071c8dea

	measure 'Utilisation hours label' =
			
			FORMAT ( [Hours YTD], "#,0", "en-US" ) & " / " & FORMAT ( [Capacity YTD], "#,0", "en-US" ) & " h"
		displayFolder: 30 Studio
		lineageTag: 81d988b6-6c1b-54a0-9863-d12acde9b231

	measure 'Open tasks' =
			
			CALCULATE ( COUNTROWS ( FactTask ), ISBLANK ( FactTask[Done] ) ) + 0
		formatString: 0
		displayFolder: 30 Studio
		lineageTag: 7050467b-3884-5e21-92e7-4b2dd5dbfd4b

	measure 'Team people' =
			
			CALCULATE ( COUNTROWS ( DimPerson ), DimPerson[IsStaff] = TRUE (), KEEPFILTERS ( DimPerson[Team] <> "Partners" ) ) + 0
		formatString: 0
		displayFolder: 30 Studio
		lineageTag: 04823312-84fb-5a26-9424-090525237eec

	measure 'Shown project key' =
			
			IF ( HASONEVALUE ( DimProject[ProjectKey] ), VALUES ( DimProject[ProjectKey] ),
			    VAR _t = TOPN ( 1, CALCULATETABLE ( DimProject, DimProject[Status] <> "Completed" ), DimProject[RegisterOrder], ASC )
			    RETURN COALESCE ( MAXX ( _t, DimProject[ProjectKey] ), 1 ) )
		formatString: 0
		displayFolder: 40 Shown project
		lineageTag: 94a98457-6756-5fa0-a0d9-e9963ca87087

	measure 'Shown project' =
			
			VAR _k = [Shown project key]
