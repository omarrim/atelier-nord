	measure 'Profitability card (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_ink2 = [Color ink2]
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _per = [Finance period]
			VAR _fin = [Fin end]
			VAR _s1 = [Fin start]
			VAR _m1 = IF ( _per = "Year", DATE ( YEAR ( _fin ), 1, 1 ), EDATE ( DATE ( YEAR ( _fin ), MONTH ( _fin ), 1 ), -5 ) )
			VAR _n = DATEDIFF ( _m1, _fin, MONTH ) + 1
			VAR _v = ADDCOLUMNS ( GENERATESERIES ( 0, _n - 1 ), "@d", EDATE ( _m1, [Value] ),
			    "@r", VAR _a = EDATE ( _m1, [Value] ) RETURN CALCULATE ( SUM ( FactInvoice[Amount] ), DATESBETWEEN ( DimDate[Date], _a, EOMONTH ( _a, 0 ) ) ) + 0,
			    "@c", VAR _a = EDATE ( _m1, [Value] ) RETURN CALCULATE ( SUM ( FactCost[Amount] ), DATESBETWEEN ( DimDate[Date], _a, EOMONTH ( _a, 0 ) ) ) + 0 )
			VAR _mg = ADDCOLUMNS ( _v, "@m", DIVIDE ( [@r] - [@c], [@r] ) )
			VAR _mn = MINX ( _mg, [@m] ) VAR _mx = MAXX ( _mg, [@m] )
			VAR _xy = ADDCOLUMNS ( _mg, "@x", 332.5 + [Value] * 196.5 / MAX ( _n - 1, 1 ), "@y", 270 - DIVIDE ( [@m] - _mn, _mx - _mn ) * 24 )
			VAR _l = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y], "0.0", "en-US" ), " ", [Value], ASC )
			VAR _p = CONCATENATEX ( _xy, "<circle cx='" & FORMAT ( [@x], "0.0", "en-US" ) & "' cy='" & FORMAT ( [@y], "0.0", "en-US" ) & "' r='3.2' fill='" & _c_ink & "'/>", "", [Value], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='541.1' height='282.7' viewBox='0 0 569 296' preserveAspectRatio='none'><text x='22.5' y='36' font-family='Segoe UI, Arial, sans-serif' font-size='24' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Project profitability</text><text x='24' y='62.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Project</text><text x='230' y='62.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Contract fees</text><text x='343' y='62.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Margin</text><rect x='22.5' y='233.5' width='524' height='50' rx='12' fill='" & _c_tile & "'/><text x='40' y='264' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='400' fill='" & _c_ink2 & "' text-anchor='start'>Portfolio margin</text><text x='231' y='266' font-family='Segoe UI, Arial, sans-serif' font-size='27' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.6'>"
			        & FORMAT ( [Fin margin], "0.0%", "en-US" )
			        & "</text><polyline points='"
			        & _l
			        & "' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'><animate attributeName='stroke-dashoffset' from='1' to='0' begin='0.3s' dur='1s' fill='freeze'/></polyline>"
			        & _p
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 6a3c9f24-c502-5093-807a-9d6f64c2719d
		dataCategory: ImageUrl

	measure 'Profitability row (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_track = [Color track]
			VAR _o = [Profitability order]
			VAR _k = SELECTEDVALUE ( DimProject[ProjectKey] )
			VAR _th = LOOKUPVALUE ( 'Thumb image'[Chunk], 'Thumb image'[ProjectKey], _k )
			VAR _f = SELECTEDVALUE ( DimProject[ContractFees] )
			VAR _m = [Fin margin]
			VAR _d = 0.08 + 0.05 * ( _o - 1 )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='501' height='35' viewBox='0 0 501 35' preserveAspectRatio='none'><rect x='10.2' y='34' width='490.8' height='1' fill='" & _c_line & "'/><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='"
			        & FORMAT ( _d, "0.00", "en-US" )
			        & "s' dur='0.45s' fill='freeze'/><clipPath id='v'><rect x='10.2' y='4' width='46.3' height='27' rx='5'/></clipPath><image x='10.2' y='4' width='46.3' height='27' clip-path='url(#v)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64,"
			        & _th
			        & "'/><text x='71.8' y='22.5' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & SELECTEDVALUE ( DimProject[Project] )
			        & "</text><text x='200' y='22.5' font-family='Segoe UI, Arial, sans-serif' font-size='14.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & "€" & FORMAT ( _f / 1000, "0", "en-US" ) & "k"
			        & "</text><text x='304.7' y='22.5' font-family='Segoe UI, Arial, sans-serif' font-size='14.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & FORMAT ( _m, "0%", "en-US" )
			        & "</text><rect x='356.5' y='13' width='135.2' height='9' rx='4.5' fill='" & _c_track & "'/><rect x='356.5' y='13' width='0' height='9' rx='4.5' fill='" & _c_ink & "'><animate attributeName='width' from='0' to='"
			        & FORMAT ( 135.2 * MIN ( MAX ( _m, 0 ) / 0.45, 1 ), "0.0", "en-US" )
			        & "' begin='"
			        & FORMAT ( _d + 0.15, "0.00", "en-US" )
			        & "s' dur='0.9s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect></g></svg>"
			RETURN IF ( NOT ISBLANK ( _o ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" ) )
		displayFolder: 90 SVG
		lineageTag: ccb197bd-50d1-5c09-a769-1f76b3c6e405
		dataCategory: ImageUrl

	measure 'Invoices card (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='551.2' height='282.7' viewBox='0 0 581 296' preserveAspectRatio='none'><text x='17.5' y='36' font-family='Segoe UI, Arial, sans-serif' font-size='24' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Invoices to follow</text><text x='563.5' y='34' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='end'>"
			        & [Outstanding count] & " invoices"
			        & "</text><text x='19' y='62.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Invoice</text><text x='144.5' y='62.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Project</text><text x='277' y='62.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Amount</text><text x='358' y='62.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Due date</text><text x='452' y='62.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Status</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 12b4b118-4914-5f8a-9255-4432a22ca1b4
		dataCategory: ImageUrl

	measure 'Invoice row (SVG)' =
			
			VAR _c_pilltext = [Color pilltext]
			VAR _c_faint = [Color faint]
			VAR _c_chip = [Color chip]
			VAR _c_pill = [Color pill]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _o = [Invoice order]
			VAR _r = [Reference date]
			VAR _due = MAX ( FactInvoice[DueDate] )
			VAR _st = IF ( _due < _r, "Overdue", IF ( _due <= _r + 7, "Due soon", "Upcoming" ) )
			VAR _plein = _st = "Overdue"
			VAR _d = 0.1 + 0.06 * ( _o - 1 )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='513' height='37' viewBox='0 0 513 37' preserveAspectRatio='none'><rect x='6.5' y='36' width='506.5' height='1' fill='" & _c_line & "'/><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='"
			        & FORMAT ( _d, "0.00", "en-US" )
			        & "s' dur='0.45s' fill='freeze'/><g transform='translate(6.5 7.5) scale(0.916667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z' /><path d='M14 2v4a2 2 0 0 0 2 2h4' /><path d='M10 9H8' /><path d='M16 13H8' /><path d='M16 17H8' /></g><text x='40.2' y='23.5' font-family='Segoe UI, Arial, sans-serif' font-size='14.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & SELECTEDVALUE ( FactInvoice[Invoice] )
			        & "</text><text x='122.5' y='23.5' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & SELECTEDVALUE ( DimProject[Project] )
			        & "</text><text x='244.9' y='23.5' font-family='Segoe UI, Arial, sans-serif' font-size='14.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & "€" & FORMAT ( MAX ( FactInvoice[Amount] ) / 1000, "0", "en-US" ) & "k"
			        & "</text><text x='319.8' y='23.5' font-family='Segoe UI, Arial, sans-serif' font-size='14.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & UPPER ( FORMAT ( _due, "dd mmm", "en-US" ) )
			        & "</text><rect x='406.7' y='5.5' width='99.4' height='26' rx='13' fill='"
			        & IF ( _plein, _c_pill, _c_chip )
			        & "' fill-opacity='"
			        & IF ( _plein, "1", "0.6" )
			        & "' stroke='"
			        & IF ( _plein, _c_pill, IF ( _st = "Due soon", _c_ink, _c_faint ) )
			        & "' stroke-width='1.2'/><text x='456.4' y='23.5' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' fill='"
			        & IF ( _plein, _c_pilltext, _c_ink )
			        & "'>"
			        & _st
			        & "</text></g></svg>"
			RETURN IF ( NOT ISBLANK ( _o ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" ) )
		displayFolder: 90 SVG
		lineageTag: a3b89f5c-cf85-54cc-a60a-8dd8449e246f
		dataCategory: ImageUrl

	measure 'France map (SVG)' =
			
			VAR _c_track = [Color track]
			VAR _c_card = [Color card]
			VAR _c_chip = [Color chip]
			VAR _c_design = [Color design]
			VAR _c_ink = [Color ink]
			VAR _c_ink2 = [Color ink2]
			VAR _c_muted = [Color muted]
			VAR _k = [Shown project key]
			VAR _reg = SWITCH ( _k, 1, "84", 2, "84", 3, "52", 4, "75", 5, "32", 6, "75", 7, "84", 8, "75", 9, "84", 10, "84", 11, "84", 12, "84", "" )
			VAR _t = CALCULATETABLE ( DimProject, REMOVEFILTERS ( DimProject ), DimProject[Status] <> "Completed" )
			VAR _xy = ADDCOLUMNS ( _t, "@x", 68.755 + ( DimProject[Longitude] - ( -5.2 ) ) * 26.3506,
			    "@y", 84.000 + ( 51.15 - DimProject[Latitude] ) * 38.0711,
			    "@r", RANKX ( _t, DimProject[Latitude], , DESC, Dense ) )
			VAR _pins = CONCATENATEX ( FILTER ( _xy, DimProject[ProjectKey] <> _k ),
			    "<g opacity='0' transform='translate(0 -16)'><animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( 0.25 + [@r] * 0.06, "0.00", "en-US" ) & "s' dur='0.3s' fill='freeze'/>"
			    & "<animateTransform attributeName='transform' type='translate' from='0 -16' to='0 0' begin='" & FORMAT ( 0.25 + [@r] * 0.06, "0.00", "en-US" ) & "s' dur='0.45s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.3 1.4 0.6 1'/>"
			    & "<circle cx='" & FORMAT ( [@x], "0.0", "en-US" ) & "' cy='" & FORMAT ( [@y], "0.0", "en-US" ) & "' r='7' fill='" & _c_card & "'/>"
			    & "<circle cx='" & FORMAT ( [@x], "0.0", "en-US" ) & "' cy='" & FORMAT ( [@y], "0.0", "en-US" ) & "' r='4.8' fill='" & _c_design & "'/></g>", "", [@r], ASC )
			VAR _cx = MAXX ( FILTER ( _xy, DimProject[ProjectKey] = _k ), [@x] )
			VAR _cy = MAXX ( FILTER ( _xy, DimProject[ProjectKey] = _k ), [@y] )
			VAR _ville = MAXX ( FILTER ( _xy, DimProject[ProjectKey] = _k ), DimProject[City] )
			VAR _gauche = _cx > 348
