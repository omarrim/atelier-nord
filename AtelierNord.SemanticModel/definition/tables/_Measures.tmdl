	measure 'Project facts grid (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='500.1' height='295.6' viewBox='0 0 527.5 303.5' preserveAspectRatio='none'><text x='22' y='40' font-family='Segoe UI, Arial, sans-serif' font-size='24' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Project details</text><rect x='263.75' y='66' width='1' height='215.5' fill='" & _c_line & "'/><text x='22' y='80' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Phase</text><text x='22' y='101' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown phase] & " · " & FORMAT ( [Shown progress], "0%", "en-US" )
			        & "</text><rect x='22' y='114' width='219.75' height='1' fill='" & _c_line & "'/><text x='285.75' y='80' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Status</text><text x='285.75' y='101' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown status]
			        & "</text><rect x='285.75' y='114' width='219.75' height='1' fill='" & _c_line & "'/><text x='22' y='136' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Client</text><text x='22' y='157' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & SUBSTITUTE ( [Shown client], "&", "&amp;" )
			        & "</text><rect x='22' y='170' width='219.75' height='1' fill='" & _c_line & "'/><text x='285.75' y='136' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Project lead</text><text x='285.75' y='157' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown lead]
			        & "</text><rect x='285.75' y='170' width='219.75' height='1' fill='" & _c_line & "'/><text x='22' y='192' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Construction budget</text><text x='22' y='213' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown budget label]
			        & "</text><rect x='22' y='226' width='219.75' height='1' fill='" & _c_line & "'/><text x='285.75' y='192' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Contract fees</text><text x='285.75' y='213' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown fees label]
			        & "</text><rect x='285.75' y='226' width='219.75' height='1' fill='" & _c_line & "'/><text x='22' y='248' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Next milestone</text><text x='22' y='269' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown next milestone label]
			        & "</text><text x='285.75' y='248' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Handover</text><text x='285.75' y='269' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & FORMAT ( [Shown handover], "dd mmm yyyy", "en-US" )
			        & "</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 10d91368-8ab9-5acd-8ad9-31e73e96e88a
		dataCategory: ImageUrl

	measure 'Pipeline planning (SVG)' =
			
			VAR _c_permit = [Color permit]
			VAR _c_ink2 = [Color ink2]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_pill = [Color pill]
			VAR _c_pilltext = [Color pilltext]
			VAR _c_tile = [Color tile]
			VAR _k = IF ( HASONEVALUE ( DimProject[ProjectKey] ), VALUES ( DimProject[ProjectKey] ) )
			VAR _t = ADDCOLUMNS ( CALCULATETABLE ( DimProject, REMOVEFILTERS ( DimProject ), DimProject[Status] <> "Completed" ),
			    "@pos", ( SWITCH ( DimProject[Phase], "Design", 0, "Permit", 1, "Construction", 2, 3 ) + DimProject[PhaseProgress] ) / 4 )
			VAR _rows = CONCATENATEX ( _t, VAR _i = RANKX ( _t, [@pos] + DimProject[ProjectKey] / 10000, , DESC ) - 1
			    VAR _y = 112 + _i * 24.5 VAR _moi = DimProject[ProjectKey] = _k VAR _w = [@pos] * 578.0
			    VAR _d = 0.15 + _i * 0.05
			    RETURN IF ( _moi, "<rect x='14' y='" & ( _y - 11.5 ) & "' width='770.0' height='23' rx='8' fill='" & _c_tile & "'/>" )
			        & "<text x='24' y='" & ( _y + 4.5 ) & "' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='" & IF ( _moi, "600", "400" ) & "' fill='" & IF ( _moi, _c_ink, _c_ink2 ) & "'>" & DimProject[Project] & "</text>"
			        & "<rect x='196' y='" & ( _y - 4.5 ) & "' width='0' height='9' rx='4.5' fill='" & IF ( _moi || ISBLANK ( _k ), _c_ink, _c_permit ) & "'>"
			        & "<animate attributeName='width' from='0' to='" & FORMAT ( _w, "0.0", "en-US" ) & "' begin='" & FORMAT ( _d, "0.00", "en-US" ) & "s' dur='0.9s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect>"
			        & "<text x='" & FORMAT ( 196 + _w + 7, "0.0", "en-US" ) & "' y='" & ( _y + 4 ) & "' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='" & IF ( _moi, "600", "400" ) & "' fill='" & IF ( _moi, _c_ink, _c_muted ) & "' opacity='0'>"
			        & "<animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( _d + 0.7, "0.00", "en-US" ) & "s' dur='0.3s' fill='freeze'/>" & FORMAT ( DimProject[PhaseProgress], "0%", "en-US" ) & "</text>",
			    "", [@pos], DESC )
			VAR _n0 = COUNTROWS ( FILTER ( _t, DimProject[Phase] = "Design" ) )
			VAR _n1 = COUNTROWS ( FILTER ( _t, DimProject[Phase] = "Permit" ) )
			VAR _n2 = COUNTROWS ( FILTER ( _t, DimProject[Phase] = "Construction" ) )
			VAR _n3 = COUNTROWS ( FILTER ( _t, DimProject[Phase] = "Delivery" ) )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='762.7' height='415.9' viewBox='0 0 798 426.5' preserveAspectRatio='none'><text x='23' y='36.5' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Portfolio pipeline</text><text x='23' y='60' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Where each project stands, from design to delivery</text><rect x='560.0' y='16' width='216' height='34' rx='17' fill='" & _c_tile & "' stroke='" & _c_line & "'/><rect x='668.0' y='18' width='106' height='30' rx='15' fill='" & _c_pill & "'/><text x='615' y='38' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='400' fill='" & _c_ink & "' text-anchor='middle'>Timeline</text><text x='721' y='38' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='600' fill='" & _c_pilltext & "' text-anchor='middle'>Pipeline</text><rect x='196' y='74' width='144.5' height='323.5' rx='6' fill='" & _c_tile & "' fill-opacity='0.55'/><line x1='196' y1='74' x2='196' y2='397.5' stroke='" & _c_line & "' stroke-width='1' stroke-dasharray='3 3'/><text x='205' y='92' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "'>Design<tspan dx='6' font-weight='400' fill='" & _c_muted & "'>"
			        & _n0
			        & "</tspan></text><line x1='340.5' y1='74' x2='340.5' y2='397.5' stroke='" & _c_line & "' stroke-width='1' stroke-dasharray='3 3'/><text x='349.5' y='92' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "'>Permit<tspan dx='6' font-weight='400' fill='" & _c_muted & "'>"
			        & _n1
			        & "</tspan></text><rect x='485' y='74' width='144.5' height='323.5' rx='6' fill='" & _c_tile & "' fill-opacity='0.55'/><line x1='485' y1='74' x2='485' y2='397.5' stroke='" & _c_line & "' stroke-width='1' stroke-dasharray='3 3'/><text x='494' y='92' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "'>Construction<tspan dx='6' font-weight='400' fill='" & _c_muted & "'>"
			        & _n2
			        & "</tspan></text><line x1='629.5' y1='74' x2='629.5' y2='397.5' stroke='" & _c_line & "' stroke-width='1' stroke-dasharray='3 3'/><text x='638.5' y='92' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "'>Delivery<tspan dx='6' font-weight='400' fill='" & _c_muted & "'>"
			        & _n3
			        & "</tspan></text>"
			        & _rows
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 4b01f2ac-3580-574f-b12d-016556c67a33
		dataCategory: ImageUrl

	measure 'Notifications count' =
			
			VAR _r = [Reference date]
			VAR _h = [Reference time] - [Reference date]
			VAR _meet = SELECTCOLUMNS ( CALCULATETABLE ( FactMeeting, REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactMeeting[Date] = _r ),
			    "@k", "meet", "@t", FactMeeting[Meeting] & " at " & FactMeeting[Time],
			    "@s", LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactMeeting[ProjectKey] ) & " · with "
			        & LOOKUPVALUE ( DimPerson[FirstName], DimPerson[PersonKey], FactMeeting[Person1] ) & " and " & LOOKUPVALUE ( DimPerson[FirstName], DimPerson[PersonKey], FactMeeting[Person2] ),
			    "@w", VAR _d = ( TIMEVALUE ( FactMeeting[Time] ) - _h ) * 24 RETURN IF ( _d > 0, "in " & ROUND ( _d, 0 ) & " h", "now" ),
			    "@o", 1, "@q", VALUE ( SUBSTITUTE ( FactMeeting[Time], ":", "" ) ), "@a1", FactMeeting[Person1], "@a2", FactMeeting[Person2], "@u", 1 )
			VAR _np = CALCULATETABLE ( FactInvoice, REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactInvoice[IssueDate] <= _r,
			    ISBLANK ( FactInvoice[PaidDate] ) || FactInvoice[PaidDate] > _r )
			VAR _inv = SELECTCOLUMNS ( FILTER ( _np, FactInvoice[DueDate] < _r ),
			    "@k", "inv", "@t", FactInvoice[Invoice] & " is " & INT ( _r - FactInvoice[DueDate] ) & " days overdue",
			    "@s", LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactInvoice[ProjectKey] ) & " · €" & FORMAT ( FactInvoice[Amount] / 1000, "0", "en-US" ) & "k",
			    "@w", "since " & FORMAT ( FactInvoice[DueDate], "d mmm", "en-US" ),
			    "@o", 2, "@q", - INT ( _r - FactInvoice[DueDate] ), "@a1", 0, "@a2", 0, "@u", 1 )
			VAR _al = SELECTCOLUMNS ( CALCULATETABLE ( FactAlert, REMOVEFILTERS ( DimProject ) ),
			    "@k", "alert", "@t", FactAlert[Alert], "@s", LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactAlert[ProjectKey] ),
			    "@w", INT ( _r - FactAlert[Raised] ) & " days ago",
			    "@o", 3, "@q", INT ( _r - FactAlert[Raised] ), "@a1", 0, "@a2", 0, "@u", 1 )
			VAR _jt = TOPN ( 1, CALCULATETABLE ( FactMilestone, REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactMilestone[Kind] = "Major", FactMilestone[Date] > _r ),
			    FactMilestone[Date], ASC, FactMilestone[MilestoneKey], ASC )
			VAR _jal = SELECTCOLUMNS ( _jt, "@k", "mile", "@t", FactMilestone[Milestone] & " in " & INT ( FactMilestone[Date] - _r ) & " days",
			    "@s", LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactMilestone[ProjectKey] ),
			    "@w", FORMAT ( FactMilestone[Date], "d mmm", "en-US" ), "@o", 4, "@q", 0, "@a1", 0, "@a2", 0, "@u", 0 )
			VAR _pt = TOPN ( 1, FILTER ( _np, FactInvoice[DueDate] >= _r ), FactInvoice[DueDate], ASC, FactInvoice[Invoice], ASC )
			VAR _pay = SELECTCOLUMNS ( _pt, "@k", "pay", "@t", "€" & FORMAT ( FactInvoice[Amount] / 1000, "0", "en-US" ) & "k expected on " & FORMAT ( FactInvoice[DueDate], "d mmm", "en-US" ),
			    "@s", LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactInvoice[ProjectKey] ) & " · " & FactInvoice[Invoice],
			    "@w", "in " & INT ( FactInvoice[DueDate] - _r ) & " days", "@o", 5, "@q", 0, "@a1", 0, "@a2", 0, "@u", 0 )
			VAR _all = UNION ( _meet, _inv, _al, _jal, _pay )
			RETURN SUMX ( _all, [@u] )
		formatString: 0
		displayFolder: 85 Notifications
		lineageTag: ef9e23a8-c8a8-5b02-9382-07d0ee0ea7a3

	measure 'Notifications (SVG)' =
			
			VAR _c_card = [Color card]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_pill = [Color pill]
			VAR _c_pilltext = [Color pilltext]
			VAR _c_shadowop = [Color shadowop]
			VAR _c_tile = [Color tile]
			VAR _r = [Reference date]
			VAR _h = [Reference time] - [Reference date]
			VAR _meet = SELECTCOLUMNS ( CALCULATETABLE ( FactMeeting, REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactMeeting[Date] = _r ),
			    "@k", "meet", "@t", FactMeeting[Meeting] & " at " & FactMeeting[Time],
			    "@s", LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactMeeting[ProjectKey] ) & " · with "
			        & LOOKUPVALUE ( DimPerson[FirstName], DimPerson[PersonKey], FactMeeting[Person1] ) & " and " & LOOKUPVALUE ( DimPerson[FirstName], DimPerson[PersonKey], FactMeeting[Person2] ),
			    "@w", VAR _d = ( TIMEVALUE ( FactMeeting[Time] ) - _h ) * 24 RETURN IF ( _d > 0, "in " & ROUND ( _d, 0 ) & " h", "now" ),
			    "@o", 1, "@q", VALUE ( SUBSTITUTE ( FactMeeting[Time], ":", "" ) ), "@a1", FactMeeting[Person1], "@a2", FactMeeting[Person2], "@u", 1 )
			VAR _np = CALCULATETABLE ( FactInvoice, REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactInvoice[IssueDate] <= _r,
			    ISBLANK ( FactInvoice[PaidDate] ) || FactInvoice[PaidDate] > _r )
			VAR _inv = SELECTCOLUMNS ( FILTER ( _np, FactInvoice[DueDate] < _r ),
			    "@k", "inv", "@t", FactInvoice[Invoice] & " is " & INT ( _r - FactInvoice[DueDate] ) & " days overdue",
			    "@s", LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactInvoice[ProjectKey] ) & " · €" & FORMAT ( FactInvoice[Amount] / 1000, "0", "en-US" ) & "k",
			    "@w", "since " & FORMAT ( FactInvoice[DueDate], "d mmm", "en-US" ),
			    "@o", 2, "@q", - INT ( _r - FactInvoice[DueDate] ), "@a1", 0, "@a2", 0, "@u", 1 )
			VAR _al = SELECTCOLUMNS ( CALCULATETABLE ( FactAlert, REMOVEFILTERS ( DimProject ) ),
			    "@k", "alert", "@t", FactAlert[Alert], "@s", LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactAlert[ProjectKey] ),
			    "@w", INT ( _r - FactAlert[Raised] ) & " days ago",
			    "@o", 3, "@q", INT ( _r - FactAlert[Raised] ), "@a1", 0, "@a2", 0, "@u", 1 )
			VAR _jt = TOPN ( 1, CALCULATETABLE ( FactMilestone, REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactMilestone[Kind] = "Major", FactMilestone[Date] > _r ),
			    FactMilestone[Date], ASC, FactMilestone[MilestoneKey], ASC )
			VAR _jal = SELECTCOLUMNS ( _jt, "@k", "mile", "@t", FactMilestone[Milestone] & " in " & INT ( FactMilestone[Date] - _r ) & " days",
			    "@s", LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactMilestone[ProjectKey] ),
			    "@w", FORMAT ( FactMilestone[Date], "d mmm", "en-US" ), "@o", 4, "@q", 0, "@a1", 0, "@a2", 0, "@u", 0 )
			VAR _pt = TOPN ( 1, FILTER ( _np, FactInvoice[DueDate] >= _r ), FactInvoice[DueDate], ASC, FactInvoice[Invoice], ASC )
			VAR _pay = SELECTCOLUMNS ( _pt, "@k", "pay", "@t", "€" & FORMAT ( FactInvoice[Amount] / 1000, "0", "en-US" ) & "k expected on " & FORMAT ( FactInvoice[DueDate], "d mmm", "en-US" ),
			    "@s", LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactInvoice[ProjectKey] ) & " · " & FactInvoice[Invoice],
			    "@w", "in " & INT ( FactInvoice[DueDate] - _r ) & " days", "@o", 5, "@q", 0, "@a1", 0, "@a2", 0, "@u", 0 )
			VAR _all = UNION ( _meet, _inv, _al, _jal, _pay )
			VAR _n = SUMX ( _all, [@u] )
			VAR _items = CONCATENATEX ( _all,
			    VAR _i = RANKX ( _all, [@o] * 10000 + [@q], , ASC, Dense ) - 1
			    VAR _y = 82 + _i * 66 VAR _d = 0.08 + _i * 0.07
			    VAR _b1 = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], [@a1] )
			    VAR _b2 = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], [@a2] )
			    VAR _ico = SWITCH ( [@k],
			        "meet", "<clipPath id='m" & _i & "a'><circle cx='33' cy='33' r='15'/></clipPath><circle cx='33' cy='33' r='16.6' fill='" & _c_card & "'/>"
			            & "<image x='18' y='18' width='30' height='30' clip-path='url(#m" & _i & "a)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64," & _b1 & "'/>"
			            & "<clipPath id='m" & _i & "b'><circle cx='50' cy='37' r='13'/></clipPath><circle cx='50' cy='37' r='14.6' fill='" & _c_card & "'/>"
			            & "<image x='37' y='24' width='26' height='26' clip-path='url(#m" & _i & "b)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64," & _b2 & "'/>",
			        "inv", "<circle cx='40' cy='33' r='18' fill='" & _c_pill & "'/><g transform='translate(30 23) scale(0.833333)' fill='none' stroke='" & _c_pilltext & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z' /><path d='M14 2v4a2 2 0 0 0 2 2h4' /><path d='M10 9H8' /><path d='M16 13H8' /><path d='M16 17H8' /></g>",
			        "alert", "<circle cx='40' cy='33' r='18' fill='" & _c_pill & "'/><g transform='translate(30 23) scale(0.833333)' fill='none' stroke='" & _c_pilltext & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z' /><line x1='4' x2='4' y1='22' y2='15' /></g>",
			        "mile", "<circle cx='40' cy='33' r='18' fill='" & _c_tile & "'/><rect x='34' y='27' width='12' height='12' transform='rotate(45 40 33)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8'/>",
			        "pay", "<circle cx='40' cy='33' r='18' fill='" & _c_tile & "'/><text x='40' y='39' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='600' fill='" & _c_ink & "'>€</text>" )
			    RETURN "<g transform='translate(0 " & _y & ")'><g opacity='0' transform='translate(26 0)'>"
			        & "<animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( _d, "0.00", "en-US" ) & "s' dur='0.35s' fill='freeze'/>"
			        & "<animateTransform attributeName='transform' type='translate' from='26 0' to='0 0' begin='" & FORMAT ( _d, "0.00", "en-US" ) & "s' dur='0.45s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/>"
			        & "<rect x='12' y='4' width='376' height='58' rx='14' fill='" & IF ( [@u] = 1, _c_card, _c_tile ) & "' stroke='" & _c_line & "'/>"
			        & _ico
			        & "<text x='72' y='29' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='600' fill='" & _c_ink & "'>" & [@t] & "</text>"
			        & "<text x='72' y='47' font-family='Segoe UI, Arial, sans-serif' font-size='12' fill='" & _c_muted & "'>" & [@s] & "</text>"
			        & "<text x='374' y='28' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='" & _c_muted & "'>" & [@w] & "</text>"
			        & IF ( [@u] = 1, "<circle cx='370' cy='43' r='4' fill='" & _c_ink & "'/>" )
			        & "</g></g>", "", [@o], ASC, [@q], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='400' height='598' viewBox='0 0 400 598' preserveAspectRatio='none'><defs><filter id='ps' x='-10%' y='-6%' width='120%' height='118%'><feDropShadow dx='0' dy='14' stdDeviation='18' flood-color='#000000' flood-opacity='" & _c_shadowop & "'/></filter></defs><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='0.25s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 -8' to='0 0' dur='0.3s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><path d='M14,12 H275 L286,1 L297,12 H386 A12,12 0 0 1 398,24 V584 A12,12 0 0 1 386,596 H14 A12,12 0 0 1 2,584 V24 A12,12 0 0 1 14,12 Z' fill='" & _c_card & "' stroke='" & _c_line & "' filter='url(#ps)'/><text x='24' y='52' font-family='Segoe UI, Arial, sans-serif' font-size='19' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.3'>Notifications</text><rect x='150' y='36' width='62' height='22' rx='11' fill='" & _c_pill & "'/><text x='181' y='51.5' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' font-weight='600' fill='" & _c_pilltext & "'>"
			        & _n & " new"
			        & "</text><circle cx='364' cy='46' r='15' fill='" & _c_tile & "'/><g transform='translate(356 38) scale(0.666667)' fill='none' stroke='" & _c_ink & "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 6 6 18' /><path d='m6 6 12 12' /></g>"
			        & _items
			        & "<rect x='24' y='550' width='352' height='1' fill='" & _c_line & "'/><text x='24' y='579' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Open</text><text x='70' y='579' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Planning</text><g transform='translate(132 566) scale(0.625)' fill='none' stroke='" & _c_ink & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M7 7h10v10' /><path d='M7 17 17 7' /></g><text x='170' y='579' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Finance</text><g transform='translate(225 566) scale(0.625)' fill='none' stroke='" & _c_ink & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M7 7h10v10' /><path d='M7 17 17 7' /></g></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 78188f63-3bce-5ff8-9381-aee951356b4d
		dataCategory: ImageUrl

	measure 'NM veil (SVG)' =
			
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1159.6' height='985.5' viewBox='0 0 1159.6 985.5' preserveAspectRatio='none'><rect width='1159.6' height='985.5' rx='26' fill='#000000' fill-opacity='0'><animate attributeName='fill-opacity' from='0' to='0.32' dur='0.3s' fill='freeze'/></rect></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: f20f619e-5668-5062-9885-884a8c10c517
		dataCategory: ImageUrl

	measure 'NM sheet (SVG)' =
			
			VAR _c_grid = [Color grid]
			VAR _c_permit = [Color permit]
			VAR _c_design = [Color design]
			VAR _c_construction = [Color construction]
			VAR _c_card = [Color card]
			VAR _c_faint = [Color faint]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_pill = [Color pill]
			VAR _c_pilltext = [Color pilltext]
			VAR _c_shadowop = [Color shadowop]
			VAR _c_tile = [Color tile]
			VAR _k = [NM key]
			VAR _r = [Reference date]
			VAR _d = [NM date]
			VAR _nom = [NM name]
			VAR _cle = [NM type] = "Key milestone"
			VAR _proj = LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], _k )
			VAR _lead = LOOKUPVALUE ( DimProject[LeadKey], DimProject[ProjectKey], _k )
			VAR _ln = LOOKUPVALUE ( DimPerson[Person], DimPerson[PersonKey], _lead )
			VAR _lb = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], _lead )
			VAR _pk = TOPN ( 1, CALCULATETABLE ( FactWorkPackage, REMOVEFILTERS ( DimProject ), FactWorkPackage[ProjectKey] = _k,
			    FactWorkPackage[Start] <= _d, FactWorkPackage[End] >= _d ), FactWorkPackage[Start], ASC )
			VAR _ou = IF ( ISEMPTY ( _pk ), "between phases", MAXX ( _pk, FactWorkPackage[Package] ) & " (" & MAXX ( _pk, FactWorkPackage[Phase] ) & ")" )
			VAR _phrase = FORMAT ( _d, "ddd d mmm yyyy", "en-US" ) & " · " & INT ( _d - _r ) & " days from today · " & SUBSTITUTE ( _ou, "&", "&amp;" )
			VAR _ws = EDATE ( DATE ( YEAR ( _r ), MONTH ( _r ), 1 ), -3 )
			VAR _we = MAX ( EOMONTH ( _r, 9 ), EOMONTH ( _d, 1 ) )
			VAR _wn = INT ( _we - _ws ) + 1
			VAR _ph = CALCULATETABLE ( FactProjectPhase, REMOVEFILTERS ( DimProject ), FactProjectPhase[ProjectKey] = _k,
			    FactProjectPhase[End] >= _ws, FactProjectPhase[Start] <= _we )
			VAR _segs = CONCATENATEX ( _ph,
			    VAR _a = MAX ( FactProjectPhase[Start], _ws ) VAR _b = MIN ( FactProjectPhase[End], _we )
			    VAR _x1 = ( 550 + ( _a - _ws ) / _wn * 515.5999999999999 ) VAR _x2 = ( 550 + ( ( _b + 1 ) - _ws ) / _wn * 515.5999999999999 )
			    VAR _c = SWITCH ( FactProjectPhase[Phase], "Construction", _c_construction, "Design", _c_design, "Permit", _c_permit, _c_ink )
			    VAR _futur = FactProjectPhase[Start] > _r
			    RETURN "<rect x='" & FORMAT ( _x1, "0.0", "en-US" ) & "' y='309' width='" & FORMAT ( MAX ( _x2 - _x1 - 2, 3 ), "0.0", "en-US" ) & "' height='18' rx='9'"
			        & IF ( _futur, " fill='" & _c_card & "' stroke='" & _c_ink & "' stroke-width='1.3'/>", " fill='" & _c & "'/>" )
			        & IF ( _x2 - _x1 > 74, "<text x='" & FORMAT ( _x1 + 10, "0.0", "en-US" ) & "' y='322.5' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='" & IF ( _futur || FactProjectPhase[Phase] = "Permit", _c_ink, _c_pilltext ) & "'>" & FactProjectPhase[Phase] & "</text>" ),
			    "", FactProjectPhase[Start], ASC )
			VAR _jx = CALCULATETABLE ( FactMilestone, REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactMilestone[ProjectKey] = _k,
			    FactMilestone[Date] >= _ws, FactMilestone[Date] <= _we )
			VAR _jals = CONCATENATEX ( _jx, VAR _x = ( 550 + ( ( FactMilestone[Date] + 0.5 ) - _ws ) / _wn * 515.5999999999999 )
			    RETURN "<rect x='" & FORMAT ( _x - 5, "0.0", "en-US" ) & "' y='313' width='10' height='10' transform='rotate(45 " & FORMAT ( _x, "0.0", "en-US" ) & " 318)' fill='" & _c_card & "' stroke='" & _c_muted & "' stroke-width='1.3'/>"
			    & "<text x='" & FORMAT ( _x, "0.0", "en-US" ) & "' y='348' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='10.5' fill='" & _c_muted & "'>" & FORMAT ( FactMilestone[Date], "d mmm", "en-US" ) & "</text>", "" )
			VAR _mois = FILTER ( ADDCOLUMNS ( GENERATESERIES ( 0, DATEDIFF ( _ws, _we, MONTH ) ), "@m", EDATE ( _ws, [Value] ) ), [@m] <= _we )
			VAR _axe = CONCATENATEX ( _mois, VAR _x = ( 550 + ( [@m] - _ws ) / _wn * 515.5999999999999 )
			    RETURN "<rect x='" & FORMAT ( _x - 0.5, "0.0", "en-US" ) & "' y='226' width='1' height='112' fill='" & _c_grid & "'/>"
			    & IF ( MOD ( [Value], 2 ) = 0, "<text x='" & FORMAT ( _x + 4, "0.0", "en-US" ) & "' y='374' font-family='Segoe UI, Arial, sans-serif' font-size='10.5' fill='" & _c_muted & "'>" & UPPER ( FORMAT ( [@m], "mmm yy", "en-US" ) ) & "</text>" ), "", [Value], ASC )
			VAR _xt = ( 550 + ( ( _r + 0.5 ) - _ws ) / _wn * 515.5999999999999 )
			VAR _xn = ( 550 + ( ( _d + 0.5 ) - _ws ) / _wn * 515.5999999999999 )
			VAR _gauche = _xn > 915.5999999999999
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1127.6' height='528.3' viewBox='0 0 1127.6 528.3' preserveAspectRatio='none'><defs><filter id='sh' x='-4%' y='-8%' width='108%' height='116%'><feDropShadow dx='0' dy='-6' stdDeviation='16' flood-color='#000000' flood-opacity='" & _c_shadowop & "'/></filter></defs><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='0.25s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 24' to='0 0' dur='0.35s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><rect x='1' y='1' width='1125.6' height='526.3' rx='26' fill='" & _c_card & "' stroke='" & _c_line & "' filter='url(#sh)'/><rect x='537.8' y='12' width='52' height='5' rx='2.5' fill='" & _c_faint & "'/><text x='32' y='58' font-family='Segoe UI, Arial, sans-serif' font-size='26' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.5'>New milestone</text><text x='240' y='58' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Pick a project, a name and a date: the preview shows where it lands.</text><circle cx='1083.6' cy='50' r='17' fill='" & _c_tile & "'/><g transform='translate(1074.6 41) scale(0.75)' fill='none' stroke='" & _c_ink & "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 6 6 18' /><path d='m6 6 12 12' /></g><text x='34' y='114' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Project</text><rect x='32' y='124' width='456' height='42' rx='21' fill='" & _c_tile & "' stroke='" & _c_line & "'/><text x='34' y='202' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Milestone</text><rect x='32' y='212' width='456' height='40' rx='20' fill='" & _c_tile & "' stroke='" & _c_line & "'/><text x='34' y='288' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Date</text><rect x='32' y='298' width='456' height='40' rx='20' fill='" & _c_tile & "' stroke='" & _c_line & "'/><text x='34' y='374' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Type</text><rect x='32' y='384' width='300' height='40' rx='20' fill='" & _c_tile & "' stroke='" & _c_line & "'/><text x='488' y='288' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='end'>"
			        & FORMAT ( _d, "ddd d mmm yyyy", "en-US" )
			        & "</text><g transform='translate(456 136) scale(0.75)' fill='none' stroke='" & _c_ink & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m6 9 6 6 6-6' /></g><rect x='520' y='92' width='575.5999999999999' height='338' rx='18' fill='" & _c_tile & "' fill-opacity='0.6' stroke='" & _c_line & "'/><text x='544' y='126' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Where it lands</text><text x='544' y='164' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & _phrase
			        & "</text><clipPath id='la'><circle cx='1055.6' cy='128' r='16'/></clipPath><circle cx='1055.6' cy='128' r='17.6' fill='" & _c_card & "'/><image x='1039.6' y='112' width='32' height='32' clip-path='url(#la)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64,"
			        & _lb
			        & "'/><text x='1031.6' y='124' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='600' fill='" & _c_ink & "' text-anchor='end'>"
			        & _proj
			        & "</text><text x='1031.6' y='141' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_muted & "' text-anchor='end'>"
			        & "Lead: " & _ln
			        & "</text>"
			        & _axe
			        & _segs
			        & _jals
			        & "<line x1='"
			        & FORMAT ( _xt, "0.0", "en-US" )
			        & "' y1='222' x2='"
			        & FORMAT ( _xt, "0.0", "en-US" )
			        & "' y2='340' stroke='" & _c_ink & "' stroke-width='1.2' stroke-dasharray='3 4'/><text x='"
			        & FORMAT ( _xt, "0.0", "en-US" )
			        & "' y='216' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11' font-weight='600' fill='" & _c_ink & "'>Today</text><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.25s' dur='0.35s' fill='freeze'/><line x1='"
			        & FORMAT ( _xn, "0.0", "en-US" )
			        & "' y1='260' x2='"
			        & FORMAT ( _xn, "0.0", "en-US" )
			        & "' y2='306' stroke='" & _c_ink & "' stroke-width='1.4'/><rect x='"
			        & FORMAT ( IF ( _gauche, _xn - 160, _xn - 10 ), "0.0", "en-US" )
			        & "' y='220' width='170' height='42' rx='10' fill='" & _c_pill & "'/><text x='"
			        & FORMAT ( IF ( _gauche, _xn - 148, _xn + 2 ), "0.0", "en-US" )
			        & "' y='237' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_pilltext & "'>"
			        & _nom
			        & "</text><text x='"
			        & FORMAT ( IF ( _gauche, _xn - 148, _xn + 2 ), "0.0", "en-US" )
			        & "' y='254' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' fill='" & _c_pilltext & "' fill-opacity='0.8'>"
			        & FORMAT ( _d, "d mmm yyyy", "en-US" ) & " · " & IF ( _cle, "Key milestone", "Checkpoint" )
			        & "</text><rect x='"
			        & FORMAT ( _xn - 10, "0.0", "en-US" )
			        & "' y='308' width='20' height='20' rx='2' transform='rotate(45 "
			        & FORMAT ( _xn, "0.0", "en-US" )
			        & " 318)' fill='"
			        & IF ( _cle, _c_ink, _c_card )
			        & "' stroke='" & _c_ink & "' stroke-width='2.2'/><circle cx='"
			        & FORMAT ( _xn, "0.0", "en-US" )
			        & "' cy='318' r='14' fill='none' stroke='" & _c_ink & "' stroke-width='1.6' opacity='0'><animate attributeName='r' values='14;30' begin='0.7s' dur='1.6s' repeatCount='indefinite'/><animate attributeName='opacity' values='0.6;0' begin='0.7s' dur='1.6s' repeatCount='indefinite'/></circle></g><rect x='32' y='444.29999999999995' width='1063.6' height='1' fill='" & _c_line & "'/><g transform='translate(32 470.3) scale(0.75)' fill='none' stroke='" & _c_muted & "' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z' /><path d='M14 2v4a2 2 0 0 0 2 2h4' /><path d='M10 9H8' /><path d='M16 13H8' /><path d='M16 17H8' /></g><text x='58' y='478.3' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Power BI reports read data, they do not write it. To save this milestone,</text><text x='58' y='496.3' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>connect a write-back flow (a Fabric translytical task flow) to the Add button.</text><rect x='811.5999999999999' y='452' width='128' height='44' rx='22' fill='none' stroke='" & _c_ink & "' stroke-width='1.3'/><text x='875.6' y='479.5' font-family='Segoe UI, Arial, sans-serif' font-size='14.5' font-weight='600' fill='" & _c_ink & "' text-anchor='middle'>Cancel</text><rect x='951.5999999999999' y='452' width='144' height='44' rx='22' fill='" & _c_pill & "'/><g transform='translate(967.6 465) scale(0.75)' fill='none' stroke='" & _c_pilltext & "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14' /><path d='M12 5v14' /></g><text x='1039.6' y='479.5' font-family='Segoe UI, Arial, sans-serif' font-size='14.5' font-weight='600' fill='" & _c_pilltext & "' text-anchor='middle'>Add milestone</text></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: b697c38e-020e-5b00-b5ca-d0bf8b4231fb
		dataCategory: ImageUrl

	measure 'NM toast (SVG)' =
			
			VAR _c_pill = [Color pill]
			VAR _c_pilltext = [Color pilltext]
			VAR _d = [NM date]
			VAR _proj = LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], [NM key] )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='460' height='54' viewBox='0 0 460 54' preserveAspectRatio='none'><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='0.35s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 14' to='0 0' dur='0.4s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><rect x='1' y='1' width='458' height='52' rx='26' fill='" & _c_pill & "'/><circle cx='28' cy='27' r='13' fill='" & _c_pilltext & "'/><g transform='translate(20 19) scale(0.666667)' fill='none' stroke='" & _c_pill & "' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5' /></g><text x='52' y='23' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='600' fill='" & _c_pilltext & "' text-anchor='start'>"
			        & [NM name] & " drafted for " & _proj & " · " & FORMAT ( _d, "d mmm", "en-US" )
			        & "</text><text x='52' y='41' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' font-weight='400' fill='" & _c_pilltext & "' text-anchor='start' fill-opacity='0.75'>Connect a write-back flow to save it to the project plan.</text><g transform='translate(426 19) scale(0.666667)' fill='none' stroke='" & _c_pilltext & "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 6 6 18' /><path d='m6 6 12 12' /></g></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 1c4ed3b4-f028-59cc-9814-d620ca3954b0
		dataCategory: ImageUrl

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 29c0dbcc-56fe-50c0-93bb-be39e4733bb4
		summarizeBy: none
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = DATATABLE ( "Value", INTEGER, { { 1 } } )

