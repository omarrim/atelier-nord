	measure 'KPI band finance (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _k0 = [Fin fees]
			VAR _k1 = [Fin costs]
			VAR _k2 = [Fin margin]
			VAR _k3 = [Outstanding]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1111.8' height='108.4' viewBox='0 0 1157 118.5' preserveAspectRatio='none'><rect x='275.5' y='20' width='1' height='81' fill='" & _c_line & "'/><rect x='566' y='20' width='1' height='81' fill='" & _c_line & "'/><rect x='848.5' y='20' width='1' height='81' fill='" & _c_line & "'/>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k0 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='33' y='51' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & IF ( ABS ( _k0 ) >= 1000000, "€" & FORMAT ( _v / 1000000, "0.000", "en-US" ) & "M", "€" & FORMAT ( _v / 1000, "0.0", "en-US" ) & "k" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.15 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.15 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.15 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.25s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.25s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='33' y='77.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Fees billed</text><text x='33' y='101' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & [Fin fees change label]
			        & "</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k1 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='330.5' y='51' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & IF ( ABS ( _k1 ) >= 1000000, "€" & FORMAT ( _v / 1000000, "0.000", "en-US" ) & "M", "€" & FORMAT ( _v / 1000, "0.0", "en-US" ) & "k" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.25 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.25 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.25 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.35s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.35s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='330.5' y='77.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Operating costs</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k2 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='623' y='51' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( _v, "0.0%", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.35 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.35 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.35 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.45s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.45s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='623' y='77.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Operating margin</text><text x='623' y='101' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & [Fin margin change label]
			        & "</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k3 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='906' y='51' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & IF ( ABS ( _k3 ) >= 1000000, "€" & FORMAT ( _v / 1000000, "0.0", "en-US" ) & "M", "€" & FORMAT ( _v / 1000, "0", "en-US" ) & "k" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.45000000000000007 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.45000000000000007 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.45000000000000007 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.55s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.55s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='906' y='77.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Outstanding invoices</text><text x='906' y='101' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & [Overdue label]
			        & "</text></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: a3958a70-4441-5d70-8f16-a2c47581c395
		dataCategory: ImageUrl

	measure 'Revenue chart (SVG)' =
			
			VAR _c_grid = [Color grid]
			VAR _c_design = [Color design]
			VAR _c_ink = [Color ink]
			VAR _c_ink2 = [Color ink2]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _per = [Finance period]
			VAR _fin = [Fin end]
			VAR _s1 = [Fin start]
			VAR _m1 = IF ( _per = "Year", DATE ( YEAR ( _fin ), 1, 1 ), EDATE ( DATE ( YEAR ( _fin ), MONTH ( _fin ), 1 ), -5 ) )
			VAR _n = DATEDIFF ( _m1, _fin, MONTH ) + 1
			VAR _v = ADDCOLUMNS ( GENERATESERIES ( 0, _n - 1 ), "@d", EDATE ( _m1, [Value] ),
			    "@r", VAR _a = EDATE ( _m1, [Value] ) RETURN CALCULATE ( SUM ( FactInvoice[Amount] ), DATESBETWEEN ( DimDate[Date], _a, EOMONTH ( _a, 0 ) ) ) + 0,
			    "@c", VAR _a = EDATE ( _m1, [Value] ) RETURN CALCULATE ( SUM ( FactCost[Amount] ), DATESBETWEEN ( DimDate[Date], _a, EOMONTH ( _a, 0 ) ) ) + 0 )
			VAR _un = HASONEVALUE ( DimProject[ProjectKey] )
			VAR _pas = 632.5 / MAX ( _n - 1, 1 )
			VAR _max = MAX ( MAXX ( _v, [@r] ), MAXX ( _v, [@c] ) )
			VAR _raw = MAX ( _max, 1 ) / 4
			VAR _e = POWER ( 10, INT ( LOG10 ( _raw ) ) )
			VAR _f = _raw / _e
			VAR _st = _e * SWITCH ( TRUE (), _f <= 1, 1, _f <= 2, 2, _f <= 2.5, 2.5, _f <= 5, 5, 10 )
			VAR _ym = _st * 4
			VAR _xy = ADDCOLUMNS ( _v, "@x", 79 + [Value] * _pas, "@yr", 259 - [@r] / _ym * 173, "@yc", 259 - [@c] / _ym * 173 )
			VAR _lr = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@yr], "0.0", "en-US" ), " ", [Value], ASC )
			VAR _lc = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@yc], "0.0", "en-US" ), " ", [Value], ASC )
			VAR _pts = CONCATENATEX ( _xy,
			    "<circle cx='" & FORMAT ( [@x], "0.0", "en-US" ) & "' cy='" & FORMAT ( [@yc], "0.0", "en-US" ) & "' r='0' fill='" & _c_design & "'><animate attributeName='r' from='0' to='4' begin='" & FORMAT ( 0.5 + [Value] * 0.08, "0.00", "en-US" ) & "s' dur='0.3s' fill='freeze'/></circle>"
			    & "<circle cx='" & FORMAT ( [@x], "0.0", "en-US" ) & "' cy='" & FORMAT ( [@yr], "0.0", "en-US" ) & "' r='0' fill='" & _c_ink & "'><animate attributeName='r' from='0' to='4.6' begin='" & FORMAT ( 0.4 + [Value] * 0.08, "0.00", "en-US" ) & "s' dur='0.3s' fill='freeze'/></circle>", "", [Value], ASC )
			VAR _mx = CONCATENATEX ( _xy, "<rect x='" & FORMAT ( [@x] - 0.5, "0.0", "en-US" ) & "' y='86' width='1' height='173' fill='" & _c_grid & "'/>"
			    & "<text x='" & FORMAT ( [@x], "0.0", "en-US" ) & "' y='281.5' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' fill='" & _c_muted & "'>" & UPPER ( FORMAT ( [@d], "mmm", "en-US" ) ) & "</text>", "", [Value], ASC )
			VAR _yl = CONCATENATEX ( GENERATESERIES ( 0, 4 ), VAR _k = [Value] * _st / 1000
			    RETURN "<rect x='78' y='" & FORMAT ( 259 - [Value] * 43.25, "0.0", "en-US" ) & "' width='634.5' height='1' fill='" & _c_grid & "'/>"
			    & "<text x='67' y='" & FORMAT ( 259 - [Value] * 43.25 + 4.5, "0.0", "en-US" ) & "' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' fill='" & _c_muted & "'>€"
			    & IF ( MOD ( _k, 1 ) = 0, FORMAT ( _k, "0", "en-US" ), FORMAT ( _k, "0.0", "en-US" ) ) & "k</text>", "", [Value], ASC )
			VAR _i1 = DATEDIFF ( _m1, _s1, MONTH )
			VAR _xa = MAX ( 79 + _i1 * _pas - _pas / 2, 71 )
			VAR _xb = MIN ( 711.5 + _pas / 2, 731.5 )
			VAR _band = IF ( _per <> "Year", "<rect x='" & FORMAT ( _xa, "0.0", "en-US" ) & "' y='80' width='" & FORMAT ( _xb - _xa, "0.0", "en-US" ) & "' height='185' rx='10' fill='" & _c_tile & "'/>" )
			VAR _sous = IF ( _un, SELECTEDVALUE ( DimProject[Project] ) & " · ", "" ) & [Fin period label]
			VAR _pr = [Fin profit] VAR _am = [Fin avg monthly fees]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='715.4' height='381.9' viewBox='0 0 750.5 396.5' preserveAspectRatio='none'><text x='23.5' y='44' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Revenue &amp; costs</text><text x='23.5' y='67' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & _sous
			        & "</text><circle cx='519' cy='38' r='7' fill='" & _c_ink & "'/><text x='533' y='43.5' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_ink2 & "' text-anchor='start'>Revenue</text><circle cx='620' cy='38' r='7' fill='" & _c_design & "'/><text x='634' y='43.5' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_ink2 & "' text-anchor='start'>Costs</text>"
			        & _band
			        & _yl
			        & _mx
			        & "<polyline points='"
			        & _lc
			        & "' fill='none' stroke='" & _c_design & "' stroke-width='2.2' stroke-linejoin='round' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'><animate attributeName='stroke-dashoffset' from='1' to='0' begin='0.2s' dur='1.2s' fill='freeze'/></polyline><polyline points='"
			        & _lr
			        & "' fill='none' stroke='" & _c_ink & "' stroke-width='2.6' stroke-linejoin='round' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'><animate attributeName='stroke-dashoffset' from='1' to='0' begin='0.1s' dur='1.2s' fill='freeze'/></polyline>"
			        & _pts
			        & "<rect x='22.5' y='306.5' width='706.5' height='77.5' rx='14' fill='" & _c_tile & "'/><rect x='377.5' y='320' width='1' height='50' fill='" & _c_line & "'/><text x='200' y='331' font-family='Segoe UI, Arial, sans-serif' font-size='14.5' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>Operating profit</text><text x='553' y='331' font-family='Segoe UI, Arial, sans-serif' font-size='14.5' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>Average monthly fees</text>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _pr * _e VAR _fin = [Value] = 24
			        RETURN "<text x='200' y='366' font-family='Segoe UI, Arial, sans-serif' font-size='32' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' text-anchor='middle' letter-spacing='-0.6' opacity='" & IF ( _fin, "1", "0" ) & "'>" & "€" & FORMAT ( _v / 1000, "0", "en-US" ) & "k"
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.3 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.3 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.3 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _am * _e VAR _fin = [Value] = 24
			        RETURN "<text x='553' y='366' font-family='Segoe UI, Arial, sans-serif' font-size='32' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' text-anchor='middle' letter-spacing='-0.6' opacity='" & IF ( _fin, "1", "0" ) & "'>" & "€" & FORMAT ( _v / 1000, "0.0", "en-US" ) & "k"
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.4 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.4 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.4 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 80a75747-3b59-55d8-b983-e677f6711817
		dataCategory: ImageUrl

	measure 'Receivables (SVG)' =
			
			VAR _c_black = [Color black]
			VAR _c_blackrim = [Color blackrim]
			VAR _c_blacktrack = [Color blacktrack]
			VAR _c_onblack = [Color onblack]
			VAR _c_onblack2 = [Color onblack2]
			VAR _r = [Reference date]
			VAR _o = [Outstanding]
			VAR _od = [Overdue]
			VAR _w = _o - _od
			VAR _n = [Outstanding count]
			VAR _pw = DIVIDE ( _w, _o )
			VAR _po = DIVIDE ( _od, _o )
			VAR _np = CALCULATETABLE ( FactInvoice, REMOVEFILTERS ( DimDate ), REMOVEFILTERS ( DimProject ), FactInvoice[IssueDate] <= _r,
			    ISBLANK ( FactInvoice[PaidDate] ) || FactInvoice[PaidDate] > _r, FactInvoice[DueDate] >= _r )
			VAR _nx = TOPN ( 1, _np, FactInvoice[DueDate], ASC, FactInvoice[Invoice], ASC )
			VAR _nd = MINX ( _nx, FactInvoice[DueDate] ) VAR _na = MINX ( _nx, FactInvoice[Amount] )
			VAR _npj = LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], MINX ( _nx, FactInvoice[ProjectKey] ) )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='375.9' height='381.9' viewBox='0 0 396.5 395.5' preserveAspectRatio='none'><rect width='396.5' height='395.5' rx='18' fill='" & _c_black & "' stroke='" & _c_blackrim & "' stroke-width='1.2'/><text x='21.5' y='38' font-family='Segoe UI, Arial, sans-serif' font-size='24' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.4'>Receivables</text>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _o * _e VAR _fin = [Value] = 24
			        RETURN "<text x='21.5' y='127.5' font-family='Segoe UI, Arial, sans-serif' font-size='60' font-weight='600' fill='" & _c_onblack & "' style='font-variant-numeric:tabular-nums' letter-spacing='-2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & "€" & FORMAT ( _v / 1000, "0", "en-US" ) & "k"
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.2 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.2 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.2 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<text x='21.5' y='155' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>Awaiting payment</text><circle cx='296.5' cy='126.5' r='62' fill='none' stroke='" & _c_blacktrack & "' stroke-width='22'/><circle cx='296.5' cy='126.5' r='62' fill='none' stroke='" & _c_onblack & "' stroke-width='22' transform='rotate(-90 296.5 126.5)' stroke-dasharray='0 389.56'><animate attributeName='stroke-dasharray' from='0 389.56' to='"
			        & FORMAT ( 389.5575 * _pw, "0.0", "en-US" ) & " 389.56"
			        & "' begin='0.3s' dur='0.9s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></circle><circle cx='296.5' cy='126.5' r='62' fill='none' stroke='" & _c_onblack2 & "' stroke-width='22' transform='rotate("
			        & FORMAT ( -90 + 360 * _pw, "0.0", "en-US" )
			        & " 296.5 126.5)' stroke-dasharray='0 389.56'><animate attributeName='stroke-dasharray' from='0 389.56' to='"
			        & FORMAT ( 389.5575 * _po, "0.0", "en-US" ) & " 389.56"
			        & "' begin='1.1s' dur='0.6s' fill='freeze'/></circle>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _n * _e VAR _fin = [Value] = 24
			        RETURN "<text x='296.5' y='137' font-family='Segoe UI, Arial, sans-serif' font-size='42' font-weight='600' fill='" & _c_onblack & "' style='font-variant-numeric:tabular-nums' text-anchor='middle' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( ROUND ( _v, 0 ), "0" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.3 + ( 24 - 1 ) * 0.03750, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.3 + ( [Value] - 1 ) * 0.03750, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.3 + [Value] * 0.03750, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<text x='296.5' y='157' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='middle'>invoices</text><circle cx='28.5' cy='221' r='8' fill='" & _c_onblack & "'/><text x='50' y='226' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_onblack & "' text-anchor='start'>Within terms</text><text x='197.5' y='226' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_onblack & "' text-anchor='start'>"
			        & "€" & FORMAT ( _w / 1000, "0", "en-US" ) & "k"
			        & "</text><text x='373' y='226' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_onblack & "' text-anchor='end'>"
			        & FORMAT ( _pw, "0.0%", "en-US" )
			        & "</text><circle cx='28.5' cy='250' r='8' fill='" & _c_onblack2 & "'/><text x='50' y='255' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_onblack & "' text-anchor='start'>Overdue</text><text x='197.5' y='255' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_onblack & "' text-anchor='start'>"
			        & "€" & FORMAT ( _od / 1000, "0", "en-US" ) & "k"
			        & "</text><text x='373' y='255' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_onblack & "' text-anchor='end'>"
			        & FORMAT ( _po, "0.0%", "en-US" )
			        & "</text><rect x='21.5' y='285.5' width='351.5' height='1' fill='" & _c_onblack & "' fill-opacity='0.18'/><text x='21.5' y='311' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>Next expected payment</text><text x='21.5' y='345' font-family='Segoe UI, Arial, sans-serif' font-size='32' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.6'>"
			        & "€" & FORMAT ( _na / 1000, "0", "en-US" ) & "k · " & UPPER ( FORMAT ( _nd, "d mmm", "en-US" ) )
			        & "</text><text x='21.5' y='372' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>"
			        & _npj
