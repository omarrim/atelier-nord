			VAR _c_chip = [Color chip]
			VAR _c_ink = [Color ink]
			VAR _c_rim = [Color rim]
			VAR _c_rimop = [Color rimop]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='198.9' height='33.3' viewBox='0 0 200 33.5' preserveAspectRatio='none'><rect x='0.5' y='0.5' width='199' height='32.5' rx='16.25' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "'/><rect x='2' y='2' width='100' height='29.5' rx='14.75' fill='" & _c_chip & "' filter='none'/><g fill='none' stroke='" & _c_ink & "' stroke-width='1.6'><rect x='26' y='10' width='5.6' height='5.6' rx='1.2'/><rect x='26' y='18' width='5.6' height='5.6' rx='1.2'/><rect x='34' y='10' width='5.6' height='5.6' rx='1.2'/><rect x='34' y='18' width='5.6' height='5.6' rx='1.2'/></g><text x='51' y='21.5' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>Grid</text><g stroke='" & _c_ink & "' stroke-width='1.6' stroke-linecap='round'><circle cx='132' cy='11' r='1.3' fill='" & _c_ink & "'/><line x1='137.5' y1='11' x2='147' y2='11'/><circle cx='132' cy='16.75' r='1.3' fill='" & _c_ink & "'/><line x1='137.5' y1='16.75' x2='147' y2='16.75'/><circle cx='132' cy='22.5' r='1.3' fill='" & _c_ink & "'/><line x1='137.5' y1='22.5' x2='147' y2='22.5'/></g><text x='156.5' y='21.5' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>List</text></svg>"
