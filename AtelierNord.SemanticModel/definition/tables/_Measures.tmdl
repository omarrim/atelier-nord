			        & IF ( _reg = "94", "<path d='M453.5,437.7 L453.5,444.0 L452.7,444.6 L453.1,445.3 L450.5,447.2 L450.7,448.2 L451.3,447.4 L452.6,447.7 L450.4,450.6 L450.5,452.1 L448.8,453.6 L449.5,454.9 L448.7,456.4 L445.4,455.2 L445.5,453.5 L444.0,452.6 L439.9,451.2 L437.0,447.9 L437.5,446.5 L439.5,445.8 L440.7,444.2 L437.0,443.3 L436.9,442.2 L435.6,442.9 L434.7,441.9 L435.8,440.8 L435.3,440.0 L437.3,438.8 L437.1,436.8 L437.7,436.5 L437.1,435.2 L432.7,436.1 L432.9,435.2 L432.3,434.1 L434.1,433.2 L433.9,432.0 L436.1,430.8 L436.1,430.0 L435.6,429.9 L435.3,428.7 L431.8,426.4 L431.4,423.3 L434.8,421.8 L433.1,420.5 L432.8,419.0 L431.4,419.7 L431.1,419.1 L431.7,417.8 L432.6,417.6 L432.6,416.5 L433.8,416.5 L434.1,412.8 L435.3,412.4 L435.6,411.2 L436.5,410.6 L437.3,411.1 L437.9,409.5 L440.8,408.1 L443.2,408.0 L446.2,404.5 L448.7,404.3 L450.7,406.7 L451.4,405.8 L452.0,404.3 L451.9,401.9 L451.1,400.8 L451.7,399.2 L451.4,398.1 L452.4,396.4 L451.9,394.5 L452.4,394.0 L455.1,394.8 L454.8,395.6 L455.9,402.1 L454.7,406.7 L456.8,410.8 L457.0,417.7 L457.7,421.6 L457.4,428.4 L453.8,434.0 L453.5,437.7Z' fill='" & _c_ink & "' fill-opacity='0' stroke='" & _c_ink & "' stroke-width='1.1' stroke-linejoin='round'><animate attributeName='fill-opacity' from='0' to='0.88' begin='0.3s' dur='0.8s' fill='freeze'/></path>" )
			        & _pins
			        & "<g opacity='0' transform='translate(0 -22)'><animate attributeName='opacity' from='0' to='1' begin='1.1s' dur='0.3s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 -22' to='0 0' begin='1.1s' dur='0.5s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.3 1.4 0.6 1'/><circle cx='"
			        & FORMAT ( _cx, "0.0", "en-US" )
			        & "' cy='"
			        & FORMAT ( _cy, "0.0", "en-US" )
			        & "' r='9' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' opacity='0'><animate attributeName='r' values='9;30' begin='1.7s' dur='1.8s' repeatCount='indefinite'/><animate attributeName='opacity' values='0.7;0' begin='1.7s' dur='1.8s' repeatCount='indefinite'/></circle><circle cx='"
			        & FORMAT ( _cx, "0.0", "en-US" )
			        & "' cy='"
			        & FORMAT ( _cy, "0.0", "en-US" )
			        & "' r='11' fill='" & _c_card & "'/><circle cx='"
			        & FORMAT ( _cx, "0.0", "en-US" )
			        & "' cy='"
			        & FORMAT ( _cy, "0.0", "en-US" )
			        & "' r='8.2' fill='" & _c_ink & "'/><text x='"
			        & FORMAT ( IF ( _gauche, _cx - 17, _cx + 17 ), "0.0", "en-US" )
			        & "' y='"
			        & FORMAT ( _cy + 6, "0.0", "en-US" )
			        & "' text-anchor='"
			        & IF ( _gauche, "end", "start" )
			        & "' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='600' fill='" & _c_ink & "' stroke='" & _c_card & "' stroke-width='5' paint-order='stroke' stroke-linejoin='round'>"
			        & _ville
			        & "</text></g><circle cx='30' cy='487' r='6.5' fill='" & _c_ink & "'/><text x='44' y='492' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>This project</text><circle cx='160' cy='487' r='4.8' fill='" & _c_design & "'/><text x='173' y='492' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Other projects</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 8fd7b4c3-edc3-5d37-b8bf-ab8ca26e5ba0
		dataCategory: ImageUrl

	measure 'Project block (SVG)' =
			
			VAR _c_bpermit = [Color bpermit]
			VAR _c_bgrid = [Color bgrid]
			VAR _c_bdesign = [Color bdesign]
			VAR _c_black = [Color black]
			VAR _c_blackrim = [Color blackrim]
			VAR _c_onblack = [Color onblack]
			VAR _c_onblack2 = [Color onblack2]
			VAR _img = [Shown render]
			VAR _p = [Shown progress]
			VAR _hk = [Shown project key]
			VAR _hr = [Reference date]
			VAR _hph = CALCULATETABLE ( FactProjectPhase, REMOVEFILTERS ( DimProject ), FactProjectPhase[ProjectKey] = _hk )
			VAR _hs = MINX ( _hph, FactProjectPhase[Start] ) VAR _he = MAXX ( _hph, FactProjectPhase[End] )
			VAR _hms = DATE ( YEAR ( _hs ), MONTH ( _hs ), 1 )
			VAR _hnm = DATEDIFF ( _hms, _he, MONTH ) + 1
			VAR _hfin = EDATE ( _hms, _hnm )
			VAR _hspan = INT ( _hfin - _hms )
			VAR _htot = CALCULATE ( SUM ( FactPlan[PlannedHours] ), REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactPlan[ProjectKey] = _hk )
			VAR _hact = CALCULATE ( SUM ( FactTimesheet[Hours] ), REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactTimesheet[ProjectKey] = _hk, FactTimesheet[Date] < _hr )
			VAR _hpts = ADDCOLUMNS ( GENERATESERIES ( 0, _hnm ), "@d", EDATE ( _hms, [Value] ),
			    "@p", VAR _d = EDATE ( _hms, [Value] ) RETURN CALCULATE ( SUM ( FactPlan[PlannedHours] ), REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactPlan[ProjectKey] = _hk, FactPlan[WeekStart] < _d ) + 0,
			    "@a", VAR _d = EDATE ( _hms, [Value] ) RETURN IF ( _d <= _hr, CALCULATE ( SUM ( FactTimesheet[Hours] ), REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactTimesheet[ProjectKey] = _hk, FactTimesheet[Date] < _d ) + 0 ) )
			VAR _hraw = MAX ( MAX ( _htot, _hact ), 1 ) * 1.05 / 2
			VAR _he10 = POWER ( 10, INT ( LOG10 ( _hraw ) ) )
			VAR _hf = _hraw / _he10
			VAR _hst = CEILING ( _hraw, _he10 / 2 )
			VAR _hym = _hst * 2
			VAR _hxy = ADDCOLUMNS ( _hpts, "@x", ( 62 + ( [@d] - _hms ) / _hspan * 537 ), "@yp", 702 - [@p] / _hym * 90, "@ya", 702 - [@a] / _hym * 90 )
			VAR _hlp = CONCATENATEX ( _hxy, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@yp], "0.0", "en-US" ), " ", [Value], ASC )
			VAR _hxt = ( 62 + ( _hr - _hms ) / _hspan * 537 )
			VAR _hyt = 702 - _hact / _hym * 90
			VAR _hla = CONCATENATEX ( FILTER ( _hxy, NOT ISBLANK ( [@a] ) ), FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@ya], "0.0", "en-US" ), " ", [Value], ASC ) & " " & FORMAT ( _hxt, "0.0", "en-US" ) & "," & FORMAT ( _hyt, "0.0", "en-US" )
			VAR _hx0 = ( 62 + ( _hms - _hms ) / _hspan * 537 )
			VAR _hau = _hlp & " 599,582 62,582"
			VAR _haire = _hla & " " & FORMAT ( _hxt, "0.0", "en-US" ) & ",702 " & FORMAT ( _hx0, "0.0", "en-US" ) & ",702"
			VAR _hgr = CONCATENATEX ( GENERATESERIES ( 0, 2 ), VAR _q = [Value] * _hst
			    RETURN "<rect x='62' y='" & FORMAT ( 702 - [Value] * 45.0, "0.0", "en-US" ) & "' width='537' height='1' fill='" & _c_bgrid & "'/>"
			    & "<text x='53' y='" & FORMAT ( 702 - [Value] * 45.0 + 4, "0.0", "en-US" ) & "' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='" & _c_onblack2 & "'>"
			    & FORMAT ( _q, "#,0", "en-US" ) & "</text>", "", [Value], ASC )
			VAR _hans = FILTER ( ADDCOLUMNS ( GENERATESERIES ( YEAR ( _hms ), YEAR ( _hfin ) ), "@j", DATE ( [Value], 1, 1 ) ), [@j] > _hms && [@j] < _hfin )
			VAR _hannees = CONCATENATEX ( _hans, VAR _x = ( 62 + ( [@j] - _hms ) / _hspan * 537 )
			    RETURN "<rect x='" & FORMAT ( _x - 0.5, "0.0", "en-US" ) & "' y='612' width='1' height='96' fill='" & _c_bgrid & "'/>"
			    & "<text x='" & FORMAT ( _x + 5, "0.0", "en-US" ) & "' y='717' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='" & _c_onblack2 & "'>" & [Value] & "</text>", "", [Value], ASC )
			VAR _hsegs = CONCATENATEX ( _hph,
			    VAR _x1 = ( 62 + ( FactProjectPhase[Start] - _hms ) / _hspan * 537 ) VAR _x2 = ( 62 + ( ( FactProjectPhase[End] + 1 ) - _hms ) / _hspan * 537 )
			    VAR _c = SWITCH ( FactProjectPhase[Phase], "Construction", _c_onblack, "Design", _c_bdesign, "Permit", _c_bpermit, _c_onblack2 )
			    VAR _futur = FactProjectPhase[Start] > _hr
			    VAR _rang = RANKX ( _hph, FactProjectPhase[Start], , ASC ) VAR _dy = IF ( MOD ( _rang, 2 ) = 0, 30, 0 )
			    VAR _bord = _x1 > 479
			    VAR _lx = IF ( _bord, _x2 - 2, _x1 + 2 ) VAR _ancre = IF ( _bord, "end", "start" )
			    RETURN "<rect x='" & FORMAT ( _x1, "0.0", "en-US" ) & "' y='728' width='" & FORMAT ( MAX ( _x2 - _x1 - 2, 3 ), "0.0", "en-US" ) & "' height='16' rx='5'"
			        & IF ( _futur, " fill='" & _c_black & "' stroke='" & _c & "' stroke-width='1.3'/>", " fill='" & _c & "'/>" )
			        & "<text x='" & FORMAT ( _lx, "0.0", "en-US" ) & "' y='" & ( 762 + _dy ) & "' text-anchor='" & _ancre & "' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='600' fill='" & _c_onblack & "'>" & FactProjectPhase[Phase]
			        & "<tspan font-weight='400' fill='" & _c_onblack2 & "'> · " & FORMAT ( FactProjectPhase[Start], "mmm yy", "en-US" ) & " to " & FORMAT ( FactProjectPhase[End], "mmm yy", "en-US" ) & "</tspan></text>",
			    "", FactProjectPhase[Start], ASC )
			VAR _hecart = DIVIDE ( _hact, CALCULATE ( SUM ( FactPlan[PlannedHours] ), REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactPlan[ProjectKey] = _hk, FactPlan[WeekStart] < _hr ) ) - 1
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='592.1' height='818.5' viewBox='0 0 623 826.5' preserveAspectRatio='none'><clipPath id='c'><rect width='623' height='826.5' rx='20'/></clipPath><g clip-path='url(#c)'><rect width='623' height='826.5' fill='" & _c_black & "'/><defs><image id='b' x='0' y='0' width='623' height='505' preserveAspectRatio='xMidYMid slice' href='"
			        & _img
			        & "'/><clipPath id='k'><rect x='0' y='505' width='623' height='0'><animate attributeName='y' from='505' to='"
			        & FORMAT ( 465 * ( 1 - _p ), "0.0", "en-US" )
			        & "' begin='0.3s' dur='2.0s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.33 1 0.68 1'/><animate attributeName='height' from='0' to='"
			        & FORMAT ( 505 - 465 * ( 1 - _p ), "0.0", "en-US" )
			        & "' begin='0.3s' dur='2.0s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.33 1 0.68 1'/></rect></clipPath></defs><use href='#b' opacity='0.26'/><use href='#b' clip-path='url(#k)'/><rect x='0' y='505' width='623' height='2' fill='#FFFFFF' opacity='0.95'><animate attributeName='y' from='505' to='"
			        & FORMAT ( 465 * ( 1 - _p ), "0.0", "en-US" )
			        & "' begin='0.3s' dur='2.0s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.33 1 0.68 1'/></rect><defs><filter id='ts' x='-20%' y='-40%' width='140%' height='180%'><feDropShadow dx='0' dy='2' stdDeviation='7' flood-color='#000000' flood-opacity='0.6'/></filter></defs><g filter='url(#ts)'><g transform='translate(0 505)'><animateTransform attributeName='transform' type='translate' from='0 505' to='0 "
			        & FORMAT ( 465 * ( 1 - _p ), "0.0", "en-US" )
			        & "' begin='0.3s' dur='2.0s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.33 1 0.68 1'/><g transform='translate(0 "
			        & IF ( 465 * ( 1 - _p ) < 158, 112, 0 )
			        & ")'>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 30 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 30, 3 ) VAR _v = _p * _e VAR _fin = [Value] = 30
			        RETURN "<text x='595' y='-20' font-family='Segoe UI, Arial, sans-serif' font-size='86' font-weight='600' fill='#FFFFFF' style='font-variant-numeric:tabular-nums' text-anchor='end' letter-spacing='-2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( _v, "0%", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.3 + ( 30 - 1 ) * 0.06667, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.3 + ( [Value] - 1 ) * 0.06667, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.3 + [Value] * 0.06667, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<text x='593' y='30' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='19' font-weight='600' fill='#FFFFFF' letter-spacing='0.6'>built</text></g></g></g><defs><linearGradient id='h' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='" & _c_black & "' stop-opacity='0.75'/><stop offset='1' stop-color='" & _c_black & "' stop-opacity='0'/></linearGradient><linearGradient id='v' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='" & _c_black & "' stop-opacity='0'/><stop offset='1' stop-color='" & _c_black & "' stop-opacity='1'/></linearGradient></defs><rect width='623' height='120' fill='url(#h)'/><rect y='395' width='623' height='111' fill='url(#v)'/></g><rect x='0.6' y='0.6' width='621.8' height='825.3' rx='20' fill='none' stroke='" & _c_blackrim & "' stroke-width='1.2'/><text x='26' y='48' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.4'>The building, as it stands</text><text x='26' y='74' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>"
			        & [Shown phase] & " · " & FORMAT ( _p, "0%", "en-US" ) & " of the phase done"
