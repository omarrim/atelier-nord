	measure 'Register card (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _n = [Visible projects]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='715.4' height='550.6' viewBox='0 0 750.5 563' preserveAspectRatio='none'><text x='23' y='39' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Project register</text><text x='716' y='34' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='end'>"
			        & IF ( _n = 0, "No project", _n & IF ( _n = 1, " project", " projects" ) )
			        & "</text><text x='27.5' y='72' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Project</text><text x='286.5' y='72' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Phase</text><text x='407.5' y='72' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Progress</text><text x='583' y='72' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Status</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
