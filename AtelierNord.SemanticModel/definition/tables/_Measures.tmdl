			VAR _c_construction = [Color construction]
			VAR _c_chip = [Color chip]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _o = [Gantt order planning]
			VAR _nom = SELECTEDVALUE ( DimProject[Project] )
			VAR _ts = [Selected timescale]
			VAR _r = [Reference date]
			VAR _ws = [Planning window start]
			VAR _we = [Planning window end]
			VAR _n = INT ( _we - _ws ) + 1
			VAR _hebdo = _ts IN { "Week", "Month" }
			VAR _nt = SWITCH ( _ts, "Week", 4, "Month", 13, "Quarter", 6, 12 )
			VAR _ticks = ADDCOLUMNS ( GENERATESERIES ( 0, _nt ), "@d", IF ( _hebdo, _ws + 7 * [Value], EDATE ( _ws, [Value] ) ) )
			VAR _segs = FILTER ( FactProjectPhase, FactProjectPhase[End] >= _ws && FactProjectPhase[Start] <= _we )
			VAR _xy = ADDCOLUMNS ( _segs, "@x1", ( 156 + ( MAX ( FactProjectPhase[Start], _ws ) - _ws ) / _n * 576 ), "@x2", ( 156 + ( ( MIN ( FactProjectPhase[End], _we ) + 1 ) - _ws ) / _n * 576 ) )
			VAR _deb = MINX ( _xy, [@x1] )
			VAR _couloir = IF ( NOT ISBLANK ( _deb ), "<rect x='" & FORMAT ( _deb, "0.0", "en-US" ) & "' y='12' width='" & FORMAT ( 732 - _deb, "0.0", "en-US" ) & "' height='20' rx='10' fill='" & _c_track & "' opacity='0.7'/>" )
			VAR _barres = CONCATENATEX ( _xy,
			    VAR _w = MAX ( [@x2] - [@x1] - 2, 3 ) VAR _ph = FactProjectPhase[Phase] VAR _futur = FactProjectPhase[Start] > _r
			    VAR _c = SWITCH ( _ph, "Construction", _c_construction, "Design", _c_design, "Permit", _c_permit, _c_design )
			    VAR _tc = IF ( _futur || _ph = "Permit", _c_ink, _c_pilltext )
			    VAR _lib = IF ( _w > LEN ( _ph ) * 7.4 + 22, "<text x='" & FORMAT ( [@x1] + 13, "0.0", "en-US" ) & "' y='26.5' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' fill='" & _tc & "'>" & _ph & "</text>" )
			    RETURN "<rect x='" & FORMAT ( [@x1], "0.0", "en-US" ) & "' y='12' width='" & FORMAT ( _w, "0.0", "en-US" ) & "' height='20' rx='10'"
			        & IF ( _futur, " fill='" & _c_future & "' stroke='" & _c_ink & "' stroke-width='1.3'/>", " fill='" & _c & "'/>" ) & _lib,
			    "", FactProjectPhase[Start], ASC )
			VAR _jal = FILTER ( FactMilestone, FactMilestone[Kind] = "Major" && FactMilestone[Date] >= _ws && FactMilestone[Date] <= _we )
			VAR _losanges = CONCATENATEX ( _jal, VAR _x = ( 156 + ( ( FactMilestone[Date] + 0.5 ) - _ws ) / _n * 576 )
			    RETURN "<rect x='" & FORMAT ( _x - 6.5, "0.0", "en-US" ) & "' y='15.5' width='13' height='13' transform='rotate(45 " & FORMAT ( _x, "0.0", "en-US" ) & " 22)' fill='" & _c_chip & "' stroke='" & _c_ink & "' stroke-width='1.5'/>"
			        & "<text x='" & FORMAT ( _x, "0.0", "en-US" ) & "' y='42.5' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='" & _c_ink & "'>" & FORMAT ( FactMilestone[Date], "d mmm", "en-US" ) & "</text>", "" )
			VAR _al = FILTER ( FactAlert, FactAlert[Date] >= _ws && FactAlert[Date] <= _we )
			VAR _alertes = CONCATENATEX ( _al, "<g transform='translate(" & FORMAT ( ( 156 + ( ( FactAlert[Date] + 0.5 ) - _ws ) / _n * 576 ), "0.0", "en-US" ) & " 22)'><path d='M0,-9 L8.5,6.5 L-8.5,6.5 Z' fill='" & _c_chip & "' stroke='" & _c_ink & "' stroke-width='1.5' stroke-linejoin='round'/><line x1='0' y1='-3' x2='0' y2='1.5' stroke='" & _c_ink & "' stroke-width='1.6' stroke-linecap='round'/><circle cx='0' cy='4' r='0.9' fill='" & _c_ink & "'/></g>", "" )
			VAR _grille = CONCATENATEX ( _ticks, VAR _x = ( 156 + ( [@d] - _ws ) / _n * 576 ) VAR _mois = IF ( _hebdo, DAY ( [@d] ) <= 7, MONTH ( [@d] ) = 1 )
			    RETURN "<rect x='" & FORMAT ( _x - 0.5, "0.0", "en-US" ) & "' y='0' width='1' height='44' fill='" & IF ( _mois, _c_line, _c_grid ) & "'/>", "" )
			VAR _xt = ( 156 + ( ( _r + 0.5 ) - _ws ) / _n * 576 )
			VAR _today = IF ( _r >= _ws && _r <= _we, "<line x1='" & FORMAT ( _xt, "0.0", "en-US" ) & "' y1='0' x2='" & FORMAT ( _xt, "0.0", "en-US" ) & "' y2='44' stroke='" & _c_ink & "' stroke-width='1.2' stroke-dasharray='3 4' stroke-dashoffset='" & MOD ( ( _o - 1 ) * 44, 7 ) & "'/>" )
			VAR _debut = 0.15 + 0.07 * ( _o - 1 )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='736' height='44' viewBox='0 0 736 44' preserveAspectRatio='none'><rect x='0' y='43' width='736' height='1' fill='" & _c_line & "'/>"
			        & _grille
			        & "<text x='9.5' y='27.5' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' fill='" & _c_ink & "'>"
			        & _nom
			        & "</text><clipPath id='r'><rect x='152' y='0' width='0' height='44'><animate attributeName='width' from='0' to='588' begin='"
			        & FORMAT ( _debut, "0.00", "en-US" )
			        & "s' dur='1s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect></clipPath><g clip-path='url(#r)'>"
			        & _couloir
			        & _barres
			        & "</g><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='"
			        & FORMAT ( _debut + 0.6, "0.00", "en-US" )
			        & "s' dur='0.4s' fill='freeze'/>"
			        & _losanges
			        & _alertes
			        & "</g>"
			        & _today
			        & "</svg>"
			RETURN IF ( NOT ISBLANK ( _o ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" ) )
		displayFolder: 90 SVG
		lineageTag: b1b16436-33bb-59e4-b38b-f553190360dd
		dataCategory: ImageUrl

	measure 'Gantt axis planning (SVG)' =
			
			VAR _c_line = [Color line]
			VAR _c_grid = [Color grid]
			VAR _c_ink2 = [Color ink2]
			VAR _c_ink = [Color ink]
			VAR _ts = [Selected timescale]
			VAR _r = [Reference date]
			VAR _ws = [Planning window start]
			VAR _we = [Planning window end]
			VAR _n = INT ( _we - _ws ) + 1
			VAR _hebdo = _ts IN { "Week", "Month" }
			VAR _nt = SWITCH ( _ts, "Week", 4, "Month", 13, "Quarter", 6, 12 )
			VAR _ticks = ADDCOLUMNS ( GENERATESERIES ( 0, _nt ), "@d", IF ( _hebdo, _ws + 7 * [Value], EDATE ( _ws, [Value] ) ) )
			VAR _bas = CONCATENATEX ( FILTER ( _ticks, [Value] < _nt ), VAR _d = [@d] VAR _e = IF ( _hebdo, _d + 7, EDATE ( _d, 1 ) )
			    VAR _lib = IF ( _hebdo, FORMAT ( DAY ( _d ), "0" ), UPPER ( FORMAT ( _d, "mmm", "en-US" ) ) )
			    RETURN "<text x='" & FORMAT ( ( 156 + ( ( _d + _e ) / 2 - _ws ) / _n * 576 ), "0.0", "en-US" ) & "' y='37.5' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='13' fill='" & _c_ink2 & "'>" & _lib & "</text>"
			        & "<rect x='" & FORMAT ( ( 156 + ( _d - _ws ) / _n * 576 ) - 0.5, "0.0", "en-US" ) & "' y='22' width='1' height='23' fill='" & _c_grid & "'/>", "", [Value], ASC )
			VAR _hauts = ADDCOLUMNS ( GENERATESERIES ( 0, IF ( _hebdo, 4, 2 ) ), "@a", IF ( _hebdo, EDATE ( DATE ( YEAR ( _ws ), MONTH ( _ws ), 1 ), [Value] ), DATE ( YEAR ( _ws ) + [Value], 1, 1 ) ) )
			VAR _haut = CONCATENATEX ( _hauts, VAR _a = MAX ( [@a], _ws ) VAR _b = MIN ( IF ( _hebdo, EOMONTH ( [@a], 0 ), DATE ( YEAR ( [@a] ), 12, 31 ) ), _we )
			    RETURN IF ( _b - _a >= 6, "<text x='" & FORMAT ( ( 156 + ( ( _a + _b + 1 ) / 2 - _ws ) / _n * 576 ), "0.0", "en-US" ) & "' y='16' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='13' letter-spacing='0.4' fill='" & _c_ink & "'>" & IF ( _hebdo, UPPER ( FORMAT ( [@a], "mmm", "en-US" ) ), FORMAT ( YEAR ( [@a] ), "0" ) ) & "</text>" & IF ( [@a] > _ws, "<rect x='" & FORMAT ( ( 156 + ( [@a] - _ws ) / _n * 576 ) - 0.5, "0.0", "en-US" ) & "' y='0' width='1' height='45' fill='" & _c_line & "'/>" ) ), "", [@a], ASC )
			VAR _xt = ( 156 + ( ( _r + 0.5 ) - _ws ) / _n * 576 )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='736' height='45' viewBox='0 0 736 45' preserveAspectRatio='none'>"
			        & _haut
			        & _bas
			        & IF ( _r >= _ws && _r <= _we, "<circle cx='" & FORMAT ( _xt, "0.0", "en-US" ) & "' cy='42' r='3.3' fill='" & _c_ink & "'/>" )
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 39dce7ec-567c-545a-a716-e060cd5aae85
		dataCategory: ImageUrl

	measure 'Milestone calendar (SVG)' =
			
			VAR _c_pilltext = [Color pilltext]
			VAR _c_pill = [Color pill]
			VAR _c_faint = [Color faint]
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _m = [Selected month start]
			VAR _r = [Reference date]
			VAR _nj = DAY ( EOMONTH ( _m, 0 ) )
			VAR _dec = WEEKDAY ( _m, 2 ) - 1
			VAR _nl = ROUNDUP ( ( _dec + _nj ) / 7, 0 )
			VAR _pas = IF ( _nl > 5, 26, 29 )
			VAR _y0 = IF ( _nl > 5, 109, 114 )
			VAR _jal = CALCULATETABLE ( FactMilestone, REMOVEFILTERS ( DimProject ), FactMilestone[Date] >= _m, FactMilestone[Date] <= EOMONTH ( _m, 0 ) )
			VAR _cle = TOPN ( 1, FILTER ( _jal, FactMilestone[Kind] = "Major" && FactMilestone[Date] >= _r ), FactMilestone[Date], ASC )
			VAR _dc = MINX ( _cle, FactMilestone[Date] )
			VAR _jours = CONCATENATEX ( GENERATESERIES ( 1, _nj ), VAR _d = _m + [Value] - 1 VAR _i = _dec + [Value] - 1
			    VAR _x = 39.5 + MOD ( _i, 7 ) * 47.2 VAR _y = _y0 + INT ( _i / 7 ) * _pas VAR _auj = _d = _r
			    VAR _a = NOT ISEMPTY ( FILTER ( _jal, FactMilestone[Date] = _d ) )
			    RETURN IF ( _auj, "<circle cx='" & FORMAT ( _x, "0.0", "en-US" ) & "' cy='" & FORMAT ( _y - 5.5, "0.0", "en-US" ) & "' r='" & IF ( _nl > 5, 13, 15.5 ) & "' fill='" & _c_pill & "'/>" )
			        & IF ( _d = _dc && NOT _auj, "<circle cx='" & FORMAT ( _x, "0.0", "en-US" ) & "' cy='" & FORMAT ( _y - 5.5, "0.0", "en-US" ) & "' r='" & IF ( _nl > 5, 13, 15.5 ) & "' fill='none' stroke='" & _c_ink & "' stroke-width='1.3'/>" )
			        & "<text x='" & FORMAT ( _x, "0.0", "en-US" ) & "' y='" & FORMAT ( _y, "0.0", "en-US" ) & "' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='" & IF ( _auj, _c_pilltext, _c_ink ) & "'>" & [Value] & "</text>"
			        & IF ( _a && NOT _auj, "<circle cx='" & FORMAT ( _x, "0.0", "en-US" ) & "' cy='" & FORMAT ( _y + 7.5, "0.0", "en-US" ) & "' r='2.1' fill='" & _c_ink & "'/>" ), "", [Value], ASC )
			VAR _leg = IF ( NOT ISBLANK ( _dc ), FORMAT ( _dc, "d mmm", "en-US" ) & " · " & MINX ( _cle, FactMilestone[Milestone] ), "No upcoming key milestone this month" )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='343.2' height='269.8' viewBox='0 0 363.5 281' preserveAspectRatio='none'><text x='21.5' y='34' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Milestone calendar</text><text x='22.5' y='60' font-family='Segoe UI, Arial, sans-serif' font-size='17.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & FORMAT ( _m, "mmmm yyyy", "en-US" )
			        & "</text><text x='39.5' y='87.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>M</text><text x='86.7' y='87.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>T</text><text x='133.9' y='87.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>W</text><text x='181.1' y='87.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>T</text><text x='228.3' y='87.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>F</text><text x='275.5' y='87.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>S</text><text x='322.7' y='87.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>S</text>"
			        & _jours
			        & "<circle cx='30' cy='264' r='7.5' fill='" & _c_faint & "'/><text x='46' y='269' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & _leg
			        & "</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 5d7dccfe-4d71-563e-a00a-dac9beb3ffe8
		dataCategory: ImageUrl

	measure 'This week (SVG)' =
			
			VAR _c_line = [Color line]
			VAR _c_avring = [Color avring]
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _c_ink = [Color ink]
			VAR _r = [Reference date]
			VAR _l = _r - WEEKDAY ( _r, 2 ) + 1
			VAR _t = TOPN ( 3, CALCULATETABLE ( FactMeeting, REMOVEFILTERS ( DimProject ), FactMeeting[Date] >= _l, FactMeeting[Date] <= _l + 6 ),
			    FactMeeting[Date], ASC, FactMeeting[Time], ASC )
			VAR _lignes = CONCATENATEX ( _t, VAR _i = RANKX ( _t, FactMeeting[Date] + VALUE ( SUBSTITUTE ( FactMeeting[Time], ":", "" ) ) / 10000, , ASC ) - 1
			    VAR _y = 75 + _i * 65.5
			    VAR _p = LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactMeeting[ProjectKey] )
			    VAR _b1 = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], FactMeeting[Person1] )
			    VAR _b2 = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], FactMeeting[Person2] )
			    VAR _ic = SWITCH ( FactMeeting[Kind], "Coordination", "<g transform='translate(84 _Y_) scale(0.916667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M8 2v4' /><path d='M16 2v4' /><rect width='18' height='18' x='3' y='4' rx='2' /><path d='M3 10h18' /><path d='M8 14h.01' /><path d='M12 14h.01' /><path d='M16 14h.01' /><path d='M8 18h.01' /><path d='M12 18h.01' /><path d='M16 18h.01' /></g>", "Review", "<g transform='translate(84 _Y_) scale(0.916667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z' /><path d='M14 2v4a2 2 0 0 0 2 2h4' /><path d='M10 9H8' /><path d='M16 13H8' /><path d='M16 17H8' /></g>", "Site", "<g transform='translate(84 _Y_) scale(0.916667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2' /><path d='M16 3.128a4 4 0 0 1 0 7.744' /><path d='M22 21v-2a4 4 0 0 0-3-3.87' /><circle cx='9' cy='7' r='4' /></g>" )
			    RETURN "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( 0.15 + _i * 0.12, "0.00", "en-US" ) & "s' dur='0.5s' fill='freeze'/>"
			        & "<rect x='20' y='" & _y & "' width='48.5' height='50' rx='10' fill='" & _c_tile & "'/>"
			        & "<text x='44.25' y='" & ( _y + 22.5 ) & "' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='19' font-weight='600' fill='" & _c_ink & "'>" & FORMAT ( FactMeeting[Date], "dd" ) & "</text>"
			        & "<text x='44.25' y='" & ( _y + 41 ) & "' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='12' fill='" & _c_ink & "'>" & UPPER ( FORMAT ( FactMeeting[Date], "mmm", "en-US" ) ) & "</text>"
			        & SUBSTITUTE ( _ic, "_Y_", _y + 4 )
			        & "<text x='96' y='" & ( _y + 45 ) & "' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' fill='" & _c_muted & "'>" & FactMeeting[Time] & "</text>"
			        & "<text x='135.5' y='" & ( _y + 20 ) & "' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='" & _c_ink & "'>" & FactMeeting[Meeting] & "</text>"
			        & "<text x='135.5' y='" & ( _y + 40 ) & "' font-family='Segoe UI, Arial, sans-serif' font-size='14' fill='" & _c_muted & "'>" & _p & "</text>"
			        & "<clipPath id='m" & _i & "a'><circle cx='312.5' cy='" & ( _y + 24 ) & "' r='19'/></clipPath><circle cx='312.5' cy='" & ( _y + 24 ) & "' r='20.5' fill='" & _c_avring & "'/>"
			        & "<image x='293.5' y='" & ( _y + 5 ) & "' width='38' height='38' clip-path='url(#m" & _i & "a)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64," & _b1 & "'/>"
			        & "<clipPath id='m" & _i & "b'><circle cx='346' cy='" & ( _y + 24 ) & "' r='19'/></clipPath><circle cx='346' cy='" & ( _y + 24 ) & "' r='20.5' fill='" & _c_avring & "'/>"
			        & "<image x='327' y='" & ( _y + 5 ) & "' width='38' height='38' clip-path='url(#m" & _i & "b)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64," & _b2 & "'/>"
			        & IF ( _i < 2, "<rect x='20' y='" & ( _y + 57.5 ) & "' width='345' height='1' fill='" & _c_line & "'/>" ) & "</g>",
			    "", FactMeeting[Date], ASC, FactMeeting[Time], ASC )
			VAR _lib = FORMAT ( _l, "d" ) & "-" & FORMAT ( _l + 6, "d" ) & " " & UPPER ( FORMAT ( _l + 6, "mmm", "en-US" ) )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='363.9' height='269.8' viewBox='0 0 385 280' preserveAspectRatio='none'><text x='21' y='34' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>This week</text><text x='21' y='60' font-family='Segoe UI, Arial, sans-serif' font-size='17.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & _lib
			        & "</text>"
			        & _lignes
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 9a725189-d98f-5584-84f0-f196cffe0a66
		dataCategory: ImageUrl

	measure 'Schedule alerts (SVG)' =
			
			VAR _c_black = [Color black]
			VAR _c_blackrim = [Color blackrim]
			VAR _c_onblack = [Color onblack]
			VAR _c_onblack2 = [Color onblack2]
			VAR _al = TOPN ( 2, CALCULATETABLE ( FactAlert, REMOVEFILTERS ( DimProject ) ), FactAlert[AlertKey], ASC )
			VAR _n = COUNTROWS ( CALCULATETABLE ( FactAlert, REMOVEFILTERS ( DimProject ) ) )
			VAR _items = CONCATENATEX ( _al, VAR _i = RANKX ( _al, FactAlert[AlertKey], , ASC ) - 1 VAR _dy = _i * 101.5
			    VAR _p = LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactAlert[ProjectKey] )
			    VAR _bw = LEN ( FactAlert[Action] ) * 7.8 + 48 VAR _bx = 372 - _bw
			    RETURN "<g transform='translate(0 " & _dy & ")'><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( 0.2 + _i * 0.15, "0.00", "en-US" ) & "s' dur='0.5s' fill='freeze'/>"
			        & "<g transform='translate(23.5 83) scale(1.25)' fill='none' stroke='" & _c_onblack & "' stroke-width='1.4' stroke-linecap='round' stroke-linejoin='round'><path d='M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z' /><line x1='4' x2='4' y1='22' y2='15' /></g>"
			        & "<text x='72' y='97' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='600' fill='" & _c_onblack & "'>" & _p & "</text>"
			        & "<text x='72' y='122' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' fill='" & _c_onblack2 & "'>" & FactAlert[Alert] & "</text>"
			        & "<rect x='" & _bx & "' y='89' width='" & _bw & "' height='36.5' rx='18.25' fill='none' stroke='" & _c_onblack & "' stroke-width='1.4'/>"
			        & "<text x='" & ( _bx + _bw / 2 - 9 ) & "' y='112' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_onblack & "'>" & FactAlert[Action] & "</text>"
			        & "<g transform='translate(" & ( _bx + _bw - 30 ) & " 98) scale(0.75)' fill='none' stroke='" & _c_onblack & "' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><path d='M7 7h10v10'/><path d='M7 17 17 7'/></g>"
			        & IF ( _i = 0, "<rect x='21.5' y='155.5' width='346' height='1' fill='" & _c_onblack & "' fill-opacity='0.18'/>" ) & "</g></g>", "", FactAlert[AlertKey], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='365.8' height='269.8' viewBox='0 0 388.5 279' preserveAspectRatio='none'><rect width='388.5' height='279' rx='18' fill='" & _c_black & "' stroke='" & _c_blackrim & "' stroke-width='1.2'/><text x='20' y='35.5' font-family='Segoe UI, Arial, sans-serif' font-size='24' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.4'>Schedule alerts</text><circle cx='201' cy='29.5' r='15' fill='" & _c_onblack2 & "'/><text x='201' y='35' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='600' fill='" & _c_black & "' text-anchor='middle'>"
			        & _n
			        & "</text>"
			        & _items
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 5efca396-d1e8-5ad7-852a-bf0ea2ecca10
		dataCategory: ImageUrl

	measure 'Next milestone (SVG)' =
			
			VAR _c_black = [Color black]
			VAR _c_blackchip = [Color blackchip]
			VAR _c_blackrim = [Color blackrim]
			VAR _c_blacktrack = [Color blacktrack]
			VAR _c_onblack = [Color onblack]
			VAR _c_onblack2 = [Color onblack2]
			VAR _r = [Reference date]
			VAR _un = HASONEVALUE ( DimProject[ProjectKey] )
			VAR _jp = TOPN ( 1, FILTER ( FactMilestone, FactMilestone[Date] > _r ), FactMilestone[Date], ASC, FactMilestone[MilestoneKey], ASC )
			VAR _jg = TOPN ( 1, CALCULATETABLE ( FactMilestone, REMOVEFILTERS ( DimProject ), FactMilestone[Kind] = "Major", FactMilestone[Date] > _r ),
			    FactMilestone[Date], ASC, FactMilestone[MilestoneKey], ASC )
			VAR _d = IF ( _un, MINX ( _jp, FactMilestone[Date] ), MINX ( _jg, FactMilestone[Date] ) )
			VAR _k = IF ( _un, MINX ( _jp, FactMilestone[ProjectKey] ), MINX ( _jg, FactMilestone[ProjectKey] ) )
			VAR _prev = CALCULATE ( MAX ( FactMilestone[Date] ), REMOVEFILTERS ( DimProject ), FactMilestone[ProjectKey] = _k, FactMilestone[Date] <= _r )
			VAR _deb = COALESCE ( _prev, CALCULATE ( MAX ( DimProject[StartDate] ), REMOVEFILTERS ( DimProject ), DimProject[ProjectKey] = _k ) )
			VAR _pc = DIVIDE ( _r - _deb, _d - _deb )
			VAR _reste = INT ( _d - _r )
			VAR _tit = IF ( _un, MINX ( _jp, FactMilestone[Milestone] ), MINX ( _jg, FactMilestone[Milestone] ) )
			VAR _p = LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], _k )
			VAR _lead = LOOKUPVALUE ( DimProject[LeadKey], DimProject[ProjectKey], _k )
			VAR _nom = LOOKUPVALUE ( DimPerson[Person], DimPerson[PersonKey], _lead )
			VAR _b1 = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], _lead )
			VAR _p2 = CALCULATE ( MAX ( BridgeProjectPerson[PersonKey] ), REMOVEFILTERS ( DimProject ), BridgeProjectPerson[ProjectKey] = _k, BridgeProjectPerson[MemberOrder] = 2 )
			VAR _b2 = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], _p2 )
			VAR _img = "data:image/jpeg;base64," & CONCATENATEX ( FILTER ( 'Render image', 'Render image'[ProjectKey] = _k ), 'Render image'[Chunk], "", 'Render image'[Part], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='329.7' height='415.9' viewBox='0 0 350 427.5' preserveAspectRatio='none'><rect width='350' height='427.5' rx='18' fill='" & _c_black & "' stroke='" & _c_blackrim & "' stroke-width='1.2'/><g transform='translate(22.5 20.5) scale(1.16667)' fill='none' stroke='" & _c_onblack & "' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z' /><line x1='4' x2='4' y1='22' y2='15' /></g><text x='72.5' y='39.5' font-family='Segoe UI, Arial, sans-serif' font-size='22' font-weight='600' fill='" & _c_onblack & "' text-anchor='start'>Next milestone</text><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.1s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 6' to='0 0' begin='0.1s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='19' y='106.5' font-family='Segoe UI, Arial, sans-serif' font-size='56' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-2'>"
			        & FORMAT ( _d, "dd" )
			        & "</text><text x='21' y='130.5' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_onblack & "' text-anchor='start'>"
			        & UPPER ( FORMAT ( _d, "mmm yyyy", "en-US" ) )
			        & "</text><rect x='111.5' y='65.5' width='1' height='65' fill='" & _c_onblack & "' fill-opacity='0.22'/><text x='133.5' y='91.5' font-family='Segoe UI, Arial, sans-serif' font-size='21' font-weight='500' fill='" & _c_onblack & "' text-anchor='start'>"
			        & _tit
			        & "</text><text x='133.5' y='115.5' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>"
			        & _p
			        & "</text></g><rect x='21' y='150' width='308.5' height='1' fill='" & _c_onblack & "' fill-opacity='0.22'/><text x='21' y='180.5' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_onblack & "' text-anchor='start'>"
			        & _reste & IF ( _reste = 1, " day remaining", " days remaining" )
			        & "</text><rect x='21' y='197' width='308' height='10' rx='5' fill='" & _c_blacktrack & "'/><rect x='21' y='197' width='0' height='10' rx='5' fill='" & _c_onblack & "'><animate attributeName='width' from='0' to='"
			        & FORMAT ( 308 * MIN ( MAX ( _pc, 0 ), 1 ), "0.0", "en-US" )
			        & "' begin='0.35s' dur='1.1s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect><clipPath id='n1'><circle cx='47.5' cy='258.5' r='26'/></clipPath><circle cx='47.5' cy='258.5' r='27.6' fill='" & _c_blackchip & "'/><image x='21.5' y='232.5' width='52' height='52' clip-path='url(#n1)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64,"
			        & _b1
			        & "'/><clipPath id='n2'><circle cx='105' cy='258.5' r='26'/></clipPath><circle cx='105' cy='258.5' r='27.6' fill='" & _c_blackchip & "'/><image x='79' y='232.5' width='52' height='52' clip-path='url(#n2)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64,"
			        & _b2
			        & "'/><text x='151.5' y='252.5' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_onblack & "' text-anchor='start'>"
			        & _nom
			        & "</text><text x='151.5' y='274.5' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>Project lead</text><clipPath id='im'><rect x='17.5' y='300.5' width='316.5' height='113' rx='12'/></clipPath><image x='17.5' y='300.5' width='316.5' height='113' clip-path='url(#im)' preserveAspectRatio='xMidYMid slice' href='"
			        & _img
			        & "'><animate attributeName='opacity' from='0' to='1' begin='0.3s' dur='0.8s' fill='freeze'/></image></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 856f0325-9d8b-5bd3-81a7-8f8c4e133c8c
		dataCategory: ImageUrl

	measure 'Frame finance (SVG)' =
			
