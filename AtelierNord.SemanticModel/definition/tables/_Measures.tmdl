	measure 'Shown handover' =
			
			VAR _k = [Shown project key]
			RETURN
			    CALCULATE ( MAX ( DimProject[HandoverDate] ), REMOVEFILTERS ( DimProject ), DimProject[ProjectKey] = _k )
		formatString: dd mmm yyyy
		displayFolder: 40 Shown project
		lineageTag: ed17a3f1-1c5f-5529-b25d-7827209b9733

	measure 'Shown area label' =
			
			FORMAT ( [Shown area], "#,0", "en-US" ) & " m²"
		displayFolder: 40 Shown project
		lineageTag: 2a97178d-dd3c-5221-b70d-7cca3f5148cb

	measure 'Shown budget label' =
			
			VAR _v = [Shown budget]
			RETURN IF ( NOT ISBLANK ( _v ), IF ( ABS ( _v ) >= 1000000,
			    "€" & FORMAT ( _v / 1000000, "0.0", "en-US" ) & "M", "€" & FORMAT ( _v / 1000, "0", "en-US" ) & "k" ) )
		displayFolder: 40 Shown project
		lineageTag: 00ab211b-b36d-5e89-bb57-3f042537e076

	measure 'Shown fees label' =
			
			VAR _v = [Shown fees]
			RETURN IF ( NOT ISBLANK ( _v ), IF ( ABS ( _v ) >= 1000000,
			    "€" & FORMAT ( _v / 1000000, "0.0", "en-US" ) & "M", "€" & FORMAT ( _v / 1000, "0", "en-US" ) & "k" ) )
		displayFolder: 40 Shown project
		lineageTag: f022ae98-e612-53a3-bcd5-4cba8d0f14b4

	measure 'Shown hours' =
			
			VAR _k = [Shown project key]
			VAR _r = [Reference date]
			RETURN
			    CALCULATE ( SUM ( FactTimesheet[Hours] ), REMOVEFILTERS ( DimProject ), REMOVEFILTERS ( DimDate ), FactTimesheet[ProjectKey] = _k, FactTimesheet[Date] < _r )
		formatString: #,0
		displayFolder: 40 Shown project
		lineageTag: 5124b873-ea46-54e8-b41c-d8518bf9505b

	measure 'Shown hours label' =
			
			FORMAT ( [Shown hours], "#,0", "en-US" ) & " / " & FORMAT ( [Shown planned hours], "#,0", "en-US" ) & " h"
		displayFolder: 40 Shown project
		lineageTag: 82249bb9-56d0-5678-a60f-efe96ee558ef

	measure 'Shown lead' =
			
			VAR _k = [Shown project key]
			VAR _l = CALCULATE ( MAX ( DimProject[LeadKey] ), REMOVEFILTERS ( DimProject ), DimProject[ProjectKey] = _k )
			RETURN LOOKUPVALUE ( DimPerson[Person], DimPerson[PersonKey], _l )
		displayFolder: 40 Shown project
		lineageTag: a8fa96c2-5884-5faf-9b14-dd662ef7a4e2

	measure 'Shown team size' =
			
			VAR _k = [Shown project key]
			RETURN
			    CALCULATE ( COUNTROWS ( BridgeProjectPerson ), REMOVEFILTERS ( DimProject ), BridgeProjectPerson[ProjectKey] = _k, BridgeProjectPerson[IsStaff] = TRUE () ) + 0
		formatString: 0
		displayFolder: 40 Shown project
		lineageTag: ca357d07-3479-5318-ac6b-fe7259d5aa14

	measure 'Shown next milestone label' =
			
			VAR _k = [Shown project key]
			VAR _r = [Reference date]
			VAR _j = TOPN ( 1, CALCULATETABLE ( FactMilestone, REMOVEFILTERS ( DimProject ), FactMilestone[ProjectKey] = _k, FactMilestone[Date] > _r ), FactMilestone[Date], ASC )
			RETURN IF ( ISEMPTY ( _j ), "None planned", FORMAT ( MAXX ( _j, FactMilestone[Date] ), "dd mmm", "en-US" ) & " · " & MAXX ( _j, FactMilestone[Milestone] ) )
		displayFolder: 40 Shown project
		lineageTag: 3fb3a15d-53c7-5936-ba7e-0297496b2fd7

	measure 'Shown render' =
			
			VAR _k = [Shown project key]
			VAR _b = CONCATENATEX ( FILTER ( 'Render image', 'Render image'[ProjectKey] = _k ), 'Render image'[Chunk], "", 'Render image'[Part], ASC )
			RETURN IF ( NOT ISBLANK ( _b ), "data:image/jpeg;base64," & _b )
		displayFolder: 40 Shown project
		lineageTag: 5fe8ab09-57e5-5285-8ab0-cde6918ffb41

	measure 'Selected timescale' =
			
			SELECTEDVALUE ( Timescale[Timescale], "Month" )
		displayFolder: 50 Gantt
		lineageTag: d077521e-ad42-5f94-b4e4-a2c7b8dc9e6f

	measure 'Window start' =
			
			VAR _r = [Reference date]
			RETURN SWITCH ( [Selected timescale],
			    "Week", _r - WEEKDAY ( _r, 2 ) + 1 - 7, "Quarter", DATE ( YEAR ( _r ), 1, 1 ), "Year", DATE ( YEAR ( _r ) - 1, 1, 1 ),
			    EDATE ( DATE ( YEAR ( _r ), MONTH ( _r ), 1 ), -2 ) )
		formatString: dd mmm yyyy
		displayFolder: 50 Gantt
		lineageTag: ea653e6a-6d38-5e77-a75e-3642c4f1bba2

	measure 'Window end' =
			
			VAR _r = [Reference date]
			RETURN SWITCH ( [Selected timescale],
			    "Week", [Window start] + 41, "Quarter", DATE ( YEAR ( _r ) + 1, 6, 30 ), "Year", DATE ( YEAR ( _r ) + 2, 12, 31 ),
			    EOMONTH ( _r, 2 ) )
		formatString: dd mmm yyyy
		displayFolder: 50 Gantt
		lineageTag: c0823a2b-220b-58d8-8f73-9087b7d21e8f

	measure 'Gantt order overview' =
			
			VAR _o = IF ( HASONEVALUE ( DimProject[ProjectKey] ), MAX ( DimProject[GanttOrder] ) )
			RETURN IF ( _o <= 5, _o )
		formatString: 0
		displayFolder: 50 Gantt
		lineageTag: d1a32459-81a7-5028-b6fd-3b86e903ee77

	measure 'Contracted fees label' =
			
			VAR _v = [Contracted fees]
			RETURN IF ( NOT ISBLANK ( _v ), IF ( ABS ( _v ) >= 1000000,
			    "€" & FORMAT ( _v / 1000000, "0.0", "en-US" ) & "M", "€" & FORMAT ( _v / 1000, "0", "en-US" ) & "k" ) )
		displayFolder: 60 Register
		lineageTag: 99d95269-d410-55ef-a197-8b0560844902

	measure 'Selected chip' =
			
			SELECTEDVALUE ( 'Phase filter'[Chip], "All projects" )
		displayFolder: 60 Register
		lineageTag: 93934e24-cd97-54fd-bb96-1b0b9475106e

	measure 'Visible projects' =
			
			CALCULATE ( COUNTROWS ( DimProject ), ALLSELECTED ( DimProject ), DimProject[Status] <> "Completed" ) + 0
		formatString: 0
		displayFolder: 60 Register
		lineageTag: 7cb24cf8-27e8-519d-ac7f-c7ab20d176f7

	measure 'Register rank' =
			
			VAR _o = MAX ( DimProject[RegisterOrder] )
			VAR _vis = CALCULATETABLE ( VALUES ( DimProject[RegisterOrder] ), ALLSELECTED ( DimProject ), DimProject[Status] <> "Completed" )
			RETURN IF ( HASONEVALUE ( DimProject[ProjectKey] ) && MAX ( DimProject[Status] ) <> "Completed",
			    COUNTROWS ( FILTER ( _vis, DimProject[RegisterOrder] <= _o ) ) )
		formatString: 0
		displayFolder: 60 Register
		lineageTag: 85886168-c125-5a06-a862-17d943d447ad

	measure 'Register order' =
			
			[Register rank]
		formatString: 0
		displayFolder: 60 Register
		lineageTag: aea1aa1c-beb9-56d7-9416-dc012df8ecb8

	measure 'Selected month start' =
			
			SELECTEDVALUE ( 'Month nav'[MonthStart], DATE ( YEAR ( [Reference date] ), MONTH ( [Reference date] ), 1 ) )
		formatString: dd mmm yyyy
		displayFolder: 70 Planning
		lineageTag: 02f7a379-0186-5279-b30e-d2f8ce77fa63

	measure 'Planning window start' =
			
			VAR _m = [Selected month start]
			RETURN IF ( [Selected timescale] IN { "Week", "Month" }, _m + MOD ( 8 - WEEKDAY ( _m, 2 ), 7 ), _m )
		formatString: dd mmm yyyy
		displayFolder: 70 Planning
		lineageTag: 510637a6-1ff3-503e-96d1-3aa2055fd9e8

	measure 'Planning window end' =
			
			VAR _ws = [Planning window start]
			VAR _m = [Selected month start]
			RETURN SWITCH ( [Selected timescale], "Week", _ws + 27, "Month", _ws + 90, "Quarter", EOMONTH ( _m, 5 ), EOMONTH ( _m, 11 ) )
		formatString: dd mmm yyyy
		displayFolder: 70 Planning
		lineageTag: 4c541cb2-8cb1-58da-9dbb-7404c1e4e4f2

	measure 'Planning window label' =
			
			VAR _m = [Selected month start]
			VAR _ws = [Planning window start]
			VAR _we = [Planning window end]
			RETURN SWITCH ( [Selected timescale],
			    "Week", "Weeks of " & FORMAT ( _ws, "d mmmm", "en-US" ) & " to " & FORMAT ( _we - 6, "d mmmm yyyy", "en-US" ),
			    "Month", FORMAT ( _m, "mmmm", "en-US" ) & " to " & FORMAT ( EDATE ( _m, 2 ), "mmmm yyyy", "en-US" ),
			    "Quarter", FORMAT ( _m, "mmmm yyyy", "en-US" ) & " to " & FORMAT ( EDATE ( _m, 5 ), "mmmm yyyy", "en-US" ),
			    FORMAT ( _m, "mmmm yyyy", "en-US" ) & " to " & FORMAT ( EDATE ( _m, 11 ), "mmmm yyyy", "en-US" ) )
		displayFolder: 70 Planning
		lineageTag: 95332395-d76e-580b-b2a9-d6c0546c8885

	measure 'Milestones this month' =
			
			VAR _m = [Selected month start]
			RETURN
			    CALCULATE ( COUNTROWS ( FactMilestone ), REMOVEFILTERS ( DimProject ), FactMilestone[Date] >= _m, FactMilestone[Date] <= EOMONTH ( _m, 0 ) ) + 0
		formatString: 0
		displayFolder: 70 Planning
		lineageTag: b6d5d770-72c7-5319-b602-9d0cf1eb2512

	measure 'Schedule alerts' =
			
			CALCULATE ( COUNTROWS ( FactAlert ), REMOVEFILTERS ( DimProject ) ) + 0
		formatString: 0
		displayFolder: 70 Planning
		lineageTag: 21449505-1b2a-5ec4-a365-7747ee87dc1e

	measure 'Meetings this week' =
			
			VAR _r = [Reference date]
			VAR _l = _r - WEEKDAY ( _r, 2 ) + 1
			RETURN
			    CALCULATE ( COUNTROWS ( FactMeeting ), REMOVEFILTERS ( DimProject ), FactMeeting[Date] >= _l, FactMeeting[Date] <= _l + 6 ) + 0
		formatString: 0
		displayFolder: 70 Planning
		lineageTag: 98774eed-265f-51c7-b829-63e21187bdbf

	measure 'Gantt order planning' =
			
			VAR _o = IF ( HASONEVALUE ( DimProject[ProjectKey] ), MAX ( DimProject[GanttOrder] ) )
			RETURN IF ( _o <= 6, _o )
		formatString: 0
		displayFolder: 70 Planning
		lineageTag: baf892cb-b3fc-5ae4-9955-8a9bfcf36731

	measure 'Finance period' =
			
			SELECTEDVALUE ( 'Finance period'[Period], "Year" )
		displayFolder: 65 Finance
		lineageTag: 6f021b67-9d79-5510-923b-3257bc1c1d19

	measure 'Fin end' =
			
			[Closing date]
		formatString: dd mmm yyyy
		displayFolder: 65 Finance
		lineageTag: f70c89db-b3ee-5800-b640-e1b9207fe9e7

	measure 'Fin start' =
			
			VAR _f = [Closing date]
			RETURN SWITCH ( [Finance period],
			    "Month", DATE ( YEAR ( _f ), MONTH ( _f ), 1 ), "Quarter", DATE ( YEAR ( _f ), ( QUARTER ( _f ) - 1 ) * 3 + 1, 1 ), DATE ( YEAR ( _f ), 1, 1 ) )
		formatString: dd mmm yyyy
		displayFolder: 65 Finance
		lineageTag: 496a42f5-6ebb-5bfd-b545-95121fc84182

	measure 'Fin months' =
			
			DATEDIFF ( [Fin start], [Fin end], MONTH ) + 1
		formatString: 0
		displayFolder: 65 Finance
		lineageTag: 81b83991-5472-5505-912b-4d9a3cdb6839

	measure 'Fin period label' =
			
			VAR _a = [Fin start]
			VAR _b = [Fin end]
			RETURN SWITCH ( [Finance period],
			    "Month", FORMAT ( _b, "mmmm yyyy", "en-US" ), FORMAT ( _a, "mmm", "en-US" ) & " to " & FORMAT ( _b, "mmm yyyy", "en-US" ) )
		displayFolder: 65 Finance
		lineageTag: cb8b96f6-8b98-5157-a369-2e1228282ed4

	measure 'Fin previous label' =
			
			VAR _b = EDATE ( [Fin end], -12 )
			RETURN SWITCH ( [Finance period],
			    "Month", FORMAT ( _b, "mmm yyyy", "en-US" ), "Quarter", "Q" & QUARTER ( _b ) & " " & YEAR ( _b ), FORMAT ( YEAR ( _b ), "0" ) )
		displayFolder: 65 Finance
		lineageTag: 773dbfb5-fa21-5656-afe4-1adaa4f7f2b6

	measure 'Fin fees' =
			
			VAR _d1 = [Fin start]
			VAR _d2 = [Fin end]
			RETURN
			    CALCULATE ( SUM ( FactInvoice[Amount] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) )
		formatString: #,0
		displayFolder: 65 Finance
		lineageTag: f8b8d351-c2b7-5534-ad06-000f42924b5a

	measure 'Fin fees PY' =
			
			VAR _d1 = EDATE ( [Fin start], -12 )
			VAR _d2 = EDATE ( [Fin end], -12 )
			RETURN
			    CALCULATE ( SUM ( FactInvoice[Amount] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) )
		formatString: #,0
		displayFolder: 65 Finance
		lineageTag: e5fd4af9-1264-54a7-8841-e77067d6eb00

	measure 'Fin costs' =
			
			VAR _d1 = [Fin start]
			VAR _d2 = [Fin end]
			RETURN
			    CALCULATE ( SUM ( FactCost[Amount] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) )
		formatString: #,0
		displayFolder: 65 Finance
		lineageTag: 03edd5b4-954c-5010-a481-f9b11125290b

	measure 'Fin costs PY' =
			
			VAR _d1 = EDATE ( [Fin start], -12 )
			VAR _d2 = EDATE ( [Fin end], -12 )
			RETURN
			    CALCULATE ( SUM ( FactCost[Amount] ), DATESBETWEEN ( DimDate[Date], _d1, _d2 ) )
		formatString: #,0
		displayFolder: 65 Finance
		lineageTag: 5ddadb90-0bd0-5e34-b49a-27807649709e

	measure 'Fin profit' =
			
			[Fin fees] - [Fin costs]
		formatString: #,0
		displayFolder: 65 Finance
		lineageTag: 8749b6b3-e7a0-57d3-9b2b-a77b8f115549

	measure 'Fin margin' =
			
			DIVIDE ( [Fin profit], [Fin fees] )
		formatString: 0.0%
		displayFolder: 65 Finance
		lineageTag: f8e68109-018d-5106-9ebf-d34fee7a260b

	measure 'Fin margin PY' =
			
			DIVIDE ( [Fin fees PY] - [Fin costs PY], [Fin fees PY] )
		formatString: 0.0%
		displayFolder: 65 Finance
		lineageTag: 1ea3f471-04c0-5d86-a6f6-5099f1ba20fb

	measure 'Fin avg monthly fees' =
			
			DIVIDE ( [Fin fees], [Fin months] )
		formatString: #,0
		displayFolder: 65 Finance
		lineageTag: 4880205b-b56b-5fc9-9d79-87bc658a5396

	measure 'Fin fees change label' =
			
			FORMAT ( DIVIDE ( [Fin fees], [Fin fees PY] ) - 1, "+0.0%;-0.0%", "en-US" ) & " vs " & [Fin previous label]
		displayFolder: 65 Finance
		lineageTag: 0518405a-6594-59d0-8a62-bf084ac539ce

	measure 'Fin margin change label' =
			
			FORMAT ( ( [Fin margin] - [Fin margin PY] ) * 100, "+0.0;-0.0", "en-US" ) & " pts vs " & [Fin previous label]
		displayFolder: 65 Finance
		lineageTag: 41577eb0-566c-5261-89dc-cddff273ca7c

	measure Outstanding =
			
			VAR _r = [Reference date]
			RETURN CALCULATE ( SUM ( FactInvoice[Amount] ), REMOVEFILTERS ( DimDate ),
			    FactInvoice[IssueDate] <= _r, ISBLANK ( FactInvoice[PaidDate] ) || FactInvoice[PaidDate] > _r ) + 0
		formatString: #,0
		displayFolder: 65 Finance
		lineageTag: ed11d549-b0cc-5c5c-9896-2479b9461aa3

	measure Overdue =
			
			VAR _r = [Reference date]
			RETURN CALCULATE ( SUM ( FactInvoice[Amount] ), REMOVEFILTERS ( DimDate ),
			    FactInvoice[IssueDate] <= _r, ISBLANK ( FactInvoice[PaidDate] ) || FactInvoice[PaidDate] > _r, FactInvoice[DueDate] < _r ) + 0
		formatString: #,0
		displayFolder: 65 Finance
		lineageTag: 21772847-c6e9-57ca-b764-74e04239e1bb

	measure 'Outstanding count' =
			
			VAR _r = [Reference date]
			RETURN CALCULATE ( COUNTROWS ( FactInvoice ), REMOVEFILTERS ( DimDate ),
			    FactInvoice[IssueDate] <= _r, ISBLANK ( FactInvoice[PaidDate] ) || FactInvoice[PaidDate] > _r ) + 0
		formatString: 0
		displayFolder: 65 Finance
		lineageTag: fc8953c1-d359-586a-af60-545f791b6937

	measure 'Overdue label' =
			
			"€" & FORMAT ( [Overdue] / 1000, "0", "en-US" ) & "k overdue"
		displayFolder: 65 Finance
		lineageTag: 5a10d4f1-93e2-52d8-8636-6780efb03529

	measure 'Invoice order' =
			
			VAR _r = [Reference date]
			VAR _ok = HASONEVALUE ( FactInvoice[Invoice] ) && MAX ( FactInvoice[IssueDate] ) <= _r
			    && ( ISBLANK ( MAX ( FactInvoice[PaidDate] ) ) || MAX ( FactInvoice[PaidDate] ) > _r )
			VAR _due = MAX ( FactInvoice[DueDate] ) VAR _no = MAX ( FactInvoice[Invoice] )
			VAR _np = CALCULATETABLE ( FactInvoice, ALLSELECTED ( FactInvoice ), REMOVEFILTERS ( DimDate ), FactInvoice[IssueDate] <= _r,
			    ISBLANK ( FactInvoice[PaidDate] ) || FactInvoice[PaidDate] > _r )
			RETURN IF ( _ok, COUNTROWS ( FILTER ( _np, FactInvoice[DueDate] < _due || ( FactInvoice[DueDate] = _due && FactInvoice[Invoice] <= _no ) ) ) )
		formatString: 0
		displayFolder: 65 Finance
		lineageTag: 2a64c72c-3300-5f31-a5bc-9c0d70c387fa

	measure 'Profitability order' =
			
			[Register rank]
		formatString: 0
		displayFolder: 65 Finance
		lineageTag: 0d646c62-1a5c-53d7-a8dd-16f106b51986

