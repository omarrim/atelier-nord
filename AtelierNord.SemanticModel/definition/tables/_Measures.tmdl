			        & "logged of " & FORMAT ( _htot, "#,0", "en-US" ) & " h planned"
			        & "</text><circle cx='66' cy='580' r='4.5' fill='" & _c_bdesign & "'/><text x='76' y='584' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>Planned</text><circle cx='146' cy='580' r='4.5' fill='" & _c_onblack & "'/><text x='156' y='584' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>Logged</text><rect x='220' y='575' width='10' height='10' rx='2' fill='" & _c_onblack & "' fill-opacity='0.3'/><text x='236' y='584' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>Over plan</text>"
			        & _hgr
			        & _hannees
			        & "<defs><clipPath id='au'><polygon points='"
			        & _hau
			        & "'/></clipPath></defs><polyline points='"
			        & _hlp
			        & "' fill='none' stroke='" & _c_bdesign & "' stroke-width='2' stroke-dasharray='1' pathLength='1' stroke-dashoffset='1' stroke-linejoin='round'><animate attributeName='stroke-dashoffset' from='1' to='0' begin='0.6s' dur='1.2s' fill='freeze'/></polyline><polygon points='"
			        & _haire
			        & "' fill='" & _c_onblack & "' fill-opacity='0' clip-path='url(#au)'><animate attributeName='fill-opacity' from='0' to='0.3' begin='2s' dur='0.6s' fill='freeze'/></polygon><polyline points='"
			        & _hla
			        & "' fill='none' stroke='" & _c_onblack & "' stroke-width='2.6' stroke-dasharray='1' pathLength='1' stroke-dashoffset='1' stroke-linejoin='round'><animate attributeName='stroke-dashoffset' from='1' to='0' begin='0.9s' dur='1.1s' fill='freeze'/></polyline><circle cx='"
			        & FORMAT ( _hxt, "0.0", "en-US" )
			        & "' cy='"
			        & FORMAT ( _hyt, "0.0", "en-US" )
			        & "' r='0' fill='" & _c_onblack & "'><animate attributeName='r' from='0' to='4.6' begin='2s' dur='0.3s' fill='freeze'/></circle><line x1='"
			        & FORMAT ( _hxt, "0.0", "en-US" )
			        & "' y1='606' x2='"
			        & FORMAT ( _hxt, "0.0", "en-US" )
			        & "' y2='746' stroke='" & _c_onblack & "' stroke-width='1.1' stroke-dasharray='3 4'/>"
			        & _hsegs
			        & "<text x='"
			        & FORMAT ( IF ( _hxt > 509, _hxt - 8, _hxt + 8 ), "0.0", "en-US" )
			        & "' y='"
			        & FORMAT ( _hyt - 9, "0.0", "en-US" )
			        & "' text-anchor='"
			        & IF ( _hxt > 509, "end", "start" )
			        & "' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='600' fill='" & _c_onblack & "' stroke='" & _c_black & "' stroke-width='4' paint-order='stroke'>"
			        & IF ( _hecart >= 0, "+", "" ) & FORMAT ( _hecart, "0%", "en-US" ) & " vs plan"
			        & "</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 39e58244-b5a4-5327-a25b-9dce9326f2d3
