			        & "<circle cx='1376.5' cy='93' r='26' fill='" & _c_chip & "' fill-opacity='" & _c_chipop & "' filter='url(#s)'/><circle cx='1368.5' cy='93' r='2.4' fill='" & _c_ink & "'/><circle cx='1376.5' cy='93' r='2.4' fill='" & _c_ink & "'/><circle cx='1384.5' cy='93' r='2.4' fill='" & _c_ink & "'/><circle cx='1376.5' cy='161.5' r='23' fill='" & _c_pill & "' filter='url(#s)'/><g transform='translate(1365.5 150.5) scale(0.916667)' fill='none' stroke='" & _c_pilltext & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14' /><path d='M12 5v14' /></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: fcad69ce-d28f-5148-909f-9fb1b452c85e
		dataCategory: ImageUrl

	measure 'KPI band projects (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _k0 = [Active projects]
			VAR _k1 = [Contracted fees]
			VAR _k2 = [Overall completion]
			VAR _k3 = [Projects at risk]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1111.8' height='98.2' viewBox='0 0 1156.5 107' preserveAspectRatio='none'><rect x='269.5' y='22' width='1' height='65.5' fill='" & _c_line & "'/><rect x='562.5' y='22' width='1' height='65.5' fill='" & _c_line & "'/><rect x='849' y='22' width='1' height='65.5' fill='" & _c_line & "'/>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k0 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='31' y='56' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( ROUND ( _v, 0 ), "#,0", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.15 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.15 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.15 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.25s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.25s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='31' y='82.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Active projects</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k1 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='327' y='56' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & IF ( ABS ( _k1 ) >= 1000000, "€" & FORMAT ( _v / 1000000, "0.0", "en-US" ) & "M", "€" & FORMAT ( _v / 1000, "0", "en-US" ) & "k" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.25 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.25 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.25 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.35s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.35s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='327' y='82.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Contracted fees</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k2 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='617.5' y='56' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( _v, "0.0%", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.35 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.35 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.35 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.45s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.45s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='617.5' y='82.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Overall completion</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k3 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='903.5' y='56' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( ROUND ( _v, 0 ), "#,0", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.45000000000000007 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.45000000000000007 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.45000000000000007 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.55s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.55s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='903.5' y='82.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Need attention</text></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 02ff2e64-66a9-5868-90b9-c8acca0d3c8f
		dataCategory: ImageUrl

	measure 'Phase chips (SVG)' =
			
			VAR _c_muted = [Color muted]
			VAR _c_faint = [Color faint]
			VAR _c_ink = [Color ink]
			VAR _c_pilltext = [Color pilltext]
			VAR _c_cardop = [Color cardop]
			VAR _c_card = [Color card]
			VAR _c_pill = [Color pill]
			VAR _c_rim = [Color rim]
			VAR _c_rimop = [Color rimop]
			VAR _sel = [Selected chip]
			VAR _n0 = CALCULATE ( COUNTROWS ( DimProject ), REMOVEFILTERS ( 'Phase filter' ), REMOVEFILTERS ( DimProject ), DimProject[Status] <> "Completed" ) + 0
			VAR _n1 = CALCULATE ( COUNTROWS ( DimProject ), REMOVEFILTERS ( 'Phase filter' ), REMOVEFILTERS ( DimProject ), DimProject[Status] <> "Completed", DimProject[Phase] = "Design" ) + 0
			VAR _n2 = CALCULATE ( COUNTROWS ( DimProject ), REMOVEFILTERS ( 'Phase filter' ), REMOVEFILTERS ( DimProject ), DimProject[Status] <> "Completed", DimProject[Phase] = "Permit" ) + 0
			VAR _n3 = CALCULATE ( COUNTROWS ( DimProject ), REMOVEFILTERS ( 'Phase filter' ), REMOVEFILTERS ( DimProject ), DimProject[Status] <> "Completed", DimProject[Phase] = "Construction" ) + 0
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='527.1' height='34.3' viewBox='0 0 530 34.5' preserveAspectRatio='none'><rect x='0' y='0.75' width='142' height='33' rx='16.5' fill='"
			        & IF ( _sel = "All projects", _c_pill, _c_card )
			        & "' fill-opacity='"
			        & IF ( _sel = "All projects", "1", _c_cardop )
			        & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "'/><text x='25.5' y='21.5' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='"
			        & IF ( _sel = "All projects", "600", "400" )
			        & "' fill='"
			        & IF ( _sel = "All projects", _c_pilltext, _c_ink )
			        & "'>All projects<tspan dx='12' font-size='13.5' font-weight='400' fill='"
			        & IF ( _sel = "All projects", _c_faint, _c_muted )
			        & "'>"
			        & _n0
			        & "</tspan></text><rect x='151' y='0.75' width='108.5' height='33' rx='16.5' fill='"
			        & IF ( _sel = "Design", _c_pill, _c_card )
			        & "' fill-opacity='"
			        & IF ( _sel = "Design", "1", _c_cardop )
			        & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "'/><text x='176.5' y='21.5' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='"
			        & IF ( _sel = "Design", "600", "400" )
			        & "' fill='"
			        & IF ( _sel = "Design", _c_pilltext, _c_ink )
			        & "'>Design<tspan dx='12' font-size='13.5' font-weight='400' fill='"
			        & IF ( _sel = "Design", _c_faint, _c_muted )
			        & "'>"
			        & _n1
			        & "</tspan></text><rect x='268.5' y='0.75' width='110' height='33' rx='16.5' fill='"
			        & IF ( _sel = "Permit", _c_pill, _c_card )
			        & "' fill-opacity='"
			        & IF ( _sel = "Permit", "1", _c_cardop )
			        & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "'/><text x='294' y='21.5' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='"
			        & IF ( _sel = "Permit", "600", "400" )
			        & "' fill='"
			        & IF ( _sel = "Permit", _c_pilltext, _c_ink )
			        & "'>Permit<tspan dx='12' font-size='13.5' font-weight='400' fill='"
			        & IF ( _sel = "Permit", _c_faint, _c_muted )
			        & "'>"
			        & _n2
			        & "</tspan></text><rect x='386.5' y='0.75' width='143.5' height='33' rx='16.5' fill='"
			        & IF ( _sel = "Construction", _c_pill, _c_card )
			        & "' fill-opacity='"
			        & IF ( _sel = "Construction", "1", _c_cardop )
			        & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "'/><text x='412' y='21.5' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='"
			        & IF ( _sel = "Construction", "600", "400" )
			        & "' fill='"
			        & IF ( _sel = "Construction", _c_pilltext, _c_ink )
			        & "'>Construction<tspan dx='12' font-size='13.5' font-weight='400' fill='"
			        & IF ( _sel = "Construction", _c_faint, _c_muted )
			        & "'>"
			        & _n3
			        & "</tspan></text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 3f719692-8e61-5b7a-b370-61005ed7b092
		dataCategory: ImageUrl

