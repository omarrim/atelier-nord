			VAR _k = [Shown project key]
			RETURN
			    CALCULATE ( MAX ( DimProject[ContractFees] ), REMOVEFILTERS ( DimProject ), DimProject[ProjectKey] = _k )
		formatString: #,0
		displayFolder: 40 Shown project
		lineageTag: 56405c3a-7fa8-5cd7-8f38-3d562d774962

	measure 'Shown planned hours' =
			
			VAR _k = [Shown project key]
			RETURN
			    CALCULATE ( MAX ( DimProject[PlannedHours] ), REMOVEFILTERS ( DimProject ), DimProject[ProjectKey] = _k )
