	measure 'NM phase end' =
			
			VAR _k = [NM key]
			VAR _r = [Reference date]
			RETURN
			    CALCULATE ( MIN ( FactProjectPhase[End] ), REMOVEFILTERS ( DimProject ), FactProjectPhase[ProjectKey] = _k, FactProjectPhase[End] > _r )
