	measure 'Grid tile (SVG)' =
			
			VAR _c_card = [Color card]
			VAR _c_cardop = [Color cardop]
			VAR _c_ink = [Color ink]
			VAR _c_ink2 = [Color ink2]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_pill = [Color pill]
			VAR _c_pilltext = [Color pilltext]
			VAR _c_track = [Color track]
			VAR _k = SELECTEDVALUE ( DimProject[ProjectKey] )
			VAR _ph = SELECTEDVALUE ( DimProject[Phase] )
			VAR _p = SELECTEDVALUE ( DimProject[PhaseProgress] )
			VAR _risque = SELECTEDVALUE ( DimProject[Status] ) = "At risk"
			VAR _th = LOOKUPVALUE ( 'Thumb image'[Chunk], 'Thumb image'[ProjectKey], _k )
			VAR _sous = SELECTEDVALUE ( DimProject[Type] ) & " · " & FORMAT ( SELECTEDVALUE ( DimProject[AreaM2] ), "#,0", "en-US" ) & " m²"
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='172' height='238' viewBox='0 0 172 238' preserveAspectRatio='none'><rect x='0.6' y='0.6' width='170.8' height='236.8' rx='14' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_line & "' stroke-width='1.2'/><g opacity='0'><animate attributeName='opacity' from='0' to='1' dur='0.5s' fill='freeze'/><clipPath id='v'><rect x='8' y='8' width='156' height='112' rx='10'/></clipPath><image x='8' y='8' width='156' height='112' clip-path='url(#v)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64,"
			        & _th
			        & "'/>"
			        & IF ( _risque, "<rect x='16' y='16' width='58' height='22' rx='11' fill='" & _c_pill & "'/><text x='45' y='31' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' font-weight='600' fill='" & _c_pilltext & "'>At risk</text>" )
			        & "<text x='12' y='143' font-family='Segoe UI, Arial, sans-serif' font-size='14' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & SELECTEDVALUE ( DimProject[Project] )
			        & "</text><text x='12' y='161' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & _sous
			        & "</text><text x='12' y='195' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_ink2 & "' text-anchor='start'>"
			        & _ph
			        & "</text><text x='160' y='195' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='600' fill='" & _c_ink & "' text-anchor='end'>"
			        & FORMAT ( _p, "0%", "en-US" )
			        & "</text><rect x='12' y='205' width='148' height='6' rx='3' fill='" & _c_track & "'/><rect x='12' y='205' width='0' height='6' rx='3' fill='" & _c_ink & "'><animate attributeName='width' from='0' to='"
			        & FORMAT ( 148 * _p, "0.0", "en-US" )
			        & "' begin='0.2s' dur='0.9s' fill='freeze'/></rect></g></svg>"
			RETURN IF ( NOT ISBLANK ( _k ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" ) )
		displayFolder: 90 SVG
		lineageTag: 3784f571-c669-5aba-83a9-f5b928dc3cb0
		dataCategory: ImageUrl

	measure 'Register row (SVG)' =
			
			VAR _c_pilltext = [Color pilltext]
			VAR _c_faint = [Color faint]
			VAR _c_chip = [Color chip]
			VAR _c_pill = [Color pill]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_track = [Color track]
			VAR _o = [Register order]
			VAR _k = SELECTEDVALUE ( DimProject[ProjectKey] )
			VAR _nom = SELECTEDVALUE ( DimProject[Project] )
			VAR _sous = SELECTEDVALUE ( DimProject[Type] ) & " · " & FORMAT ( SELECTEDVALUE ( DimProject[AreaM2] ), "#,0", "en-US" ) & " m²"
			VAR _ph = SELECTEDVALUE ( DimProject[Phase] )
			VAR _p = SELECTEDVALUE ( DimProject[PhaseProgress] )
			VAR _st = SELECTEDVALUE ( DimProject[Status] )
			VAR _risque = _st = "At risk"
			VAR _th = LOOKUPVALUE ( 'Thumb image'[Chunk], 'Thumb image'[ProjectKey], _k )
			VAR _d = 0.08 + 0.04 * ( _o - 1 )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='687' height='38' viewBox='0 0 687 38' preserveAspectRatio='none'><rect x='12.5' y='37' width='674.5' height='1' fill='" & _c_line & "'/><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='"
			        & FORMAT ( _d, "0.00", "en-US" )
			        & "s' dur='0.45s' fill='freeze'/><clipPath id='v'><rect x='12.5' y='4' width='51.7' height='30' rx='5'/></clipPath><image x='12.5' y='4' width='51.7' height='30' clip-path='url(#v)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64,"
			        & _th
			        & "'/><text x='76.7' y='17' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & _nom
			        & "</text><text x='76.7' y='31.5' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & _sous
			        & "</text><text x='260.6' y='23.5' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & _ph
			        & "</text><rect x='372.7' y='15' width='102.0' height='8' rx='4' fill='" & _c_track & "'/><rect x='372.7' y='15' width='0' height='8' rx='4' fill='" & _c_ink & "'><animate attributeName='width' from='0' to='"
			        & FORMAT ( 102.0 * _p, "0.0", "en-US" )
			        & "' begin='"
			        & FORMAT ( _d + 0.15, "0.00", "en-US" )
			        & "s' dur='0.9s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect><text x='486.7' y='23.5' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & FORMAT ( _p, "0%", "en-US" )
			        & "</text><rect x='544.7' y='7' width='82.9' height='24' rx='12' fill='"
			        & IF ( _risque, _c_pill, _c_chip )
			        & "' fill-opacity='"
			        & IF ( _risque, "1", "0.6" )
			        & "' stroke='"
			        & IF ( _risque, _c_pill, _c_faint )
			        & "' stroke-width='1.2'/><text x='586.2' y='23.5' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' fill='"
			        & IF ( _risque, _c_pilltext, _c_ink )
			        & "'>"
			        & _st
			        & "</text></g></svg>"
			RETURN IF ( NOT ISBLANK ( _o ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" ) )
		displayFolder: 90 SVG
		lineageTag: 41074500-7524-5518-9e90-23af8279f9c4
		dataCategory: ImageUrl

	measure 'Register rail (SVG)' =
			
			VAR _c_pill = [Color pill]
			VAR _c_tile = [Color tile]
			VAR _k = [Shown project key]
			VAR _ord = CALCULATE ( MAX ( DimProject[RegisterOrder] ), REMOVEFILTERS ( DimProject ), DimProject[ProjectKey] = _k )
			VAR _vis = CALCULATETABLE ( DimProject, REMOVEFILTERS ( DimProject ), DimProject[Status] <> "Completed" )
			VAR _pos = COUNTROWS ( FILTER ( _vis, DimProject[RegisterOrder] <= _ord ) )
			VAR _y = 24 + ( _pos - 1 ) * 38
			VAR _ok = NOT ISBLANK ( _k ) && _pos >= 1 && _pos <= 12 && NOT ISEMPTY ( FILTER ( _vis, DimProject[ProjectKey] = _k ) )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='715' height='484' viewBox='0 0 715 484' preserveAspectRatio='none'>"
			        & IF ( _ok, "<rect x='12' y='" & FORMAT ( _y + 0.5, "0.0", "en-US" ) & "' width='683' height='36' rx='6' fill='" & _c_tile & "'/><rect x='7.5' y='" & FORMAT ( _y + 0.5, "0.0", "en-US" ) & "' width='3.4' height='36' rx='1.7' fill='" & _c_pill & "'/>" )
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: ea8f6fb7-ee7c-50b0-b885-31cdc177cc77
		dataCategory: ImageUrl

	measure 'Selected project (SVG)' =
			
			VAR _c_black = [Color black]
			VAR _c_blackrim = [Color blackrim]
			VAR _c_blacktrack = [Color blacktrack]
			VAR _c_onblack = [Color onblack]
			VAR _c_onblack2 = [Color onblack2]
			VAR _img = [Shown render]
			VAR _p = [Shown progress]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='375.9' height='452.9' viewBox='0 0 396.5 464' preserveAspectRatio='none'><clipPath id='c'><rect width='396.5' height='464' rx='18'/></clipPath><g clip-path='url(#c)'><rect width='396.5' height='464' fill='" & _c_black & "'/><image x='0' y='0' width='396.5' height='272' preserveAspectRatio='xMidYMid slice' href='"
			        & _img
			        & "'><animate attributeName='opacity' from='0' to='1' dur='0.7s' fill='freeze'/></image><defs><linearGradient id='h' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='" & _c_black & "' stop-opacity='0.78'/><stop offset='1' stop-color='" & _c_black & "' stop-opacity='0'/></linearGradient><linearGradient id='v' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='" & _c_black & "' stop-opacity='0'/><stop offset='1' stop-color='" & _c_black & "' stop-opacity='1'/></linearGradient></defs><rect width='396.5' height='100' fill='url(#h)'/><rect y='150' width='396.5' height='124' fill='url(#v)'/><rect y='272' width='396.5' height='192' fill='" & _c_black & "'/></g><rect x='0.6' y='0.6' width='395.3' height='462.8' rx='18' fill='none' stroke='" & _c_blackrim & "' stroke-width='1.2'/><text x='19' y='38.5' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.4'>Selected project</text><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.15s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 6' to='0 0' begin='0.15s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='19.5' y='294' font-family='Segoe UI, Arial, sans-serif' font-size='30' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.6'>"
			        & [Shown project]
			        & "</text><text x='19.5' y='319' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>"
			        & [Shown type label] & "  ·  " & [Shown area label]
			        & "</text><text x='19.5' y='367.5' font-family='Segoe UI, Arial, sans-serif' font-size='34' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.8'>"
			        & [Shown budget label]
			        & "</text><text x='19.5' y='390' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>Construction budget</text><rect x='197.5' y='346.5' width='1' height='46' fill='" & _c_onblack & "' fill-opacity='0.2'/><text x='229' y='367.5' font-family='Segoe UI, Arial, sans-serif' font-size='34' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.8'>"
			        & FORMAT ( _p, "0%", "en-US" )
			        & "</text><text x='229' y='390' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>Complete</text></g><rect x='19.5' y='416.5' width='207' height='10' rx='5' fill='" & _c_blacktrack & "'/><rect x='19.5' y='416.5' width='0' height='10' rx='5' fill='" & _c_onblack & "'><animate attributeName='width' from='0' to='"
			        & FORMAT ( 207 * _p, "0.0", "en-US" )
			        & "' begin='0.4s' dur='1.1s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect><rect x='246.5' y='410.5' width='134' height='39' rx='19.5' fill='none' stroke='" & _c_onblack & "' stroke-width='1.5'/><text x='300' y='435.5' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_onblack & "' text-anchor='middle'>Open project</text><g transform='translate(352 421) scale(0.75)' fill='none' stroke='" & _c_onblack & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M7 7h10v10' /><path d='M7 17 17 7' /></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: d5d7c30e-3361-59e6-a9c6-fc40eae3f8f5
		dataCategory: ImageUrl

	measure 'Project details card (SVG)' =
			
			VAR _c_avring = [Color avring]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _k = [Shown project key]
			VAR _r = [Reference date]
			VAR _lead = CALCULATE ( MAX ( DimProject[LeadKey] ), REMOVEFILTERS ( DimProject ), DimProject[ProjectKey] = _k )
			VAR _lb = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], _lead )
			VAR _j = TOPN ( 1, CALCULATETABLE ( FactMilestone, REMOVEFILTERS ( DimProject ), FactMilestone[ProjectKey] = _k, FactMilestone[Date] > _r ), FactMilestone[Date], ASC )
			VAR _jd = MAXX ( _j, FactMilestone[Date] )
			VAR _act = CALCULATE ( [Open tasks], REMOVEFILTERS ( DimProject ), FactTask[ProjectKey] = _k )
			VAR _eq = CALCULATETABLE ( BridgeProjectPerson, REMOVEFILTERS ( DimProject ), BridgeProjectPerson[ProjectKey] = _k, BridgeProjectPerson[IsStaff] = TRUE () )
			VAR _n = COUNTROWS ( _eq )
			VAR _av = TOPN ( 3, _eq, BridgeProjectPerson[MemberOrder], ASC )
			VAR _avs = CONCATENATEX ( _av, VAR _i = RANKX ( _av, BridgeProjectPerson[MemberOrder], , ASC ) VAR _cx = 46 + ( _i - 1 ) * 45.75
			    VAR _b = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], BridgeProjectPerson[PersonKey] )
			    RETURN "<clipPath id='e" & _i & "'><circle cx='" & _cx & "' cy='214' r='22'/></clipPath><circle cx='" & _cx & "' cy='214' r='23.6' fill='" & _c_avring & "'/>"
			        & "<image x='" & ( _cx - 22 ) & "' y='192' width='44' height='44' clip-path='url(#e" & _i & ")' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64," & _b & "'/>",
			    "", BridgeProjectPerson[MemberOrder], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='375.9' height='224.2' viewBox='0 0 397.5 247.5' preserveAspectRatio='none'><text x='21' y='30' font-family='Segoe UI, Arial, sans-serif' font-size='24' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Project details</text><rect x='22' y='85' width='353' height='1' fill='" & _c_line & "'/><rect x='22' y='118.5' width='353' height='1' fill='" & _c_line & "'/><rect x='22' y='152.5' width='353' height='1' fill='" & _c_line & "'/><rect x='22' y='186' width='353' height='1' fill='" & _c_line & "'/><text x='22.5' y='66' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Project lead</text><text x='22.5' y='104' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Next milestone</text><text x='22.5' y='138.5' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Handover</text><text x='22.5' y='172.5' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Open actions</text><clipPath id='l'><circle cx='168.5' cy='63.5' r='18'/></clipPath><circle cx='168.5' cy='63.5' r='19.6' fill='" & _c_avring & "'/><image x='150.5' y='45.5' width='36' height='36' clip-path='url(#l)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64,"
			        & _lb
			        & "'/><text x='202.5' y='68' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown lead]
			        & "</text><g transform='translate(157 92) scale(0.916667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M8 2v4' /><path d='M16 2v4' /><rect width='18' height='18' x='3' y='4' rx='2' /><path d='M3 10h18' /><path d='M8 14h.01' /><path d='M12 14h.01' /><path d='M16 14h.01' /><path d='M8 18h.01' /><path d='M12 18h.01' /><path d='M16 18h.01' /></g><g transform='translate(157 126) scale(0.916667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M8 2v4' /><path d='M16 2v4' /><rect width='18' height='18' x='3' y='4' rx='2' /><path d='M3 10h18' /><path d='M8 14h.01' /><path d='M12 14h.01' /><path d='M16 14h.01' /><path d='M8 18h.01' /><path d='M12 18h.01' /><path d='M16 18h.01' /></g><text x='205' y='106' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & IF ( ISBLANK ( _jd ), "None planned", UPPER ( FORMAT ( _jd, "dd mmm yyyy", "en-US" ) ) )
			        & "</text><text x='205' y='140' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & UPPER ( FORMAT ( [Shown handover], "dd mmm yyyy", "en-US" ) )
			        & "</text><g stroke='" & _c_ink & "' stroke-width='1.5' stroke-linecap='round'><circle cx='160' cy='162.5' r='1.4' fill='" & _c_ink & "'/><line x1='165.5' y1='162.5' x2='178' y2='162.5'/><circle cx='160' cy='168.5' r='1.4' fill='" & _c_ink & "'/><line x1='165.5' y1='168.5' x2='178' y2='168.5'/><circle cx='160' cy='174.5' r='1.4' fill='" & _c_ink & "'/><line x1='165.5' y1='174.5' x2='178' y2='174.5'/></g><text x='205' y='174' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>"
			        & _act
			        & "</text>"
			        & _avs
			        & "<circle cx='185.5' cy='214' r='22' fill='" & _c_tile & "'/><text x='185.5' y='220' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>"
			        & "+" & MAX ( _n - 3, 0 )
			        & "</text><text x='235' y='220' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & _n & " team members"
			        & "</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 59711165-b6d6-5a48-9f74-0587daddc192
		dataCategory: ImageUrl

	measure 'Attention (SVG)' =
			
			VAR _c_black = [Color black]
			VAR _c_blackrim = [Color blackrim]
			VAR _c_onblack = [Color onblack]
			VAR _c_onblack2 = [Color onblack2]
			VAR _al = TOPN ( 2, CALCULATETABLE ( FactAlert, REMOVEFILTERS ( DimProject ) ), FactAlert[AlertKey], ASC )
			VAR _items = CONCATENATEX ( _al, VAR _i = RANKX ( _al, FactAlert[AlertKey], , ASC ) - 1 VAR _x = _i * 383
			    VAR _p = LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactAlert[ProjectKey] )
			    RETURN "<g transform='translate(" & _x & " 0)'><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( 0.2 + _i * 0.15, "0.00", "en-US" ) & "s' dur='0.5s' fill='freeze'/>"
			        & "<g transform='translate(25.5 67) scale(1.25)' fill='none' stroke='" & _c_onblack & "' stroke-width='1.4' stroke-linecap='round' stroke-linejoin='round'><path d='M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z' /><line x1='4' x2='4' y1='22' y2='15' /></g>"
			        & "<text x='81.5' y='81' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='600' fill='" & _c_onblack & "'>" & _p & "</text>"
			        & "<text x='81.5' y='105' font-family='Segoe UI, Arial, sans-serif' font-size='15.5' fill='" & _c_onblack2 & "'>" & FactAlert[Alert] & "</text>"
			        & "<g transform='translate(331 78) scale(0.75)' fill='none' stroke='" & _c_onblack & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m9 18 6-6-6-6' /></g></g></g>", "", FactAlert[AlertKey], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='715.4' height='126' viewBox='0 0 747 135' preserveAspectRatio='none'><rect width='747' height='135' rx='18' fill='" & _c_black & "' stroke='" & _c_blackrim & "' stroke-width='1.2'/><text x='22' y='38.5' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.4'>Attention required</text><rect x='378' y='56' width='1' height='61' fill='" & _c_onblack & "' fill-opacity='0.16'/>"
			        & _items
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
