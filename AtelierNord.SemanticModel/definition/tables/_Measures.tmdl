	measure 'NM date' =
			
			VAR _r = [Reference date]
			VAR _d = SWITCH ( [NM when], "In 2 weeks", _r + 14, "End of phase", [NM phase end], [NM package end] )
			RETURN IF ( ISBLANK ( _d ) || _d <= _r, _r + 14, _d )
		formatString: dd mmm yyyy
