sans-serif' font-size='16.5' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>Managing Partner</text><g transform='translate(118.5 989) scale(0.75)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='m6 9 6 6 6-6' /></g><text x='280.5' y='107.5' font-family='Segoe UI, Arial, sans-serif' font-size='60' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-1.6'>"
			        & "Finance"
			        & "</text><text x='281.5' y='136' font-family='Segoe UI, Arial, sans-serif' font-size='19.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & "A clear view of studio performance."
			        & "</text><text x='283' y='170' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start' letter-spacing='0.2'>"
			        & [Date label]
			        & "</text><g transform='translate(382 157) scale(0.708333)' fill='none' stroke='" & _c_ink & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m6 9 6 6 6-6' /></g><rect x='942.5' y='67.5' width='319.5' height='51.5' rx='25.75' fill='" & _c_chip & "' fill-opacity='" & _c_chipop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "' filter='url(#s)'/><g transform='translate(962 81) scale(1)' fill='none' stroke='" & _c_ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='m21 21-4.34-4.34' /><circle cx='11' cy='11' r='8' /></g><circle cx='1305.5' cy='93' r='26' fill='" & _c_pill & "' filter='url(#s)'/><g transform='translate(1294.5 82) scale(0.916667)' fill='none' stroke='" & _c_pilltext & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M10.268 21a2 2 0 0 0 3.464 0' /><path d='M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326' /></g>"
			        & IF ( [Notifications count] > 0, "<circle cx='1324.5' cy='74' r='11.5' fill='" & _c_pilltext & "' stroke='" & _c_pill & "' stroke-width='1.6'/><text x='1324.5' y='78.5' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='700' fill='" & _c_pill & "'>" & [Notifications count] & "</text>" )
			        & "<circle cx='1376.5' cy='93' r='26' fill='" & _c_chip & "' fill-opacity='" & _c_chipop & "' filter='url(#s)'/><circle cx='1368.5' cy='93' r='2.4' fill='" & _c_ink & "'/><circle cx='1376.5' cy='93' r='2.4' fill='" & _c_ink & "'/><circle cx='1384.5' cy='93' r='2.4' fill='" & _c_ink & "'/><rect x='526' y='141.5' width='319.5' height='36.5' rx='18.25' fill='" & _c_card & "' fill-opacity='" & _c_cardop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "'/><rect x='1186' y='141.5' width='210' height='36.5' rx='18.25' fill='" & _c_chip & "' fill-opacity='" & _c_chipop & "' stroke='" & _c_rim & "' stroke-opacity='" & _c_rimop & "'/><g transform='translate(1204 150.5) scale(0.791667)' fill='none' stroke='" & _c_ink & "' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M8 2v4' /><path d='M16 2v4' /><rect width='18' height='18' x='3' y='4' rx='2' /><path d='M3 10h18' /><path d='M8 14h.01' /><path d='M12 14h.01' /><path d='M16 14h.01' /><path d='M8 18h.01' /><path d='M12 18h.01' /><path d='M16 18h.01' /></g><text x='1303' y='165.5' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='400' fill='" & _c_ink & "' text-anchor='middle'>"
			        & [Fin period label]
