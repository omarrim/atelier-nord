	measure 'KPI band (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _k0 = [Active projects]
			VAR _k1 = [Fees billed YTD]
			VAR _k2 = [Operating margin]
			VAR _k3 = [Studio utilisation]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1111.8' height='123' viewBox='0 0 1158 131' preserveAspectRatio='none'><rect x='273.5' y='23' width='1' height='89' fill='" & _c_line & "'/><rect x='567' y='23' width='1' height='89' fill='" & _c_line & "'/><rect x='851.5' y='23' width='1' height='89' fill='" & _c_line & "'/>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k0 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='32.5' y='58.5' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( ROUND ( _v, 0 ), "#,0", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.15 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.15 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.15 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.25s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.25s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='32.5' y='85' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Active projects</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k1 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='327.5' y='58.5' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & IF ( ABS ( _k1 ) >= 1000000, "€" & FORMAT ( _v / 1000000, "0.0", "en-US" ) & "M", "€" & FORMAT ( _v / 1000, "0", "en-US" ) & "k" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.25 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.25 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.25 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.35s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.35s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='327.5' y='85' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Fees billed</text><text x='327.5' y='111' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & [Fees change label]
			        & "</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k2 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='620.5' y='58.5' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( _v, "0.0%", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.35 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.35 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.35 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.45s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.45s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='620.5' y='85' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Operating margin</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k3 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='906.5' y='58.5' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( _v, "0.0%", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.45000000000000007 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.45000000000000007 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.45000000000000007 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.55s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.55s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='906.5' y='85' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Studio utilisation</text><text x='906.5' y='111' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & [Utilisation hours label]
			        & "</text></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 417bfe44-b2a7-596a-9c75-7a081e807b2d
		dataCategory: ImageUrl

	measure 'Planning card (SVG)' =
			
			VAR _c_construction = [Color construction]
			VAR _c_design = [Color design]
			VAR _c_ink = [Color ink]
			VAR _c_muted = [Color muted]
			VAR _c_permit = [Color permit]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='483.3' height='403.5' viewBox='0 0 509.5 410.5' preserveAspectRatio='none'><text x='22.5' y='43.5' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Project planning</text><circle cx='31.5' cy='364' r='7.5' fill='" & _c_design & "'/><text x='50' y='369' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Design</text><circle cx='136.5' cy='364' r='7.5' fill='" & _c_permit & "'/><text x='155' y='369' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Permit</text><circle cx='241.5' cy='364' r='7.5' fill='" & _c_construction & "'/><text x='260' y='369' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Construction</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 2580981d-f9f0-5f31-a998-bdff0acaac58
		dataCategory: ImageUrl

	measure 'Gantt row overview (SVG)' =
			
			VAR _c_construction = [Color construction]
			VAR _c_design = [Color design]
			VAR _c_permit = [Color permit]
			VAR _c_future = [Color future]
			VAR _c_ink = [Color ink]
			VAR _c_avring = [Color avring]
			VAR _c_grid = [Color grid]
			VAR _c_ink2 = [Color ink2]
			VAR _c_line = [Color line]
			VAR _o = [Gantt order overview]
			VAR _nom = SELECTEDVALUE ( DimProject[Project] )
			VAR _ts = [Selected timescale]
			VAR _r = [Reference date]
			VAR _ws = [Window start]
			VAR _we = [Window end]
			VAR _n = INT ( _we - _ws ) + 1
			VAR _nt = SWITCH ( _ts, "Week", 6, "Quarter", 6, "Year", 4, 5 )
			VAR _ticks = ADDCOLUMNS ( GENERATESERIES ( 0, _nt ), "@d",
			    SWITCH ( _ts, "Week", _ws + 7 * [Value], "Quarter", EDATE ( _ws, 3 * [Value] ), "Year", EDATE ( _ws, 12 * [Value] ), EDATE ( _ws, [Value] ) ) )
			VAR _court = _ts IN { "Week", "Month" }
			VAR _pk = TOPN ( 1, FILTER ( FactWorkPackage, FactWorkPackage[End] >= _r ), FactWorkPackage[Start], ASC )
			VAR _segs = UNION (
			    SELECTCOLUMNS ( FILTER ( _pk, _court ), "@s", FactWorkPackage[Start], "@e", FactWorkPackage[End], "@ph", FactWorkPackage[Phase] ),
			    SELECTCOLUMNS ( FILTER ( FactProjectPhase, NOT _court && FactProjectPhase[End] >= _ws && FactProjectPhase[Start] <= _we ),
			        "@s", FactProjectPhase[Start], "@e", FactProjectPhase[End], "@ph", FactProjectPhase[Phase] ) )
			VAR _vis = FILTER ( ADDCOLUMNS ( _segs, "@a", MAX ( [@s], _ws ), "@b", MIN ( [@e], _we ) ), [@a] <= [@b] )
			VAR _xy = ADDCOLUMNS ( _vis, "@x1", ( 136 + ( [@a] - _ws ) / _n * 316 ), "@x2", ( 136 + ( ( [@b] + 1 ) - _ws ) / _n * 316 ) )
			VAR _cur = TOPN ( 1, FILTER ( _xy, [@e] >= _r ), [@s], ASC )
			VAR _fin = IF ( ISEMPTY ( _cur ), MAXX ( _xy, [@x2] ), MAXX ( _cur, [@x2] ) )
			VAR _deb = IF ( ISEMPTY ( _cur ), MINX ( _xy, [@x1] ), MAXX ( _cur, [@x1] ) )
			VAR _barres = CONCATENATEX ( _xy,
			    VAR _w = MAX ( [@x2] - [@x1] - IF ( _court, 0, 2 ), 2 ) VAR _futur = [@s] > _r
			    VAR _c = SWITCH ( [@ph], "Construction", _c_construction, "Design", _c_design, "Permit", _c_permit, _c_design )
			    RETURN "<rect x='" & FORMAT ( [@x1], "0.0", "en-US" ) & "' y='9.5' width='" & FORMAT ( _w, "0.0", "en-US" ) & "' height='28' rx='" & FORMAT ( MIN ( 14, _w / 2 ), "0.0", "en-US" )
			        & IF ( _futur, "' fill='" & _c_future & "' stroke='" & _c_ink & "' stroke-width='1.4'/>", "' fill='" & _c & "'/>" ),
			    "", [@s], ASC )
			VAR _av = TOPN ( 3, FILTER ( BridgeProjectPerson, BridgeProjectPerson[IsStaff] ), BridgeProjectPerson[MemberOrder], ASC )
			VAR _avs = CONCATENATEX ( _av,
			    VAR _i = RANKX ( _av, BridgeProjectPerson[MemberOrder], , ASC )
			    VAR _cx = MAX ( _fin - 15.5 - ( 3 - _i ) * 19, _deb + 15.5 + ( _i - 1 ) * 19 )
			    VAR _b = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], BridgeProjectPerson[PersonKey] )
			    RETURN "<clipPath id='a" & _i & "'><circle cx='" & FORMAT ( _cx, "0.0", "en-US" ) & "' cy='23.5' r='12'/></clipPath>"
			        & "<circle cx='" & FORMAT ( _cx, "0.0", "en-US" ) & "' cy='23.5' r='13.6' fill='" & _c_avring & "'/>"
			        & "<image x='" & FORMAT ( _cx - 12, "0.0", "en-US" ) & "' y='11.5' width='24' height='24' clip-path='url(#a" & _i & ")' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64," & _b & "'/>",
			    "", BridgeProjectPerson[MemberOrder], ASC )
			VAR _grille = CONCATENATEX ( _ticks, "<rect x='" & FORMAT ( ( 136 + ( [@d] - _ws ) / _n * 316 ) - 0.5, "0.0", "en-US" ) & "' y='0' width='1' height='47' fill='" & _c_grid & "'/>", "" )
			VAR _xt = ( 136 + ( ( _r + 0.5 ) - _ws ) / _n * 316 )
			VAR _today = IF ( _r >= _ws && _r <= _we, "<line x1='" & FORMAT ( _xt, "0.0", "en-US" ) & "' y1='0' x2='" & FORMAT ( _xt, "0.0", "en-US" ) & "' y2='47' stroke='" & _c_ink & "' stroke-width='1.2' stroke-dasharray='3 4' stroke-dashoffset='" & MOD ( ( _o - 1 ) * 47, 7 ) & "'/>" )
			VAR _debut = 0.15 + 0.08 * ( _o - 1 )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='461' height='47' viewBox='0 0 461 47' preserveAspectRatio='none'><rect x='0' y='46' width='461' height='1' fill='" & _c_line & "'/>"
			        & _grille
			        & "<text x='9.5' y='28.5' font-family='Segoe UI, Arial, sans-serif' font-size='14.5' fill='" & _c_ink2 & "'>"
			        & _nom
			        & "</text><clipPath id='r'><rect x='132' y='0' width='0' height='47'><animate attributeName='width' from='0' to='328' begin='"
			        & FORMAT ( _debut, "0.00", "en-US" )
			        & "s' dur='0.9s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect></clipPath><g clip-path='url(#r)'>"
			        & _barres
			        & "</g><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='"
			        & FORMAT ( _debut + 0.55, "0.00", "en-US" )
			        & "s' dur='0.4s' fill='freeze'/>"
			        & _avs
			        & "</g>"
			        & _today
			        & "</svg>"
			RETURN IF ( NOT ISBLANK ( _o ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" ) )
		displayFolder: 90 SVG
		lineageTag: cfd7b6bb-ee1c-5113-9d3f-34a9565aec91
		dataCategory: ImageUrl

	measure 'Gantt axis (SVG)' =
			
			VAR _c_muted = [Color muted]
			VAR _c_ink = [Color ink]
			VAR _ts = [Selected timescale]
			VAR _r = [Reference date]
			VAR _ws = [Window start]
			VAR _we = [Window end]
			VAR _n = INT ( _we - _ws ) + 1
			VAR _nt = SWITCH ( _ts, "Week", 6, "Quarter", 6, "Year", 4, 5 )
			VAR _ticks = ADDCOLUMNS ( GENERATESERIES ( 0, _nt ), "@d",
			    SWITCH ( _ts, "Week", _ws + 7 * [Value], "Quarter", EDATE ( _ws, 3 * [Value] ), "Year", EDATE ( _ws, 12 * [Value] ), EDATE ( _ws, [Value] ) ) )
			VAR _libs = CONCATENATEX ( FILTER ( _ticks, [Value] < _nt ),
			    VAR _d = [@d] VAR _e = SWITCH ( _ts, "Week", _d + 7, "Quarter", EDATE ( _d, 3 ), "Year", EDATE ( _d, 12 ), EDATE ( _d, 1 ) )
			    VAR _lib = SWITCH ( _ts,
			        "Week", IF ( [Value] = 0 || DAY ( _d ) <= 7, UPPER ( FORMAT ( _d, "mmm d", "en-US" ) ), FORMAT ( _d, "d" ) ),
			        "Quarter", "Q" & QUARTER ( _d ) & " '" & RIGHT ( YEAR ( _d ), 2 ),
			        "Year", FORMAT ( YEAR ( _d ), "0" ),
			        UPPER ( FORMAT ( _d, "mmm", "en-US" ) ) )
			    RETURN "<text x='" & FORMAT ( ( 136 + ( ( _d + _e ) / 2 - _ws ) / _n * 316 ), "0.0", "en-US" ) & "' y='15' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' letter-spacing='0.4' fill='" & _c_muted & "'>" & _lib & "</text>", "", [Value], ASC )
			VAR _xt = ( 136 + ( ( _r + 0.5 ) - _ws ) / _n * 316 )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='461' height='24' viewBox='0 0 461 24' preserveAspectRatio='none'><rect width='461' height='24' fill='none'/>"
			        & _libs
			        & "<circle cx='"
			        & FORMAT ( _xt, "0.0", "en-US" )
			        & "' cy='21' r='3.3' fill='" & _c_ink & "'/></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 84b0f572-2804-5bdd-985b-e7d5fd0f6967
		dataCategory: ImageUrl

	measure 'Portfolio (SVG)' =
			
			VAR _c_construction = [Color construction]
			VAR _c_design = [Color design]
			VAR _c_faint = [Color faint]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_permit = [Color permit]
			VAR _c_track = [Color track]
			VAR _p = [Overall completion]
			VAR _mois = ADDCOLUMNS ( GENERATESERIES ( 1, 9 ), "@d", DATE ( YEAR ( [Reference date] ), [Value], 1 ) )
			VAR _v = ADDCOLUMNS ( _mois,
			    "@h", VAR _a = [@d] RETURN CALCULATE ( SUM ( FactTimesheet[Hours] ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _a, EOMONTH ( _a, 0 ) ) ),
			    "@p", VAR _a = [@d] RETURN CALCULATE ( SUM ( FactPlan[PlannedHours] ), REMOVEFILTERS ( DimDate ), DATESBETWEEN ( DimDate[Date], _a, EOMONTH ( _a, 0 ) ) ) )
			VAR _max = MAXX ( _v, MAX ( [@h], [@p] ) ) VAR _min = MINX ( _v, MIN ( [@h], [@p] ) ) * 0.92
			VAR _xy = ADDCOLUMNS ( _v, "@x", 18.5 + ( [Value] - 1 ) * 237.5 / 8,
			    "@y", 286 - DIVIDE ( [@h] - _min, _max - _min ) * 72, "@yp", 286 - DIVIDE ( [@p] - _min, _max - _min ) * 72 )
			VAR _nb = COUNTROWS ( _xy )
			VAR _pt = ADDCOLUMNS ( _xy, "@xn", VAR _k = [Value] RETURN MAXX ( FILTER ( _xy, [Value] = _k + 1 ), [@x] ),
			    "@yn", VAR _k = [Value] RETURN MAXX ( FILTER ( _xy, [Value] = _k + 1 ), [@y] ) )
			VAR _x0 = MINX ( FILTER ( _pt, [Value] = 1 ), [@x] ) VAR _y0 = MINX ( FILTER ( _pt, [Value] = 1 ), [@y] )
			VAR _xn = MINX ( FILTER ( _pt, [Value] = _nb ), [@x] ) VAR _yn = MINX ( FILTER ( _pt, [Value] = _nb ), [@y] )
			VAR _chemin = "M" & FORMAT ( _x0, "0.0", "en-US" ) & "," & FORMAT ( _y0, "0.0", "en-US" ) & CONCATENATEX ( FILTER ( _pt, [Value] < _nb ),
			    IF ( [Value] = 1, "", " Q" & FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y], "0.0", "en-US" ) & " " ) & IF ( [Value] = 1, " L", "" )
			    & FORMAT ( ( [@x] + [@xn] ) / 2, "0.0", "en-US" ) & "," & FORMAT ( ( [@y] + [@yn] ) / 2, "0.0", "en-US" ), "", [Value], ASC )
			    & " L" & FORMAT ( _xn, "0.0", "en-US" ) & "," & FORMAT ( _yn, "0.0", "en-US" )
			VAR _chemin_h = _chemin VAR _xn_h = _xn VAR _yn_h = _yn
			VAR _nb2 = COUNTROWS ( _xy )
			VAR _pt2 = ADDCOLUMNS ( _xy, "@xn", VAR _k = [Value] RETURN MAXX ( FILTER ( _xy, [Value] = _k + 1 ), [@x] ),
			    "@yn", VAR _k = [Value] RETURN MAXX ( FILTER ( _xy, [Value] = _k + 1 ), [@yp] ) )
			VAR _x02 = MINX ( FILTER ( _pt2, [Value] = 1 ), [@x] ) VAR _y02 = MINX ( FILTER ( _pt2, [Value] = 1 ), [@yp] )
			VAR _xn2 = MINX ( FILTER ( _pt2, [Value] = _nb2 ), [@x] ) VAR _yn2 = MINX ( FILTER ( _pt2, [Value] = _nb2 ), [@yp] )
			VAR _chemin2 = "M" & FORMAT ( _x02, "0.0", "en-US" ) & "," & FORMAT ( _y02, "0.0", "en-US" ) & CONCATENATEX ( FILTER ( _pt2, [Value] < _nb2 ),
			    IF ( [Value] = 1, "", " Q" & FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@yp], "0.0", "en-US" ) & " " ) & IF ( [Value] = 1, " L", "" )
			    & FORMAT ( ( [@x] + [@xn] ) / 2, "0.0", "en-US" ) & "," & FORMAT ( ( [@yp] + [@yn] ) / 2, "0.0", "en-US" ), "", [Value], ASC )
			    & " L" & FORMAT ( _xn2, "0.0", "en-US" ) & "," & FORMAT ( _yn2, "0.0", "en-US" )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='259.9' height='403.5' viewBox='0 0 278.5 410.5' preserveAspectRatio='none'><text x='22.5' y='43.5' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Portfolio progress</text><circle cx='137.5' cy='132.5' r='68' fill='none' stroke='" & _c_track & "' stroke-width='9'/><circle cx='137.5' cy='132.5' r='68' fill='none' stroke='" & _c_ink & "' stroke-width='9' stroke-linecap='round' transform='rotate(-90 137.5 132.5)' stroke-dasharray='427.26' stroke-dashoffset='427.26'><animate attributeName='stroke-dashoffset' from='427.26' to='"
			        & FORMAT ( 427.2566 * ( 1 - _p ), "0.00", "en-US" )
			        & "' begin='0.2s' dur='1.4s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></circle><g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.35s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 4' to='0 0' begin='0.35s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='137.5' y='140' font-family='Segoe UI, Arial, sans-serif' font-size='32' font-weight='600' fill='" & _c_ink & "' text-anchor='middle' letter-spacing='-0.8'>"
			        & FORMAT ( _p, "0.0%", "en-US" )
			        & "</text><text x='137.5' y='159' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='middle'>Overall completion</text></g><line x1='78.5' y1='206' x2='78.5' y2='292' stroke='" & _c_line & "' stroke-width='1' stroke-dasharray='3 3'/><line x1='138.5' y1='206' x2='138.5' y2='292' stroke='" & _c_line & "' stroke-width='1' stroke-dasharray='3 3'/><line x1='198.5' y1='206' x2='198.5' y2='292' stroke='" & _c_line & "' stroke-width='1' stroke-dasharray='3 3'/><path d='"
			        & _chemin2
			        & "' fill='none' stroke='" & _c_faint & "' stroke-width='1.6' stroke-linecap='round' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'><animate attributeName='stroke-dashoffset' from='1' to='0' begin='0.3s' dur='1.2s' fill='freeze'/></path><path d='"
			        & _chemin_h
			        & "' fill='none' stroke='" & _c_ink & "' stroke-width='2.4' stroke-linecap='round' pathLength='1' stroke-dasharray='1' stroke-dashoffset='1'><animate attributeName='stroke-dashoffset' from='1' to='0' begin='0.45s' dur='1.3s' fill='freeze'/></path><circle cx='"
			        & FORMAT ( _xn_h, "0.0", "en-US" )
			        & "' cy='"
			        & FORMAT ( _yn_h, "0.0", "en-US" )
			        & "' r='0' fill='" & _c_ink & "'><animate attributeName='r' from='0' to='4.6' begin='1.6s' dur='0.3s' fill='freeze'/></circle><circle cx='29.5' cy='316.5' r='8' fill='" & _c_design & "'/><text x='53.5' y='322' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Design</text><text x='256' y='322' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='600' fill='" & _c_ink & "' text-anchor='end'>"
			        & FORMAT ( [Design progress], "0%", "en-US" )
			        & "</text><rect x='48' y='332.5' width='208' height='1' fill='" & _c_line & "'/><circle cx='29.5' cy='348.5' r='8' fill='" & _c_permit & "'/><text x='53.5' y='354' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Permit</text><text x='256' y='354' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='600' fill='" & _c_ink & "' text-anchor='end'>"
			        & FORMAT ( [Permit progress], "0%", "en-US" )
			        & "</text><rect x='48' y='364.5' width='208' height='1' fill='" & _c_line & "'/><circle cx='29.5' cy='380.5' r='8' fill='" & _c_construction & "'/><text x='53.5' y='386' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='400' fill='" & _c_ink & "' text-anchor='start'>Construction</text><text x='256' y='386' font-family='Segoe UI, Arial, sans-serif' font-size='16.5' font-weight='600' fill='" & _c_ink & "' text-anchor='end'>"
			        & FORMAT ( [Construction progress], "0%", "en-US" )
			        & "</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: 118800b9-77d8-557f-a0f4-d978b95eae33
		dataCategory: ImageUrl

	measure 'Featured (SVG)' =
			
			VAR _c_black = [Color black]
			VAR _c_blackrim = [Color blackrim]
			VAR _c_blacktrack = [Color blacktrack]
			VAR _c_onblack = [Color onblack]
			VAR _c_onblack2 = [Color onblack2]
			VAR _k = [Shown project key]
			VAR _img = [Shown render]
			VAR _p = [Shown progress]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='329.7' height='403.5' viewBox='0 0 350 410' preserveAspectRatio='none'><clipPath id='c'><rect width='350' height='410' rx='18'/></clipPath><g clip-path='url(#c)'><rect width='350' height='410' fill='" & _c_black & "'/><defs><image id='b' x='0' y='0' width='350' height='300' preserveAspectRatio='xMidYMid slice' href='"
			        & _img
			        & "'/><clipPath id='k'><rect x='0' y='300' width='350' height='0'><animate attributeName='y' from='300' to='"
			        & FORMAT ( 232 * ( 1 - _p ), "0.0", "en-US" )
			        & "' begin='0.3s' dur='1.6s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.33 1 0.68 1'/><animate attributeName='height' from='0' to='"
			        & FORMAT ( 300 - 232 * ( 1 - _p ), "0.0", "en-US" )
			        & "' begin='0.3s' dur='1.6s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.33 1 0.68 1'/></rect></clipPath></defs><use href='#b' opacity='0.26'/><use href='#b' clip-path='url(#k)'/><rect x='0' y='300' width='350' height='2' fill='#FFFFFF' opacity='0.95'><animate attributeName='y' from='300' to='"
			        & FORMAT ( 232 * ( 1 - _p ), "0.0", "en-US" )
			        & "' begin='0.3s' dur='1.6s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.33 1 0.68 1'/></rect><defs><linearGradient id='h' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='" & _c_black & "' stop-opacity='0.78'/><stop offset='1' stop-color='" & _c_black & "' stop-opacity='0'/></linearGradient><linearGradient id='v' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='" & _c_black & "' stop-opacity='0'/><stop offset='1' stop-color='" & _c_black & "' stop-opacity='1'/></linearGradient></defs><rect width='350' height='96' fill='url(#h)'/><rect y='170' width='350' height='132' fill='url(#v)'/><rect y='300' width='350' height='110' fill='" & _c_black & "'/></g><rect x='0.6' y='0.6' width='348.8' height='408.8' rx='18' fill='none' stroke='" & _c_blackrim & "' stroke-width='1.2'/><text x='21' y='42' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.4'>Featured project</text><text x='19' y='326.5' font-family='Segoe UI, Arial, sans-serif' font-size='29' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.6'>"
			        & [Shown project]
			        & "</text><text x='21' y='354' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>"
			        & [Shown area label] & "  •  " & [Shown budget label]
			        & "</text><text x='21' y='379' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='400' fill='" & _c_onblack & "' text-anchor='start'>"
			        & [Shown phase]
			        & "</text><text x='328.5' y='379' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='600' fill='" & _c_onblack & "' text-anchor='end'>"
			        & FORMAT ( _p, "0%", "en-US" )
			        & "</text><rect x='21' y='387.5' width='307.5' height='8' rx='4' fill='" & _c_blacktrack & "'/><rect x='21' y='387.5' width='0' height='8' rx='4' fill='" & _c_onblack & "'><animate attributeName='width' from='0' to='"
			        & FORMAT ( 307.5 * _p, "0.0", "en-US" )
			        & "' begin='0.5s' dur='1.2s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: b7a1422c-6cb7-5d12-8366-8fa5ba0cb263
		dataCategory: ImageUrl

	measure 'Studio teams (SVG)' =
			
			VAR _c_black = [Color black]
			VAR _c_blackchip = [Color blackchip]
			VAR _c_blackrim = [Color blackrim]
			VAR _c_blacktrack = [Color blacktrack]
			VAR _c_onblack = [Color onblack]
			VAR _c_onblack2 = [Color onblack2]
			VAR _sel = HASONEVALUE ( DimProject[ProjectKey] )
			VAR _pk = SELECTEDVALUE ( DimProject[ProjectKey] )
			VAR _pnom = SELECTEDVALUE ( DimProject[Project] )
			VAR _membres = CALCULATETABLE ( VALUES ( BridgeProjectPerson[PersonKey] ), REMOVEFILTERS ( DimProject ), BridgeProjectPerson[ProjectKey] = _pk, BridgeProjectPerson[IsStaff] = TRUE () )
			VAR _hp = CALCULATE ( [Hours YTD], ALL ( DimPerson ) )
			VAR _us0 = CALCULATE ( [Studio utilisation], REMOVEFILTERS ( DimProject ), DimPerson[Team] = "Design studio" )
			VAR _h0 = CALCULATE ( [Hours YTD], DimPerson[Team] = "Design studio" )
			VAR _u0 = IF ( _sel, DIVIDE ( _h0, _hp ), _us0 )
			VAR _t0 = IF ( _sel, CALCULATE ( [Open tasks], FactTask[Team] = "Design studio" ), CALCULATE ( [Open tasks], REMOVEFILTERS ( DimProject ), FactTask[Team] = "Design studio" ) )
			VAR _av0 = FILTER ( ALL ( DimPerson ), DimPerson[Team] = "Design studio" && DimPerson[IsStaff] && ( NOT _sel || DimPerson[PersonKey] IN _membres ) )
			VAR _n0 = COUNTROWS ( _av0 )
			VAR _avs0 = CONCATENATEX ( _av0, VAR _j = RANKX ( _av0, DimPerson[PersonKey], , ASC ) VAR _cx = 222 + ( _j - 1 ) * 60
			    VAR _u = MIN ( IF ( _sel, DIVIDE ( CALCULATE ( [Hours YTD] ), CALCULATE ( [Hours YTD], REMOVEFILTERS ( DimProject ) ) ),
			        CALCULATE ( [Studio utilisation], REMOVEFILTERS ( DimProject ) ) ), 1 )
			    VAR _d = 0.15 + ( _j - 1 ) * 0.08
			    VAR _b = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], DimPerson[PersonKey] )
			    RETURN "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( _d, "0.00", "en-US" ) & "s' dur='0.35s' fill='freeze'/>"
			        & "<circle cx='" & _cx & "' cy='80' r='20.5' fill='none' stroke='" & _c_blacktrack & "' stroke-width='2.6'/>"
			        & "<circle cx='" & _cx & "' cy='80' r='20.5' fill='none' stroke='" & _c_onblack & "' stroke-width='2.6' stroke-linecap='round' transform='rotate(-90 " & _cx & " 80)' stroke-dasharray='128.81' stroke-dashoffset='128.81'>"
			        & "<animate attributeName='stroke-dashoffset' from='128.81' to='" & FORMAT ( 128.8053 * ( 1 - _u ), "0.00", "en-US" ) & "' begin='" & FORMAT ( _d + 0.2, "0.00", "en-US" ) & "s' dur='0.9s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></circle>"
			        & "<clipPath id='t0" & _j & "'><circle cx='" & _cx & "' cy='80' r='17'/></clipPath><circle cx='" & _cx & "' cy='80' r='17.6' fill='" & _c_blackchip & "'/>"
			        & "<image x='" & ( _cx - 17 ) & "' y='63' width='34' height='34' clip-path='url(#t0" & _j & ")' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64," & _b & "'/>"
			        & "<text x='" & _cx & "' y='113' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='10.5' fill='" & _c_onblack2 & "'>" & DimPerson[FirstName] & "</text></g>",
			    "", DimPerson[PersonKey], ASC )
			VAR _us1 = CALCULATE ( [Studio utilisation], REMOVEFILTERS ( DimProject ), DimPerson[Team] = "Technical" )
			VAR _h1 = CALCULATE ( [Hours YTD], DimPerson[Team] = "Technical" )
			VAR _u1 = IF ( _sel, DIVIDE ( _h1, _hp ), _us1 )
			VAR _t1 = IF ( _sel, CALCULATE ( [Open tasks], FactTask[Team] = "Technical" ), CALCULATE ( [Open tasks], REMOVEFILTERS ( DimProject ), FactTask[Team] = "Technical" ) )
			VAR _av1 = FILTER ( ALL ( DimPerson ), DimPerson[Team] = "Technical" && DimPerson[IsStaff] && ( NOT _sel || DimPerson[PersonKey] IN _membres ) )
			VAR _n1 = COUNTROWS ( _av1 )
			VAR _avs1 = CONCATENATEX ( _av1, VAR _j = RANKX ( _av1, DimPerson[PersonKey], , ASC ) VAR _cx = 222 + ( _j - 1 ) * 60
			    VAR _u = MIN ( IF ( _sel, DIVIDE ( CALCULATE ( [Hours YTD] ), CALCULATE ( [Hours YTD], REMOVEFILTERS ( DimProject ) ) ),
			        CALCULATE ( [Studio utilisation], REMOVEFILTERS ( DimProject ) ) ), 1 )
			    VAR _d = 0.44999999999999996 + ( _j - 1 ) * 0.08
			    VAR _b = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], DimPerson[PersonKey] )
			    RETURN "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( _d, "0.00", "en-US" ) & "s' dur='0.35s' fill='freeze'/>"
			        & "<circle cx='" & _cx & "' cy='144' r='20.5' fill='none' stroke='" & _c_blacktrack & "' stroke-width='2.6'/>"
			        & "<circle cx='" & _cx & "' cy='144' r='20.5' fill='none' stroke='" & _c_onblack & "' stroke-width='2.6' stroke-linecap='round' transform='rotate(-90 " & _cx & " 144)' stroke-dasharray='128.81' stroke-dashoffset='128.81'>"
			        & "<animate attributeName='stroke-dashoffset' from='128.81' to='" & FORMAT ( 128.8053 * ( 1 - _u ), "0.00", "en-US" ) & "' begin='" & FORMAT ( _d + 0.2, "0.00", "en-US" ) & "s' dur='0.9s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></circle>"
			        & "<clipPath id='t1" & _j & "'><circle cx='" & _cx & "' cy='144' r='17'/></clipPath><circle cx='" & _cx & "' cy='144' r='17.6' fill='" & _c_blackchip & "'/>"
			        & "<image x='" & ( _cx - 17 ) & "' y='127' width='34' height='34' clip-path='url(#t1" & _j & ")' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64," & _b & "'/>"
			        & "<text x='" & _cx & "' y='177' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='10.5' fill='" & _c_onblack2 & "'>" & DimPerson[FirstName] & "</text></g>",
			    "", DimPerson[PersonKey], ASC )
			VAR _us2 = CALCULATE ( [Studio utilisation], REMOVEFILTERS ( DimProject ), DimPerson[Team] = "Interiors" )
			VAR _h2 = CALCULATE ( [Hours YTD], DimPerson[Team] = "Interiors" )
			VAR _u2 = IF ( _sel, DIVIDE ( _h2, _hp ), _us2 )
			VAR _t2 = IF ( _sel, CALCULATE ( [Open tasks], FactTask[Team] = "Interiors" ), CALCULATE ( [Open tasks], REMOVEFILTERS ( DimProject ), FactTask[Team] = "Interiors" ) )
			VAR _av2 = FILTER ( ALL ( DimPerson ), DimPerson[Team] = "Interiors" && DimPerson[IsStaff] && ( NOT _sel || DimPerson[PersonKey] IN _membres ) )
			VAR _n2 = COUNTROWS ( _av2 )
			VAR _avs2 = CONCATENATEX ( _av2, VAR _j = RANKX ( _av2, DimPerson[PersonKey], , ASC ) VAR _cx = 222 + ( _j - 1 ) * 60
			    VAR _u = MIN ( IF ( _sel, DIVIDE ( CALCULATE ( [Hours YTD] ), CALCULATE ( [Hours YTD], REMOVEFILTERS ( DimProject ) ) ),
			        CALCULATE ( [Studio utilisation], REMOVEFILTERS ( DimProject ) ) ), 1 )
			    VAR _d = 0.75 + ( _j - 1 ) * 0.08
			    VAR _b = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], DimPerson[PersonKey] )
			    RETURN "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( _d, "0.00", "en-US" ) & "s' dur='0.35s' fill='freeze'/>"
			        & "<circle cx='" & _cx & "' cy='208' r='20.5' fill='none' stroke='" & _c_blacktrack & "' stroke-width='2.6'/>"
			        & "<circle cx='" & _cx & "' cy='208' r='20.5' fill='none' stroke='" & _c_onblack & "' stroke-width='2.6' stroke-linecap='round' transform='rotate(-90 " & _cx & " 208)' stroke-dasharray='128.81' stroke-dashoffset='128.81'>"
			        & "<animate attributeName='stroke-dashoffset' from='128.81' to='" & FORMAT ( 128.8053 * ( 1 - _u ), "0.00", "en-US" ) & "' begin='" & FORMAT ( _d + 0.2, "0.00", "en-US" ) & "s' dur='0.9s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></circle>"
			        & "<clipPath id='t2" & _j & "'><circle cx='" & _cx & "' cy='208' r='17'/></clipPath><circle cx='" & _cx & "' cy='208' r='17.6' fill='" & _c_blackchip & "'/>"
			        & "<image x='" & ( _cx - 17 ) & "' y='191' width='34' height='34' clip-path='url(#t2" & _j & ")' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64," & _b & "'/>"
			        & "<text x='" & _cx & "' y='241' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='10.5' fill='" & _c_onblack2 & "'>" & DimPerson[FirstName] & "</text></g>",
			    "", DimPerson[PersonKey], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='755.9' height='252' viewBox='0 0 794 257.5' preserveAspectRatio='none'><rect width='794' height='257.5' rx='18' fill='" & _c_black & "' stroke='" & _c_blackrim & "' stroke-width='1.2'/><text x='22.5' y='36.5' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_onblack & "' text-anchor='start' letter-spacing='-0.4'>Studio teams</text><text x='771.5' y='35' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='end'>"
			        & IF ( _sel, "On " & _pnom & ", hours this year", "Capacity used, year to date" )
			        & "</text><text x='22.5' y='78' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='600' fill='" & _c_onblack & "' text-anchor='start'>Design studio</text><text x='22.5' y='98' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>"
			        & _t0 & IF ( _t0 = 1, " task · ", " tasks · " ) & _n0 & IF ( _n0 = 1, " person", " people" )
			        & "</text>"
			        & _avs0
			        & "<text x='771.5' y='77' font-family='Segoe UI, Arial, sans-serif' font-size='20' font-weight='600' fill='" & _c_onblack & "' text-anchor='end' letter-spacing='-0.4'>"
			        & IF ( _sel, FORMAT ( _h0, "#,0", "en-US" ) & " h", IF ( ROUND ( _u0 * 1000, 0 ) = ROUND ( _u0 * 100, 0 ) * 10, FORMAT ( _u0, "0%", "en-US" ), FORMAT ( _u0, "0.0%", "en-US" ) ) )
			        & "</text><rect x='604' y='89' width='167.5' height='7' rx='3.5' fill='" & _c_blacktrack & "'/><rect x='604' y='89' width='0' height='7' rx='3.5' fill='" & _c_onblack & "'><animate attributeName='width' from='0' to='"
			        & FORMAT ( 167.5 * MIN ( _u0, 1 ), "0.0", "en-US" )
			        & "' begin='0.4s' dur='1.1s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect><rect x='22.5' y='118' width='749' height='1' fill='" & _c_onblack & "' fill-opacity='0.12'/><text x='22.5' y='142' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='600' fill='" & _c_onblack & "' text-anchor='start'>Technical</text><text x='22.5' y='162' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>"
			        & _t1 & IF ( _t1 = 1, " task · ", " tasks · " ) & _n1 & IF ( _n1 = 1, " person", " people" )
			        & "</text>"
			        & _avs1
			        & "<text x='771.5' y='141' font-family='Segoe UI, Arial, sans-serif' font-size='20' font-weight='600' fill='" & _c_onblack & "' text-anchor='end' letter-spacing='-0.4'>"
			        & IF ( _sel, FORMAT ( _h1, "#,0", "en-US" ) & " h", IF ( ROUND ( _u1 * 1000, 0 ) = ROUND ( _u1 * 100, 0 ) * 10, FORMAT ( _u1, "0%", "en-US" ), FORMAT ( _u1, "0.0%", "en-US" ) ) )
			        & "</text><rect x='604' y='153' width='167.5' height='7' rx='3.5' fill='" & _c_blacktrack & "'/><rect x='604' y='153' width='0' height='7' rx='3.5' fill='" & _c_onblack & "'><animate attributeName='width' from='0' to='"
			        & FORMAT ( 167.5 * MIN ( _u1, 1 ), "0.0", "en-US" )
			        & "' begin='0.52s' dur='1.1s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect><rect x='22.5' y='182' width='749' height='1' fill='" & _c_onblack & "' fill-opacity='0.12'/><text x='22.5' y='206' font-family='Segoe UI, Arial, sans-serif' font-size='17' font-weight='600' fill='" & _c_onblack & "' text-anchor='start'>Interiors</text><text x='22.5' y='226' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_onblack2 & "' text-anchor='start'>"
			        & _t2 & IF ( _t2 = 1, " task · ", " tasks · " ) & _n2 & IF ( _n2 = 1, " person", " people" )
			        & "</text>"
			        & _avs2
			        & "<text x='771.5' y='205' font-family='Segoe UI, Arial, sans-serif' font-size='20' font-weight='600' fill='" & _c_onblack & "' text-anchor='end' letter-spacing='-0.4'>"
			        & IF ( _sel, FORMAT ( _h2, "#,0", "en-US" ) & " h", IF ( ROUND ( _u2 * 1000, 0 ) = ROUND ( _u2 * 100, 0 ) * 10, FORMAT ( _u2, "0%", "en-US" ), FORMAT ( _u2, "0.0%", "en-US" ) ) )
			        & "</text><rect x='604' y='217' width='167.5' height='7' rx='3.5' fill='" & _c_blacktrack & "'/><rect x='604' y='217' width='0' height='7' rx='3.5' fill='" & _c_onblack & "'><animate attributeName='width' from='0' to='"
			        & FORMAT ( 167.5 * MIN ( _u2, 1 ), "0.0", "en-US" )
			        & "' begin='0.64s' dur='1.1s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/></rect></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: cbc739f7-0d69-50ba-9ff5-176fb20a2ff6
		dataCategory: ImageUrl

	measure 'Next milestones (SVG)' =
			
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _c_line = [Color line]
			VAR _c_chip = [Color chip]
			VAR _c_faint = [Color faint]
			VAR _c_ink = [Color ink]
			VAR _c_pill = [Color pill]
			VAR _c_pilltext = [Color pilltext]
			VAR _r = [Reference date]
			VAR _j = TOPN ( 3, CALCULATETABLE ( FactMilestone, REMOVEFILTERS ( DimProject ), FactMilestone[Kind] = "Major", FactMilestone[Date] > _r ),
			    FactMilestone[Date], ASC, FactMilestone[MilestoneKey], ASC )
			VAR _lignes = CONCATENATEX ( _j,
			    VAR _i = RANKX ( _j, FactMilestone[Date] + FactMilestone[MilestoneKey] / 1000, , ASC ) - 1
			    VAR _y = 61 + _i * 63.5
			    VAR _p = LOOKUPVALUE ( DimProject[Project], DimProject[ProjectKey], FactMilestone[ProjectKey] )
			    RETURN "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( 0.2 + _i * 0.12, "0.00", "en-US" ) & "s' dur='0.5s' fill='freeze'/>"
			        & "<rect x='55' y='" & _y & "' width='287.5' height='52.5' rx='10' fill='" & _c_chip & "' fill-opacity='0.55' stroke='" & _c_line & "'/>"
			        & "<rect x='55.5' y='" & ( _y + 0.5 ) & "' width='55' height='51.5' rx='9.5' fill='" & _c_tile & "'/>"
			        & "<text x='83' y='" & ( _y + 24 ) & "' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='19' font-weight='600' fill='" & _c_ink & "'>" & FORMAT ( FactMilestone[Date], "dd" ) & "</text>"
			        & "<text x='83' y='" & ( _y + 40.5 ) & "' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' fill='" & _c_ink & "'>" & UPPER ( FORMAT ( FactMilestone[Date], "mmm", "en-US" ) ) & "</text>"
			        & "<text x='124' y='" & ( _y + 20.5 ) & "' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='" & _c_ink & "'>" & FactMilestone[Milestone] & "</text>"
			        & "<text x='124' y='" & ( _y + 40.5 ) & "' font-family='Segoe UI, Arial, sans-serif' font-size='14' fill='" & _c_muted & "'>" & _p & "</text>"
			        & "<circle cx='30.5' cy='" & ( _y + 22.5 ) & "' r='9.5' fill='" & _c_chip & "' stroke='" & _c_ink & "' stroke-width='1.5'/>"
			        & IF ( _i = 0, "<circle cx='30.5' cy='" & ( _y + 22.5 ) & "' r='5.3' fill='" & _c_ink & "'/>" ) & "</g>",
			    "", FactMilestone[Date], ASC, FactMilestone[MilestoneKey], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336.4' height='252' viewBox='0 0 361 260' preserveAspectRatio='none'><text x='23.5' y='37.5' font-family='Segoe UI, Arial, sans-serif' font-size='25' font-weight='600' fill='" & _c_ink & "' text-anchor='start' letter-spacing='-0.4'>Next milestones</text><circle cx='323.5' cy='31' r='20.5' fill='" & _c_pill & "'/><g transform='translate(313.5 21) scale(0.833333)' fill='none' stroke='" & _c_pilltext & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12h14' /><path d='M12 5v14' /></g><line x1='30.5' y1='70' x2='30.5' y2='222' stroke='" & _c_faint & "' stroke-width='1.2' stroke-dasharray='3 3'/>"
			        & _lignes
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
		displayFolder: 90 SVG
		lineageTag: fd37a83d-b79f-5668-8bc0-b622d76a44ea
		dataCategory: ImageUrl

	measure 'Project card (SVG)' =
			
			VAR _c_card = [Color card]
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _c_tile = [Color tile]
			VAR _c_track = [Color track]
			VAR _k = [Shown project key]
			VAR _p = [Shown progress]
			VAR _ph = [Shown phase]
			VAR _th = LOOKUPVALUE ( 'Thumb image'[Chunk], 'Thumb image'[ProjectKey], _k )
			VAR _cph = SWITCH ( _ph, "Construction", [Color construction], "Permit", [Color permit], [Color design] )
			VAR _tph = IF ( _ph = "Permit", [Color ink], [Color pilltext] )
			VAR _eq = CALCULATETABLE ( BridgeProjectPerson, REMOVEFILTERS ( DimProject ), BridgeProjectPerson[ProjectKey] = _k, BridgeProjectPerson[IsStaff] = TRUE () )
			VAR _n = COUNTROWS ( _eq )
			VAR _av = TOPN ( 3, _eq, BridgeProjectPerson[MemberOrder], ASC )
			VAR _avs = CONCATENATEX ( _av, VAR _i = RANKX ( _av, BridgeProjectPerson[MemberOrder], , ASC ) VAR _cx = 12 + _i * 21
			    VAR _b = LOOKUPVALUE ( 'Avatar image'[Chunk], 'Avatar image'[PersonKey], BridgeProjectPerson[PersonKey] )
			    RETURN "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='" & FORMAT ( 0.15 + _i * 0.09, "0.00", "en-US" ) & "s' dur='0.4s' fill='freeze'/>"
			        & "<clipPath id='f" & _i & "'><circle cx='" & _cx & "' cy='241' r='14'/></clipPath><circle cx='" & _cx & "' cy='241' r='15.8' fill='" & _c_card & "'/>"
			        & "<image x='" & ( _cx - 14 ) & "' y='227' width='28' height='28' clip-path='url(#f" & _i & ")' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64," & _b & "'/></g>",
			    "", BridgeProjectPerson[MemberOrder], ASC )
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='360' height='270' viewBox='0 0 360 270' preserveAspectRatio='none'><rect width='360' height='270' fill='" & _c_card & "'/><clipPath id='v'><rect x='14' y='14' width='136' height='102' rx='10'/></clipPath><image x='14' y='14' width='136' height='102' clip-path='url(#v)' preserveAspectRatio='xMidYMid slice' href='data:image/jpeg;base64,"
			        & _th
			        & "'/><text x='164' y='33' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown project]
			        & "</text><text x='164' y='52' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
			        & [Shown city] & " · " & [Shown type]
			        & "</text><rect x='164' y='63' width='"
			        & FORMAT ( LEN ( _ph ) * 7.2 + 22, "0.0", "en-US" )
			        & "' height='22' rx='11' fill='"
			        & _cph
			        & "'/><text x='175' y='78.5' font-family='Segoe UI, Arial, sans-serif' font-size='12' font-weight='600' fill='"
			        & _tph
			        & "'>"
			        & _ph
			        & "</text><rect x='164' y='99' width='150' height='6' rx='3' fill='" & _c_track & "'/><rect x='164' y='99' width='0' height='6' rx='3' fill='" & _c_ink & "'><animate attributeName='width' from='0' to='"
			        & FORMAT ( 150 * _p, "0.0", "en-US" )
			        & "' dur='0.8s' fill='freeze'/></rect><text x='346' y='106' font-family='Segoe UI, Arial, sans-serif' font-size='13' font-weight='600' fill='" & _c_ink & "' text-anchor='end'>"
			        & FORMAT ( _p, "0%", "en-US" )
			        & "</text><text x='14' y='142' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Budget</text><text x='14' y='162' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown budget label]
			        & "</text><text x='130' y='142' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Contract fees</text><text x='130' y='162' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown fees label]
			        & "</text><text x='246' y='142' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Hours logged</text><text x='246' y='162' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown hours label]
			        & "</text><rect x='14' y='176' width='332' height='1' fill='" & _c_line & "'/><g transform='translate(14 187) scale(0.666667)' fill='none' stroke='" & _c_muted & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z' /><line x1='4' x2='4' y1='22' y2='15' /></g><text x='38' y='200' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Next milestone</text><text x='346' y='200' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='600' fill='" & _c_ink & "' text-anchor='end'>"
			        & [Shown next milestone label]
			        & "</text><rect x='14' y='214' width='332' height='1' fill='" & _c_line & "'/>"
			        & _avs
			        & IF ( _n > 3, "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.45s' dur='0.4s' fill='freeze'/><circle cx='96' cy='241' r='15.8' fill='" & _c_card & "'/><circle cx='96' cy='241' r='14' fill='" & _c_tile & "'/><text x='96' y='245.5' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='11.5' font-weight='600' fill='" & _c_muted & "'>+" & ( _n - 3 ) & "</text></g>" )
			        & "<text x='122' y='237' font-family='Segoe UI, Arial, sans-serif' font-size='13.5' font-weight='600' fill='" & _c_ink & "' text-anchor='start'>"
			        & [Shown lead]
