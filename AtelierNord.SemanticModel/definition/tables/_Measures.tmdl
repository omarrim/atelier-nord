	measure 'KPI band planning (SVG)' =
			
			VAR _c_ink = [Color ink]
			VAR _c_line = [Color line]
			VAR _c_muted = [Color muted]
			VAR _k0 = [Active projects]
			VAR _k1 = [Milestones this month]
			VAR _k2 = [Schedule alerts]
			VAR _k3 = [Meetings this week]
			VAR _svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='1111.8' height='89.6' viewBox='0 0 1156.5 98.5' preserveAspectRatio='none'><rect x='272.5' y='21' width='1' height='62' fill='" & _c_line & "'/><rect x='565.5' y='21' width='1' height='62' fill='" & _c_line & "'/><rect x='850' y='21' width='1' height='62' fill='" & _c_line & "'/>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k0 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='31' y='52' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( ROUND ( _v, 0 ), "#,0", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.15 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.15 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.15 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.25s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.25s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='31' y='78.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Active projects</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k1 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='326' y='52' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( ROUND ( _v, 0 ), "#,0", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.25 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.25 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.25 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.35s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.35s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='326' y='78.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Milestones this month</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k2 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='622.5' y='52' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( ROUND ( _v, 0 ), "#,0", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.35 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.35 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.35 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.45s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.45s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='622.5' y='78.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Schedule alerts</text></g>"
			        & CONCATENATEX ( GENERATESERIES ( 0, 24 ),
			        VAR _e = 1 - POWER ( 1 - [Value] / 24, 3 ) VAR _v = _k3 * _e VAR _fin = [Value] = 24
			        RETURN "<text x='905' y='52' font-family='Segoe UI, Arial, sans-serif' font-size='46' font-weight='600' fill='" & _c_ink & "' style='font-variant-numeric:tabular-nums' letter-spacing='-1.2' opacity='" & IF ( _fin, "1", "0" ) & "'>" & FORMAT ( ROUND ( _v, 0 ), "#,0", "en-US" )
			            & IF ( _fin, "<set attributeName='opacity' to='0' begin='0s'/><set attributeName='opacity' to='1' begin='" & FORMAT ( 0.45000000000000007 + ( 24 - 1 ) * 0.05000, "0.000", "en-US" ) & "s'/>",
			                "<set attributeName='opacity' to='1' begin='" & IF ( [Value] = 0, "0", FORMAT ( 0.45000000000000007 + ( [Value] - 1 ) * 0.05000, "0.000", "en-US" ) ) & "s'/>"
			                & "<set attributeName='opacity' to='0' begin='" & FORMAT ( 0.45000000000000007 + [Value] * 0.05000, "0.000", "en-US" ) & "s'/>" )
			            & "</text>", "", [Value], ASC )
			        & "<g opacity='0'><animate attributeName='opacity' from='0' to='1' begin='0.55s' dur='0.55s' fill='freeze'/><animateTransform attributeName='transform' type='translate' from='0 8' to='0 0' begin='0.55s' dur='0.55s' fill='freeze' calcMode='spline' keyTimes='0;1' keySplines='0.22 1 0.36 1'/><text x='905' y='78.5' font-family='Segoe UI, Arial, sans-serif' font-size='18' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>Meetings this week</text></g></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )
