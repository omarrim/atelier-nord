			        & IF ( [Notifications count] > 0, "<circle cx='1324.5' cy='74' r='11.5' fill='" & _c_pilltext & "' stroke='" & _c_pill & "' stroke-width='1.6'/><text x='1324.5' y='78.5' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='12.5' font-weight='700' fill='" & _c_pill & "'>" & [Notifications count] & "</text>" )
			        & "<circle cx='1376.5' cy='93' r='26' fill='" & _c_chip & "' fill-opacity='" & _c_chipop & "' filter='url(#s)'/><circle cx='1368.5' cy='93' r='2.4' fill='" & _c_ink & "'/><circle cx='1376.5' cy='93' r='2.4' fill='" & _c_ink & "'/><circle cx='1384.5' cy='93' r='2.4' fill='" & _c_ink & "'/><g transform='translate(263 1043) scale(0.75)' fill='none' stroke='" & _c_muted & "' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z' /><line x1='4' x2='4' y1='22' y2='15' /></g><text x='299' y='1057' font-family='Segoe UI, Arial, sans-serif' font-size='15' font-weight='400' fill='" & _c_muted & "' text-anchor='start'>"
